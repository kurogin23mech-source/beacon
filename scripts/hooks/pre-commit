#!/usr/bin/env bash
# Beacon pre-commit hook
#
# Two checks:
#   1. Block accidental secret commits (Google API key / OAuth token / PEM etc.)
#   2. Regenerate desktop/dist/index.html when server/static/index.html or
#      desktop/layer.js changes (drift防止).
#
# Install:
#   ln -sf ../../scripts/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x scripts/hooks/pre-commit
#
# CORE doc: "Tauri/Web UI 二層アーキテクチャ: 共有境界とメンテナンス手順" (K8AhPgjpDG3mEa4eVm37)

set -e
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# ==============================================================================
# Check 1: Secret detection (legacy, originally installed manually 2026-05-15)
# ==============================================================================
BLOCKED=0
PATTERNS=(
  'GOCSPX-[A-Za-z0-9_-]+'          # Google OAuth client secret
  'AIza[A-Za-z0-9_-]{35}'          # Google API key
  'ya29\.[A-Za-z0-9_-]+'           # Google OAuth access token
  '"client_secret"\s*:\s*"[^"]+"'  # client_secret in JSON
  'PRIVATE KEY-----'               # PEM private key
)
SKIP='\.example$|\.md$|\.lock$|\.txt$|CLAUDE\.md|^scripts/hooks/'

for file in $(git diff --cached --name-only --diff-filter=ACM); do
  echo "$file" | grep -qE "$SKIP" && continue
  content=$(git show ":$file" 2>/dev/null) || continue
  for pattern in "${PATTERNS[@]}"; do
    match=$(echo "$content" | grep -nEi "$pattern" || true)
    if [ -n "$match" ]; then
      if [ "$BLOCKED" -eq 0 ]; then
        echo "🚫 Secret detected in staged files:"
        echo ""
      fi
      echo "  $file:"
      echo "$match" | head -3 | sed 's/^/    /'
      echo ""
      BLOCKED=1
    fi
  done
done

if [ "$BLOCKED" -ne 0 ]; then
  echo "Commit blocked. Remove secrets or add file to .gitignore."
  echo "To bypass (not recommended): git commit --no-verify"
  exit 1
fi

# ==============================================================================
# Check 2: Tauri dist sync (added 2026-06-01, ms-46 e-725)
# ==============================================================================
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
if echo "$STAGED" | grep -qE "^server/static/index\.html$|^desktop/layer\.js$"; then
  echo "[pre-commit] server/static/index.html or desktop/layer.js changed — regenerating desktop/dist/index.html"
  if ! python3 desktop/build.py >/dev/null 2>&1; then
    echo "[pre-commit] ERROR: desktop/build.py failed. Commit aborted."
    echo "             Run: python3 desktop/build.py"
    echo "             for the full error."
    exit 1
  fi
  git add desktop/dist/index.html
  echo "[pre-commit] desktop/dist/index.html staged (regenerated)"
  echo "[pre-commit] NOTE: Tauri release rebuild (cargo tauri build) + .app reinstall"
  echo "             are still manual. See CORE doc K8AhPgjpDG3mEa4eVm37."
fi

# ==============================================================================
# Check 3: Frontend drift detector (added 2026-06-01, ms-46 e-744)
# ==============================================================================
# Detect tab / action mismatches between server/static (Web) and
# desktop/layer.js (Tauri). Currently warn-only — once e-743 (render() SHARED)
# lands, the underlying duplication goes away and this check moves to strict
# in CI.
if [ -f scripts/check-frontend-drift.py ]; then
  python3 scripts/check-frontend-drift.py 2>&1 | sed 's/^/[pre-commit] /' || true
fi

# ==============================================================================
# Check 4: Tauri source change warning (added 2026-06-01, ms-46 e-735)
# ==============================================================================
# desktop/src-tauri/ 配下 (Rust / tauri.conf.json) が変わったら Tauri 本体の
# rebuild が必要。これは frequency 低いので自動化はせず、warning で通知のみ。
if echo "$STAGED" | grep -qE "^desktop/src-tauri/(Cargo\.toml|src/|tauri\.conf\.json|capabilities/)"; then
  echo ""
  echo "[pre-commit] WARN: desktop/src-tauri/ が変更されています (Rust / config)。"
  echo "             Tauri 本体の rebuild が必要です:"
  echo "               cd desktop && ./node_modules/.bin/tauri build"
  echo "             その後 /Applications/Beacon.app の差し替えも忘れずに。"
  echo "             ※ commit はそのまま進めます。"
  echo ""
fi

# ==============================================================================
# Check 5a: Deprecated CLI verb in skill markdown (added 2026-06-18, ms-81 e-1920)
# ==============================================================================
# Skills should call `beacon milestone start` rather than the deprecated
# `beacon milestone workspace` verb so status / assignee / occupation /
# worktree always activate atomically. Warn-only; `workspace-cleanup`
# (the unrelated lifecycle verb) is kept legitimate via the exclusion.
if echo "$STAGED" | grep -qE "^skills/.*\.md$"; then
  HITS=""
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    matched=$(grep -nE "beacon milestone workspace([^-]|$)" "$f" 2>/dev/null || true)
    if [ -n "$matched" ]; then
      HITS="$HITS\n$f:\n$matched"
    fi
  done < <(echo "$STAGED" | grep -E "^skills/.*\.md$")
  if [ -n "$HITS" ]; then
    echo "[pre-commit] [ms-81 skill-deprecated-verb] Skills reference deprecated 'beacon milestone workspace':"
    echo -e "$HITS" | sed 's/^/[pre-commit]   /'
    echo "[pre-commit]   Switch to 'beacon milestone start <ms-id>' so status / assignee / occupation / worktree activate together (e-1920)."
  fi
fi

# ==============================================================================
# Check 5: Skill drift detection (added 2026-06-02, ms-10 e-722)
# ==============================================================================
# Any change under skills/ should be mirrored into ~/.claude/skills/ via
# `beacon skill install`. Warn only — set BEACON_AUTO_SKILL_INSTALL=1 to
# run the installer automatically.
if echo "$STAGED" | grep -qE "^skills/.*\.md$"; then
  if [ -f scripts/check-skill-drift.py ]; then
    OUT=$(python3 scripts/check-skill-drift.py 2>&1 || true)
    if echo "$OUT" | grep -q "Drift detected\|not installed\|does not exist"; then
      echo "$OUT" | sed 's/^/[pre-commit] /'
      if [ "${BEACON_AUTO_SKILL_INSTALL:-0}" = "1" ]; then
        echo "[pre-commit] BEACON_AUTO_SKILL_INSTALL=1 — running 'beacon skill install'"
        if command -v beacon >/dev/null 2>&1; then
          beacon skill install || true
        else
          echo "[pre-commit] WARN: beacon not on PATH; skipping auto-install."
        fi
      else
        echo "[pre-commit] HINT: set BEACON_AUTO_SKILL_INSTALL=1 to auto-run 'beacon skill install'."
      fi
    fi
  fi
fi

# ==============================================================================
# Check 6: CLI help drift detection (added 2026-06-02, ms-10 e-722)
# ==============================================================================
# When bin/beacon, lib/commands.py, or README.md change, verify that the
# subcommand sets across the three surfaces stay aligned. Warn-only.
if echo "$STAGED" | grep -qE "^(bin/beacon|lib/commands\.py|README\.md|beacon_cli/dispatch\.py)$"; then
  if [ -f scripts/check-cli-help-drift.py ]; then
    python3 scripts/check-cli-help-drift.py 2>&1 | sed 's/^/[pre-commit] /' || true
  fi
fi

# ==============================================================================
# Check 7: server/ vs lib/ module name collision (added 2026-06-13, ms-64 e-1618)
# ==============================================================================
# app.py 上部の sys.path.insert(0, "../lib") のせいで lib/ が import path 先頭。
# server/*.py に lib/ と同名のファイルを作ると shadow されて本番障害 (= 2026-06-13)。
# strict mode (= exit 1) で commit を block する。
if echo "$STAGED" | grep -qE "^(server|lib)/[^/]+\.py$"; then
  if [ -f scripts/check-server-lib-collision.py ]; then
    python3 scripts/check-server-lib-collision.py --strict 2>&1 | sed 's/^/[pre-commit] /'
    if [ ${PIPESTATUS[0]} -ne 0 ]; then
      echo "[pre-commit] ERROR: server/ ↔ lib/ name collision を解消してから commit してください。" >&2
      exit 1
    fi
  fi
fi

# ==============================================================================
# Check 7: INSTALL.md static validation (added 2026-06-02, ms-10 e-722)
# ==============================================================================
if echo "$STAGED" | grep -q "^INSTALL\.md$"; then
  if [ -f scripts/check-install-md.py ]; then
    python3 scripts/check-install-md.py 2>&1 | sed 's/^/[pre-commit] /' || true
  fi
fi

# ==============================================================================
# Check 8: Branch / workspace divergence warning (added 2026-06-11, ms-65 e-1481)
# ==============================================================================
# Warn (do NOT block) when this session is in the main project root on a
# non-default branch while other live bridges share the cwd — the unsafe
# combination behind the 2026-06-10 same-cwd branch-share incident. The
# structural fix (e-1477 cwd-aware milestone start) reduces the chance of
# entering this state accidentally; this hook catches the residual case.
if [ -f scripts/check-branch-focus-divergence.py ]; then
  python3 scripts/check-branch-focus-divergence.py 2>&1 | sed 's/^/[pre-commit] /' || true
fi

exit 0
