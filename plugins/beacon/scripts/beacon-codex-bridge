#!/usr/bin/env python3
"""Beacon Codex bridge lifecycle CLI (= ms-93 / e-2508).

`start` / `stop` / `restart` / `status` / `install-hook` / `uninstall-hook` /
`uninstall` / `ensure-network` を 1 つの CLI に統合する。 Codex plugin の skill
``beacon-codex-bridge`` から呼ばれる product path であり、 user が手で
``nohup python3 scripts/codex-receive-loop.py &`` を打つ必要を消す。

``ensure-network`` (= ms-93 / e-3000) は ``~/.codex/config.toml`` に
``[sandbox_workspace_write] network_access = true`` を冪等に書き込み、 Codex
sandbox 内から beacon cloud (= beacon-ai.dev) へ到達できるようにする。
``install-hook`` / ``start`` からも自動で呼ばれる (= 受信 hook を入れる時点で
cloud 到達性も揃える)。

cwd-scoped lifecycle:

- pidfile: ``<cwd>/.beacon/codex/receive-loop.pid``
- log:     ``<cwd>/.beacon/codex/receive-loop.log``
- session: ``<cwd>/.beacon/codex/receive-loop.session.json``

すべて cwd 配下なので、 別 cwd で並走しても collision しない。 stale pidfile
(= pid が dead) は ``start`` 時に自動 cleanup される。

Hook install / uninstall は ``~/.codex/hooks.json`` を冪等に編集する。
既に同 command の entry があれば no-op、 無ければ append。 uninstall は
beacon の entry のみ pop し、 他 entry は触らない。
"""

from __future__ import annotations

import argparse
import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path


# Codex hooks.json — user-global location.
CODEX_HOOKS_PATH = Path(os.path.expanduser("~/.codex/hooks.json"))
HOOK_EVENT = "UserPromptSubmit"
# Stable marker so we can detect "our" hook entry across upgrades.
HOOK_SCRIPT_BASENAME = "codex-inbox-hook.py"


def _install_root() -> Path:
    """Resolve the Beacon source checkout.

    Resolution order:
    1. ``BEACON_INSTALL_ROOT`` env var (= explicit override)
    2. Script-relative: this file lives at
       ``<beacon-root>/plugins/beacon/scripts/beacon-codex-bridge``,
       so two levels up is the install root.
    """
    env = os.environ.get("BEACON_INSTALL_ROOT", "").strip()
    if env:
        return Path(env).expanduser().resolve()
    return Path(__file__).resolve().parent.parent.parent.parent


def _codex_dir(cwd: Path) -> Path:
    return cwd / ".beacon" / "codex"


def _pid_file(cwd: Path) -> Path:
    return _codex_dir(cwd) / "receive-loop.pid"


def _log_file(cwd: Path) -> Path:
    return _codex_dir(cwd) / "receive-loop.log"


def _session_file(cwd: Path) -> Path:
    return _codex_dir(cwd) / "receive-loop.session.json"


def _read_pid(cwd: Path) -> int:
    """Return the live pid recorded in the pidfile, or 0 if none/stale."""
    p = _pid_file(cwd)
    if not p.is_file():
        return 0
    try:
        pid = int(p.read_text().strip())
    except (OSError, ValueError):
        return 0
    if pid <= 0:
        return 0
    try:
        os.kill(pid, 0)
        return pid
    except ProcessLookupError:
        return 0
    except PermissionError:
        return pid
    except Exception:
        return 0


def _clean_stale_pidfile(cwd: Path) -> bool:
    """If the pidfile points to a dead pid, remove it. Returns True if cleaned."""
    p = _pid_file(cwd)
    if not p.is_file():
        return False
    if _read_pid(cwd) != 0:
        return False
    try:
        p.unlink()
        return True
    except OSError:
        return False


def _hook_command(install_root: Path) -> str:
    """Absolute command string Codex stores in ``hooks.json``."""
    script = install_root / "scripts" / HOOK_SCRIPT_BASENAME
    return f"/usr/bin/python3 {script}"


def _hook_entry(install_root: Path, cwd: Path) -> dict:
    """The Codex hook entry shape we write into ``hooks.json``."""
    return {
        "hooks": [
            {
                "type": "command",
                "command": f"{_hook_command(install_root)} --cwd {cwd}",
                "timeout": 10,
            }
        ]
    }


def _is_our_hook(entry: dict) -> bool:
    """Detect a beacon-owned hook entry across upgrades.

    Match on the basename of the script file so absolute-path changes
    (= different ``BEACON_INSTALL_ROOT`` between sessions) still resolve
    to "ours" for uninstall / idempotency purposes.
    """
    for h in (entry or {}).get("hooks", []) or []:
        cmd = str(h.get("command", ""))
        if HOOK_SCRIPT_BASENAME in cmd:
            return True
    return False


def _load_hooks_json() -> dict:
    if not CODEX_HOOKS_PATH.is_file():
        return {"hooks": {}}
    try:
        with CODEX_HOOKS_PATH.open("r", encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, json.JSONDecodeError) as exc:
        raise RuntimeError(
            f"~/.codex/hooks.json is malformed: {exc}. "
            "Fix it manually and rerun."
        ) from exc
    if not isinstance(data, dict):
        raise RuntimeError("~/.codex/hooks.json is not a JSON object.")
    data.setdefault("hooks", {})
    if not isinstance(data["hooks"], dict):
        raise RuntimeError("~/.codex/hooks.json `hooks` is not an object.")
    return data


def _save_hooks_json(data: dict) -> None:
    CODEX_HOOKS_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp = CODEX_HOOKS_PATH.with_suffix(".json.tmp")
    with tmp.open("w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)
        f.write("\n")
    tmp.replace(CODEX_HOOKS_PATH)


# ------------------------------------------------------------------ #
# Codex sandbox network access (ms-93 / e-3000)
#
# Codex runs model-generated shell commands inside a ``workspace-write``
# sandbox whose ``network_access`` defaults to false. That silently
# breaks every beacon cloud call the Codex agent makes: DNS resolution of
# ``beacon-ai.dev`` fails with ``socket.gaierror [Errno 8]`` and all cloud
# API access dies (observed in the 2026-07-07 Codex dogfood). We
# idempotently ensure ``[sandbox_workspace_write] network_access = true``
# in the user-global Codex config so the sandboxed ``beacon`` CLI can
# reach cloud. This is a dependency-free TOML edit (Python 3.9 has no
# ``tomllib`` / ``tomli_w``) that preserves all existing config content.
# ------------------------------------------------------------------ #

CODEX_CONFIG_PATH = Path(os.path.expanduser("~/.codex/config.toml"))
_SANDBOX_TABLE = "sandbox_workspace_write"
_NET_KEY = "network_access"


def _table_of_line(line: str):
    """Return the bare table name for a ``[table]`` header line.

    Array-of-tables (``[[x]]``) returns a non-target sentinel so callers
    treat it as a scope change away from our target table. Non-header
    lines return ``None``.
    """
    s = line.strip()
    if s.startswith("[[") and s.endswith("]]"):
        return "\x00array-of-tables"
    if s.startswith("[") and s.endswith("]"):
        return s[1:-1].strip()
    return None


def _bool_kv(line: str):
    """For a ``key = value`` line, return ``(key, is_true)`` or ``None``.

    Values here are booleans, so a bare ``#`` reliably marks a comment.
    """
    body = line.split("#", 1)[0]
    if "=" not in body:
        return None
    key, _, val = body.partition("=")
    return key.strip(), val.strip().lower() == "true"


def _ensure_codex_network_access(config_path: Path = None):
    """Idempotently ensure the Codex sandbox allows network access.

    Returns ``(verdict, detail)`` where verdict is one of
    ``already`` / ``inserted`` / ``updated`` / ``created`` / ``error``.
    Best-effort: never raises. On unreadable/unwritable config it returns
    ``("error", msg)`` so the caller can warn without failing the install.
    """
    path = config_path or CODEX_CONFIG_PATH
    try:
        text = path.read_text(encoding="utf-8") if path.is_file() else ""
    except OSError as exc:
        return "error", f"cannot read {path}: {exc}"

    lines = text.splitlines()

    cur_table = None            # None = root scope
    table_header_idx = -1       # index of the [sandbox_workspace_write] header
    table_net_idx = -1          # network_access line inside that table
    dotted_idx = -1             # root-scope `sandbox_workspace_write.network_access`
    satisfied = False
    dotted_key = f"{_SANDBOX_TABLE}.{_NET_KEY}"

    for i, line in enumerate(lines):
        hdr = _table_of_line(line)
        if hdr is not None:
            cur_table = hdr
            if hdr == _SANDBOX_TABLE and table_header_idx < 0:
                table_header_idx = i
            continue
        kv = _bool_kv(line)
        if kv is None:
            continue
        key, is_true = kv
        if cur_table == _SANDBOX_TABLE and key == _NET_KEY and table_net_idx < 0:
            table_net_idx = i
            satisfied = satisfied or is_true
        elif cur_table is None and key == dotted_key and dotted_idx < 0:
            dotted_idx = i
            satisfied = satisfied or is_true

    if satisfied:
        return "already", str(path)

    if table_net_idx >= 0:
        # Flip the existing (false/other) line to true, preserving indent.
        raw = lines[table_net_idx]
        indent = raw[: len(raw) - len(raw.lstrip())]
        lines[table_net_idx] = f"{indent}{_NET_KEY} = true"
        verdict = "updated"
    elif table_header_idx >= 0:
        # Table exists but no network_access line — insert after the header.
        lines.insert(table_header_idx + 1, f"{_NET_KEY} = true")
        verdict = "inserted"
    elif dotted_idx >= 0:
        # Root dotted key present but false — flip to true.
        lines[dotted_idx] = f"{dotted_key} = true"
        verdict = "updated"
    else:
        # Absent entirely — append a fresh table block.
        if lines and lines[-1].strip() != "":
            lines.append("")
        lines.append(f"[{_SANDBOX_TABLE}]")
        lines.append(f"{_NET_KEY} = true")
        verdict = "created"

    new_text = "\n".join(lines) + "\n"
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(".toml.tmp")
        tmp.write_text(new_text, encoding="utf-8")
        tmp.replace(path)
    except OSError as exc:
        return "error", f"cannot write {path}: {exc}"
    return verdict, str(path)


def cmd_ensure_network() -> int:
    """Standalone entry point for the network_access ensure (idempotent)."""
    verdict, detail = _ensure_codex_network_access()
    if verdict == "already":
        print(f"codex-config: sandbox network_access already enabled ({detail})")
        return 0
    if verdict in ("inserted", "updated", "created"):
        print(
            f"codex-config: enabled sandbox network_access [{verdict}] "
            f"(= beacon cloud reachable from inside Codex) {detail}"
        )
        return 0
    print(f"codex-config: error: {detail}", file=sys.stderr)
    return 1


def cmd_install_hook(install_root: Path, cwd: Path) -> int:
    """Idempotently merge our UserPromptSubmit entry into hooks.json.

    Also ensures the Codex sandbox can reach beacon cloud (ms-93 / e-3000)
    so cloud calls from inside Codex don't die on DNS resolution.
    """
    verdict, detail = _ensure_codex_network_access()
    if verdict in ("inserted", "updated", "created"):
        print(
            f"codex-config: enabled sandbox network_access "
            f"(= beacon cloud reachable from inside Codex) [{verdict}] {detail}"
        )
    elif verdict == "error":
        print(
            "codex-config: warning: could not ensure sandbox network_access "
            f"({detail}). Beacon cloud calls from inside Codex may fail with "
            "DNS errors. Fix by adding to ~/.codex/config.toml:\n"
            "  [sandbox_workspace_write]\n  network_access = true",
            file=sys.stderr,
        )
    try:
        data = _load_hooks_json()
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    bucket = data["hooks"].setdefault(HOOK_EVENT, [])
    if not isinstance(bucket, list):
        print(
            f"~/.codex/hooks.json `hooks.{HOOK_EVENT}` is not an array.",
            file=sys.stderr,
        )
        return 1
    # If we already have a beacon-owned entry for this cwd, update its
    # command to the current absolute path (= absorbs install_root drift).
    desired = _hook_entry(install_root, cwd)
    desired_cmd = desired["hooks"][0]["command"]
    for i, entry in enumerate(bucket):
        if not _is_our_hook(entry):
            continue
        # Only update if this entry is bound to the same cwd; otherwise
        # leave it (= another cwd has its own entry, multi-project ok).
        existing_cmd = (entry.get("hooks") or [{}])[0].get("command", "")
        if str(cwd) in existing_cmd:
            if existing_cmd == desired_cmd:
                print(
                    f"hook: already installed for cwd={cwd} (no-op)",
                )
                return 0
            bucket[i] = desired
            _save_hooks_json(data)
            print(f"hook: updated command for cwd={cwd}")
            return 0
    bucket.append(desired)
    _save_hooks_json(data)
    print(f"hook: installed for cwd={cwd}")
    return 0


def cmd_uninstall_hook(cwd: Path) -> int:
    """Remove our hook entry for this cwd. Leaves other entries alone."""
    if not CODEX_HOOKS_PATH.is_file():
        print("hook: ~/.codex/hooks.json not found (already absent)")
        return 0
    try:
        data = _load_hooks_json()
    except RuntimeError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    bucket = data.get("hooks", {}).get(HOOK_EVENT)
    if not isinstance(bucket, list):
        print("hook: not installed (nothing to remove)")
        return 0
    keep = []
    removed = 0
    for entry in bucket:
        if not _is_our_hook(entry):
            keep.append(entry)
            continue
        cmd = (entry.get("hooks") or [{}])[0].get("command", "")
        if str(cwd) in cmd:
            removed += 1
            continue
        keep.append(entry)
    if removed == 0:
        print(f"hook: not installed for cwd={cwd}")
        return 0
    data["hooks"][HOOK_EVENT] = keep
    _save_hooks_json(data)
    print(f"hook: removed {removed} entry for cwd={cwd}")
    return 0


def cmd_start(
    install_root: Path,
    cwd: Path,
    *,
    app_server: bool = False,
    armed: bool = False,
    codex_thread_id: str = "",
    app_server_proxy: bool = False,
    app_server_sock: str = "",
    app_server_url: str = "",
) -> int:
    pid = _read_pid(cwd)
    if pid:
        print(f"daemon: already running (pid={pid})")
        # Still ensure the hook is installed (= idempotent contract).
        cmd_install_hook(install_root, cwd)
        return 0
    _clean_stale_pidfile(cwd)
    install_rc = cmd_install_hook(install_root, cwd)
    if install_rc != 0:
        return install_rc

    cloud = cwd / ".beacon" / "cloud.json"
    if not cloud.is_file():
        print(
            f"daemon: {cloud} not found. "
            "Run `beacon cloud setup` in this cwd first.",
            file=sys.stderr,
        )
        return 1

    log_path = _log_file(cwd)
    log_path.parent.mkdir(parents=True, exist_ok=True)
    log_f = log_path.open("a", encoding="utf-8")
    log_f.write(f"\n--- bridge start {time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} ---\n")
    log_f.flush()

    daemon_script = install_root / "scripts" / "codex-receive-loop.py"
    if not daemon_script.is_file():
        print(
            f"daemon: {daemon_script} not found. "
            "Check BEACON_INSTALL_ROOT.",
            file=sys.stderr,
        )
        log_f.close()
        return 1

    daemon_argv = ["/usr/bin/env", "python3", str(daemon_script), "--cwd", str(cwd)]
    if app_server:
        daemon_argv.append("--app-server")
    if armed:
        daemon_argv.append("--armed")
    if codex_thread_id:
        daemon_argv.extend(["--codex-thread-id", codex_thread_id])
    if app_server_proxy:
        daemon_argv.append("--app-server-proxy")
    if app_server_sock:
        daemon_argv.extend(["--app-server-sock", app_server_sock])
    if app_server_url:
        daemon_argv.extend(["--app-server-url", app_server_url])

    daemon_env = {**os.environ, "BEACON_INSTALL_ROOT": str(install_root)}
    if app_server:
        # Env-var duplicate of the flag so a stale daemon argv (= old
        # supervisor) can't silently flip the opt-in off on restart.
        daemon_env["BEACON_CODEX_APP_SERVER"] = "1"
    if armed:
        # Same env-var safety for the autonomous reply opt-in.
        daemon_env["BEACON_CODEX_ARMED"] = "1"
    if codex_thread_id:
        daemon_env["BEACON_CODEX_THREAD_ID"] = codex_thread_id
    if app_server_proxy:
        daemon_env["BEACON_CODEX_APP_SERVER_PROXY"] = "1"
    if app_server_sock:
        daemon_env["BEACON_CODEX_APP_SERVER_SOCK"] = app_server_sock
    if app_server_url:
        daemon_env["BEACON_CODEX_APP_SERVER_URL"] = app_server_url

    # Detach so the daemon survives the bridge's exit.
    proc = subprocess.Popen(
        daemon_argv,
        stdin=subprocess.DEVNULL,
        stdout=log_f,
        stderr=subprocess.STDOUT,
        start_new_session=True,
        env=daemon_env,
    )
    # Give the daemon a beat to write its pidfile + session pointer.
    for _ in range(20):
        time.sleep(0.1)
        new_pid = _read_pid(cwd)
        if new_pid:
            print(f"daemon: started (pid={new_pid}, log={log_path})")
            return 0
        if proc.poll() is not None:
            print(
                f"daemon: failed to start (exit={proc.returncode}). "
                f"Inspect {log_path} for details.",
                file=sys.stderr,
            )
            return 1
    print(
        f"daemon: started but pidfile not yet visible (subprocess pid={proc.pid}). "
        f"Check {log_path} if status remains empty.",
    )
    return 0


def cmd_stop(cwd: Path) -> int:
    pid = _read_pid(cwd)
    if not pid:
        _clean_stale_pidfile(cwd)
        print("daemon: not running")
        return 0
    try:
        os.kill(pid, signal.SIGTERM)
    except ProcessLookupError:
        _clean_stale_pidfile(cwd)
        print(f"daemon: pid={pid} not found (cleaned stale pidfile)")
        return 0
    except PermissionError:
        print(f"daemon: cannot signal pid={pid} (permission denied)", file=sys.stderr)
        return 1
    # Wait for the daemon's graceful close (heartbeat shutdown + pidfile unlink).
    # 10s window: the shutdown path sends a final heartbeat to the server with
    # shutdown=True (= network call) before unlinking the pidfile. 3s was
    # sometimes too tight on slower networks, which made `restart` bail
    # before `start` (ms-93 / e-2508 Codex re-dogfood FINDING #4, 2026-06-26).
    for _ in range(100):
        time.sleep(0.1)
        if _read_pid(cwd) == 0:
            print(f"daemon: stopped (pid={pid})")
            return 0
    # Daemon didn't exit gracefully in 10s. A stuck shutdown path (e.g. the
    # final shutdown=True heartbeat hanging on a slow / unreachable network,
    # or app_server_client.stop() blocking) must not leave the old daemon and
    # its pidfile alive: the subsequent `start` would see a live pid, no-op as
    # "already running", and never apply the new config. That is exactly how a
    # `bcodex` restart silently kept a stale pull-only daemon and dropped the
    # app-server (wake) upgrade (ms-93 / e-3110). Escalate to SIGKILL so the
    # stop is guaranteed. We forfeit the graceful shutdown=True server stamp,
    # but the server's poll-health marks the sid stale within ~30s regardless.
    print(
        f"daemon: SIGTERM sent to pid={pid} did not exit in 10s; escalating to SIGKILL.",
        file=sys.stderr,
    )
    try:
        os.kill(pid, signal.SIGKILL)
    except ProcessLookupError:
        # Exited between the last poll and the SIGKILL — treat as a clean stop.
        _clean_stale_pidfile(cwd)
        print(f"daemon: stopped (pid={pid})")
        return 0
    except PermissionError:
        print(
            f"daemon: cannot SIGKILL pid={pid} (permission denied)",
            file=sys.stderr,
        )
        return 1
    # Wait for the kernel to reap the killed process, then clean the pidfile
    # the dead daemon never got to unlink itself.
    for _ in range(20):
        time.sleep(0.1)
        if _read_pid(cwd) == 0:
            break
    _clean_stale_pidfile(cwd)
    print(f"daemon: SIGKILL escalated (pid={pid}) after 10s graceful window; stopped.")
    return 0


def cmd_restart(
    install_root: Path,
    cwd: Path,
    *,
    app_server: bool = False,
    armed: bool = False,
    codex_thread_id: str = "",
    app_server_proxy: bool = False,
    app_server_sock: str = "",
    app_server_url: str = "",
) -> int:
    """Stop the daemon, clean any leftover state, then start fresh.

    Does NOT gate `start` on `cmd_stop`'s exit code. Even when stop's polling
    window times out (= pidfile cleanup didn't catch up), the daemon may
    have actually died — in that case `_clean_stale_pidfile` below removes
    the stale entry and `cmd_start` can proceed. This was found via
    ms-93 / e-2508 Codex re-dogfood FINDING #4 (2026-06-26): the previous
    `if rc != 0: return rc` gate made `restart` silently bail when the
    daemon had stopped but the pidfile lingered.

    If the daemon is genuinely still alive after `cmd_stop` returns,
    `cmd_start` will detect the live pidfile and no-op (= matching the
    semantics of `start` on a running daemon).
    """
    cmd_stop(cwd)
    _clean_stale_pidfile(cwd)
    return cmd_start(
        install_root, cwd,
        app_server=app_server,
        armed=armed,
        codex_thread_id=codex_thread_id,
        app_server_proxy=app_server_proxy,
        app_server_sock=app_server_sock,
        app_server_url=app_server_url,
    )


def cmd_status(install_root: Path, cwd: Path) -> int:
    # Hook status.
    hook_marker = "absent"
    try:
        data = _load_hooks_json()
        for entry in data.get("hooks", {}).get(HOOK_EVENT, []) or []:
            if _is_our_hook(entry) and str(cwd) in (
                (entry.get("hooks") or [{}])[0].get("command", "")
            ):
                hook_marker = "installed ✓"
                break
    except RuntimeError as exc:
        hook_marker = f"error ({exc})"
    print(f"hook:    {hook_marker}")

    # Daemon status.
    pid = _read_pid(cwd)
    if pid:
        print(f"daemon:  running ✓ (pid={pid})")
    else:
        print("daemon:  not running")

    # Session pointer.
    sf = _session_file(cwd)
    if sf.is_file():
        try:
            with sf.open("r", encoding="utf-8") as f:
                ptr = json.load(f)
            sid = ptr.get("session_id", "?")
            pid_in_ptr = ptr.get("project_id", "?")
            written = ptr.get("written_at", "?")
            codex_thread = ptr.get("codex_thread_id") or "-"
            proxy = ptr.get("app_server_proxy")
            url = ptr.get("app_server_url") or "-"
            print(
                f"session: {sid} project={pid_in_ptr} written_at={written} "
                f"codex_thread={codex_thread} app_server_proxy={proxy} "
                f"app_server_url={url}"
            )
        except Exception as exc:
            print(f"session: <unreadable: {exc}>")
    else:
        print("session: (no pointer file)")

    # Inbox counts.
    inbox = cwd / ".beacon" / "codex" / "inbox"
    if inbox.is_dir():
        unread = len(list(inbox.glob("*.json")))
        read_dir = inbox / ".read"
        archived = len(list(read_dir.glob("*.json"))) if read_dir.is_dir() else 0
        print(f"inbox:   {unread} unread / {archived} archived")
    else:
        print("inbox:   (no inbox directory yet)")
    return 0


def cmd_uninstall(install_root: Path, cwd: Path) -> int:
    """Full local teardown: stop daemon + remove hook entry for this cwd."""
    rc_stop = cmd_stop(cwd)
    rc_hook = cmd_uninstall_hook(cwd)
    return rc_stop or rc_hook


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Beacon Codex bridge lifecycle CLI (ms-93 / e-2508).",
    )
    parser.add_argument(
        "subaction",
        nargs="?",
        default="status",
        choices=[
            "start",
            "stop",
            "restart",
            "status",
            "install-hook",
            "uninstall-hook",
            "uninstall",
            "ensure-network",
        ],
    )
    parser.add_argument("--cwd", default="", help="Project cwd (default: $PWD).")
    parser.add_argument(
        "--install-root",
        default="",
        help="Beacon checkout (default: BEACON_INSTALL_ROOT or script-relative).",
    )
    parser.add_argument(
        "--app-server",
        action="store_true",
        help=(
            "Opt-in (ms-93 / e-2519): start the daemon with autonomous push "
            "receive via a long-lived `codex app-server --stdio` child. "
            "Default off keeps the pull-on-prompt path identical to before. "
            "Only honoured by `start` / `restart`."
        ),
    )
    parser.add_argument(
        "--armed",
        action="store_true",
        help=(
            "Opt-in (ms-93 / e-2519 AC 2/6): in addition to --app-server, "
            "send the Codex agent reply back to the original DM sender. "
            "User must `beacon bus budget grant N` first — armed mode does "
            "NOT auto-grant from inside the daemon. Has no effect without "
            "--app-server."
        ),
    )
    parser.add_argument(
        "--codex-thread-id",
        default="",
        help=(
            "Remote Codex UX opt-in: with --app-server, deliver DMs as turns "
            "on this existing app-server thread instead of a response-worker "
            "thread. Use with --app-server-proxy."
        ),
    )
    parser.add_argument(
        "--app-server-proxy",
        action="store_true",
        help=(
            "Use `codex app-server proxy` so the bridge connects to the "
            "running app-server daemon shared by a remote Codex TUI."
        ),
    )
    parser.add_argument(
        "--app-server-sock",
        default="",
        help="Optional app-server daemon Unix socket for --app-server-proxy.",
    )
    parser.add_argument(
        "--app-server-url",
        default="",
        help=(
            "Already-running Codex app-server endpoint, e.g. "
            "ws://127.0.0.1:39988. Use this with a remote Codex TUI launched "
            "against the same endpoint."
        ),
    )
    args = parser.parse_args()

    install_root = (
        Path(args.install_root).expanduser().resolve()
        if args.install_root
        else _install_root()
    )
    cwd = Path(args.cwd or os.getcwd()).resolve()

    if not (install_root / "scripts" / "codex-receive-loop.py").is_file():
        print(
            f"bridge: cannot find scripts/codex-receive-loop.py under {install_root}. "
            "Set BEACON_INSTALL_ROOT to your beacon checkout.",
            file=sys.stderr,
        )
        return 1

    if args.subaction == "start":
        return cmd_start(
            install_root, cwd,
            app_server=args.app_server,
            armed=args.armed,
            codex_thread_id=args.codex_thread_id,
            app_server_proxy=args.app_server_proxy,
            app_server_sock=args.app_server_sock,
            app_server_url=args.app_server_url,
        )
    if args.subaction == "stop":
        return cmd_stop(cwd)
    if args.subaction == "restart":
        return cmd_restart(
            install_root, cwd,
            app_server=args.app_server,
            armed=args.armed,
            codex_thread_id=args.codex_thread_id,
            app_server_proxy=args.app_server_proxy,
            app_server_sock=args.app_server_sock,
            app_server_url=args.app_server_url,
        )
    if args.subaction == "status":
        return cmd_status(install_root, cwd)
    if args.subaction == "install-hook":
        return cmd_install_hook(install_root, cwd)
    if args.subaction == "uninstall-hook":
        return cmd_uninstall_hook(cwd)
    if args.subaction == "uninstall":
        return cmd_uninstall(install_root, cwd)
    if args.subaction == "ensure-network":
        return cmd_ensure_network()
    parser.error(f"unknown subaction: {args.subaction}")
    return 2


if __name__ == "__main__":
    sys.exit(main())
