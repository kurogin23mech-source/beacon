# ms-96 e-2382 — VPS の MySQL → S3 退避設定テンプレート。
#
# 本番の実体は VPS の /etc/beacon/backup.env に置く (repo には焼き込まない)。
# beacon-backup.service が `EnvironmentFile=/etc/beacon/backup.env` で読み込む。
# セットアップ手順の全文は docs/BACKUP_VPS.md を参照。
#
# 配置:
#   sudo install -m 0600 /opt/beacon/deploy/backup.env.example /etc/beacon/backup.env
#   # 下記の <...> を実値に置き換える (退避専用 IAM ユーザーの鍵と退避先バケット)
#   sudo chmod 600 /etc/beacon/backup.env   # 鍵を含むので root のみ読める権限に

# 退避先 S3 バケット (必須)。docs/BACKUP_VPS.md の手順で作成する。
BEACON_BACKUP_S3_BUCKET=beacon-prod-backups
# バケット内プレフィックス (既定 mysql)。キーは <prefix>/<env>/beacon-<env>-<UTC>.sql.gz。
BEACON_BACKUP_S3_PREFIX=mysql

# 退避専用 IAM ユーザーの認証情報。最小権限 (PutObject/GetObject/ListBucket のみ、
# 削除権限は与えない = 保持は S3 ライフサイクルに一元化) を付与したもの。
# 生成手順と IAM ポリシー JSON は docs/BACKUP_VPS.md を参照。
AWS_ACCESS_KEY_ID=<退避ユーザーの access key id>
AWS_SECRET_ACCESS_KEY=<退避ユーザーの secret access key>
AWS_DEFAULT_REGION=ap-northeast-1

# 注: BEACON_ENV (prod) は beacon-api.service と同じ /etc/beacon/app.env が持つので
# ここには書かない。DB 認証 (MYSQL_*) は /etc/beacon/db.env を EnvironmentFile で
# 併読するので、backup.env には S3 退避先と AWS 認証だけを置く。
