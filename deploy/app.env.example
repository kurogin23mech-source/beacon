# Beacon API — app-level environment template
#
# 本番 VPS では /etc/beacon/app.env に配置し、beacon-api.service が
# `EnvironmentFile=/etc/beacon/app.env` で読み込む (docs/DEPLOY_VPS.md 参照)。
# この .example を repo で固定しておくことで、サービス移設 (Cloud Run -> VPS 等)
# で必須 env が「無音で欠落」して気付けなくなる事故を防ぐ (= ms-96 e-3196)。
#
# secret はここに書かない (= db.env / envelope secret 等は別管理)。ここに載せる
# のは「公開しても安全だが、環境ごとに正値が要る」設定値だけ。

# ---------------------------------------------------------------------------
# BEACON_OAUTH_CLIENT_ID (required in production, provider=firebase)
# ---------------------------------------------------------------------------
# Web UI のログインで使う Google OAuth の client_id (Google Identity Services)。
# ページ HTML に埋め込まれて配信される PUBLIC 値なので version 管理に置いてよい
# (secret ではない)。
#
# 本番で空だと Web UI のログインボタンが「黙って消える」= silent 障害になる。
# それを防ぐため、provider=firebase かつ BEACON_ENV=prod でこの値が空のときは
# /health が 503 を返し、pull-deploy の health check (curl -fsS) が deploy を
# 赤くする (= e-3197)。この loud 検出があるので、実値を **この .example に焼き込む
# 必要はない**: placeholder のまま deploy すれば 503 で気付ける (= 無音欠落は
# e-3197 が防ぐ。e-3196 の「実値を repo に置いて移設で失わない」belt-and-suspenders
# は e-3197 に吸収されたので撤去した = ms-105 e-3313)。
#
# この .example は「必須 env の一覧」を固定するためのテンプレートであって、特定
# デプロイの固有値 (= beacon-ai.dev の OAuth アプリ client_id) を repo に焼き込む
# 場所ではない。実値は runbook (docs/DEPLOY_VPS.md) と本番の /etc/beacon/app.env
# だけが持つ。下は placeholder — セットアップ時に runbook の値に差し替えること。
BEACON_OAUTH_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com

# ---------------------------------------------------------------------------
# BEACON_SCHEDULER_INTERNAL_KEY (required in production — SECRET, e-1391 / e-4115)
# ---------------------------------------------------------------------------
# 定期ティック (Trek/Operation の自律発火を駆動する server-side scheduler) の
# 内部認証キー。beacon-tick.timer → scripts/vps-tick.sh がこの値を
# `X-Beacon-Scheduler-Key` ヘッダに載せて POST /api/system/trek-scheduler/tick を
# 叩き、app 側 (server/envelope.py: scheduler_internal_key) が同値で照合する。
# app と scheduler の双方が /etc/beacon/app.env の同じ値を読む必要があるため、
# 本番固有の secret だが例外的にこの app.env で管理する (db.env 相当の扱い)。
#
# ⚠ これは SECRET。この .example には実値を書かない。本番では
# /etc/beacon/app.env にランダムな 32+ byte 値を入れること (例:
# `openssl rand -hex 32`)。未設定 / 下の placeholder のままだと、public repo に
# 見えている dev fallback キー (server/envelope.py:_DEV_FALLBACK_SCHEDULER_KEY)
# で誰でも tick/mint endpoint を叩けてしまう。これを防ぐため、prod では起動時に
# refuse-to-boot ガードが入る (e-4115)。ガードは「未設定 / 空 / dev fallback 一致 /
# <...> の未置換テンプレート placeholder」を不正とみなすので、下の placeholder を
# そのまま deploy すれば起動失敗で loud に気付ける (= 無音欠落は起きない)。
# ※ この <...> placeholder が拒否されること自体は e-4115 follow-up (AX review H2)
# で担保: 実値に置換せずコピーすると起動が落ちる。
BEACON_SCHEDULER_INTERNAL_KEY=<generate-with-openssl-rand-hex-32-do-not-commit>
