#!/usr/bin/env bash
# bcodex — Codex launcher with Beacon DM wake wiring.
#
# Starts a local Codex app-server in the background, launches Codex TUI with
# --remote, then watches Codex's state DB for the TUI thread id and points the
# Beacon Codex bridge at that thread. This mirrors bclaude's "one launcher makes
# the session DM-ready" UX for Codex.

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: bcodex [--armed [--armed-turns N]] [--keep-app-server] [--port PORT] [--] [codex args...]

Options:
  --armed            After wake, send the generated Codex response back as a DM
                     (autonomous reply). Auto-grants the Beacon bus reply budget
                     so no separate `beacon bus budget grant` is needed. Without
                     --armed the session is DM-ready (receives) but does not
                     auto-reply, mirroring bclaude.
  --armed-turns N    How many autonomous replies --armed authorizes before the
                     budget gate stops (default: 20). No effect without --armed.
  --keep-app-server  Do not stop the background app-server when Codex exits.
  --port PORT        Bind app-server to this localhost port.
  -h, --help         Show this help.

All remaining args are forwarded to codex.
EOF
}

ARMED=0
ARMED_TURNS=20
KEEP_APP_SERVER=0
PORT=""
CODEX_ARGS=()

while [ "$#" -gt 0 ]; do
    case "$1" in
        --armed)
            ARMED=1
            shift
            ;;
        --armed-turns)
            if [ "$#" -lt 2 ]; then
                echo "bcodex: --armed-turns requires a value" >&2
                exit 2
            fi
            case "$2" in
                ''|*[!0-9]*)
                    echo "bcodex: --armed-turns must be a positive integer (got: '$2')" >&2
                    exit 2
                    ;;
            esac
            ARMED_TURNS="$2"
            shift 2
            ;;
        --keep-app-server)
            KEEP_APP_SERVER=1
            shift
            ;;
        --port)
            if [ "$#" -lt 2 ]; then
                echo "bcodex: --port requires a value" >&2
                exit 2
            fi
            PORT="$2"
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            CODEX_ARGS+=("$@")
            break
            ;;
        *)
            CODEX_ARGS+=("$1")
            shift
            ;;
    esac
done

CODEX_BIN="$(command -v codex 2>/dev/null || true)"
if [ -z "$CODEX_BIN" ]; then
    echo "bcodex: 'codex' is not on PATH. Install Codex first." >&2
    echo "  curl -fsSL https://chatgpt.com/codex/install.sh | sh" >&2
    exit 127
fi

if [ -n "${BEACON_NO_BUS:-}" ] && \
   [ "$BEACON_NO_BUS" != "0" ] && \
   [ "$BEACON_NO_BUS" != "false" ] && \
   [ "$BEACON_NO_BUS" != "no" ] && \
   [ "$BEACON_NO_BUS" != "off" ]; then
    echo "[bcodex] DM opt-out detected (env BEACON_NO_BUS), launching plain codex" >&2
    if [ "${#CODEX_ARGS[@]}" -gt 0 ]; then
        exec "$CODEX_BIN" "${CODEX_ARGS[@]}"
    else
        exec "$CODEX_BIN"
    fi
fi

find_root() {
    if command -v beacon-find-root >/dev/null 2>&1; then
        beacon-find-root 2>/dev/null && return 0
    fi
    local d="$PWD"
    while [ "$d" != "/" ]; do
        if [ -d "$d/.beacon" ] || [ -f "$d/AGENTS.md" ]; then
            printf '%s\n' "$d"
            return 0
        fi
        d="$(dirname "$d")"
    done
    printf '%s\n' "$PWD"
}

ROOT="$(find_root)"
INSTALL_ROOT="${BEACON_INSTALL_ROOT:-$ROOT}"
BRIDGE="$INSTALL_ROOT/plugins/beacon/scripts/beacon-codex-bridge"
BEACON_BIN_SELECTED="${BEACON_BIN:-$INSTALL_ROOT/bin/beacon}"

if [ ! -x "$BRIDGE" ]; then
    echo "bcodex: cannot find beacon-codex-bridge at $BRIDGE" >&2
    echo "  Set BEACON_INSTALL_ROOT to your beacon checkout." >&2
    if [ "${#CODEX_ARGS[@]}" -gt 0 ]; then
        exec "$CODEX_BIN" "${CODEX_ARGS[@]}"
    else
        exec "$CODEX_BIN"
    fi
fi

if [ "$ARMED" = "1" ]; then
    # 穴① (ms-93 e-2992): make `--armed` self-sufficient. The bridge daemon
    # deliberately does NOT auto-grant budget from inside (see the
    # beacon-codex-bridge `--armed` help) — a headless daemon must not
    # self-authorize its own outbound sends. The launcher is the
    # human-initiated entry point, so it grants the reply budget here.
    # Without this, `bcodex --armed` replies were silently refused until the
    # user ran `beacon bus budget grant` by hand (the manual step this
    # closes). Grant from $ROOT so the budget file lands in the same
    # .beacon the bridge (started with --cwd "$ROOT") reads from.
    if (cd "$ROOT" && "$BEACON_BIN_SELECTED" bus budget grant --turns "$ARMED_TURNS" >/dev/null 2>&1); then
        echo "[bcodex] armed: granted $ARMED_TURNS autonomous-reply budget" >&2
    else
        echo "[bcodex] warning: 'bus budget grant' failed — armed replies may be refused." >&2
        echo "  Run manually: beacon bus budget grant --turns $ARMED_TURNS" >&2
    fi
fi

if [ -z "$PORT" ]; then
    PORT="$(python3 - <<'PY'
import socket
s = socket.socket()
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])
s.close()
PY
)"
fi

URL="ws://127.0.0.1:$PORT"
STATE_DIR="$ROOT/.beacon/codex"
mkdir -p "$STATE_DIR"
APP_LOG="$STATE_DIR/app-server.log"
APP_PID_FILE="$STATE_DIR/app-server.pid"
WRAPPER_FILE="$STATE_DIR/bcodex.json"

printf '\n--- bcodex app-server start %s url=%s ---\n' \
    "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$URL" >>"$APP_LOG"
"$CODEX_BIN" app-server --listen "$URL" >>"$APP_LOG" 2>&1 &
APP_PID="$!"
printf '%s\n' "$APP_PID" >"$APP_PID_FILE"

python3 - "$WRAPPER_FILE" "$URL" "$APP_PID" "$ROOT" "$ARMED" <<'PY'
import json, sys, time
path, url, pid, cwd, armed = sys.argv[1:]
with open(path, "w", encoding="utf-8") as f:
    json.dump({
        "url": url,
        "app_server_pid": int(pid),
        "cwd": cwd,
        "armed": armed == "1",
        "started_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }, f, ensure_ascii=False, indent=2)
PY

cleanup() {
    local rc=$?
    if [ "$KEEP_APP_SERVER" != "1" ]; then
        if kill -0 "$APP_PID" >/dev/null 2>&1; then
            kill "$APP_PID" >/dev/null 2>&1 || true
            wait "$APP_PID" >/dev/null 2>&1 || true
        fi
    fi
    exit "$rc"
}
trap cleanup EXIT INT TERM

python3 - "$ROOT" "$URL" "$BRIDGE" "$BEACON_BIN_SELECTED" "$INSTALL_ROOT" "$ARMED" "$$" <<'PY' &
import os, sqlite3, subprocess, sys, time
from pathlib import Path

cwd, url, bridge, beacon_bin, install_root, armed, wrapper_pid = sys.argv[1:]
codex_home = Path(os.environ.get("CODEX_HOME") or Path.home() / ".codex")
db = codex_home / "state_5.sqlite"
started = int(time.time())
deadline = time.time() + 3600
seen = set()

def latest_thread():
    if not db.is_file():
        return ""
    con = sqlite3.connect(str(db))
    try:
        rows = con.execute(
            "select id, updated_at from threads where cwd=? "
            "and source in ('vscode','cli') order by updated_at desc limit 8",
            (cwd,),
        ).fetchall()
    finally:
        con.close()
    for tid, updated in rows:
        if tid in seen:
            continue
        if int(updated or 0) >= started - 5:
            return str(tid)
    return ""

while time.time() < deadline:
    try:
        os.kill(int(wrapper_pid), 0)
    except OSError:
        sys.exit(0)
    tid = latest_thread()
    if tid:
        argv = [
            sys.executable,
            bridge,
            "restart",
            "--cwd",
            cwd,
            "--app-server",
            "--app-server-url",
            url,
            "--codex-thread-id",
            tid,
        ]
        if armed == "1":
            argv.append("--armed")
        env = {
            **os.environ,
            "BEACON_BIN": beacon_bin,
            "BEACON_INSTALL_ROOT": install_root,
        }
        subprocess.run(argv, env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        sys.exit(0)
    time.sleep(1)
PY
WATCHER_PID="$!"

echo "[bcodex] app-server: $URL (pid=$APP_PID)" >&2
echo "[bcodex] bridge will arm after the first Codex thread appears" >&2

if [ "${#CODEX_ARGS[@]}" -gt 0 ]; then
    "$CODEX_BIN" --remote "$URL" -C "$ROOT" "${CODEX_ARGS[@]}"
else
    "$CODEX_BIN" --remote "$URL" -C "$ROOT"
fi
CODEX_RC="$?"

if kill -0 "$WATCHER_PID" >/dev/null 2>&1; then
    kill "$WATCHER_PID" >/dev/null 2>&1 || true
fi

exit "$CODEX_RC"
