#!/usr/bin/env bash
# Beacon - Milestone-driven project dashboard
set -euo pipefail

BEACON_DIR="$(cd "$(dirname "$0")/.." && pwd)"
DASHBOARD_PY="$BEACON_DIR/lib/dashboard.py"
COMMANDS_PY="$BEACON_DIR/lib/commands.py"
export BEACON_PROJECT_FILE=".beacon/project.json"

usage() {
    cat <<'EOF'
Beacon - Milestone-driven project management

Usage:
  beacon                  Launch tmux dashboard + shell
  beacon init             Initialize .beacon/ in current directory
  beacon status           Show current status (no tmux)
  beacon milestone add    Add a new milestone (interactive)
  beacon milestone list   List milestones
  beacon milestone start <id>  Set milestone as active
  beacon milestone done <id>   Mark milestone as done
  beacon log [message]    Record current HEAD commit to active milestone
  beacon sync             Auto-sync recent git commits to active milestone
  beacon help             Show this help
EOF
}

ensure_project() {
    if [ ! -f "$BEACON_PROJECT_FILE" ]; then
        echo "Error: No .beacon/project.json found."
        echo "Run 'beacon init' first."
        exit 1
    fi
}

cmd_init() {
    if [ -f "$BEACON_PROJECT_FILE" ]; then
        echo ".beacon/project.json already exists."
        exit 1
    fi

    echo "Beacon - Project Initialization"
    echo "================================"
    echo ""
    read -rp "Project name: " name
    read -rp "Project objective: " objective

    BEACON_NAME="$name" BEACON_OBJECTIVE="$objective" \
        python3 "$COMMANDS_PY" init
}

cmd_milestone_add() {
    ensure_project
    echo "Add Milestone"
    echo "============="
    read -rp "Title: " title
    read -rp "Target date (YYYY-MM-DD): " target_date

    BEACON_TITLE="$title" BEACON_TARGET_DATE="$target_date" \
        python3 "$COMMANDS_PY" milestone_add
}

cmd_milestone_list() {
    ensure_project
    python3 "$COMMANDS_PY" milestone_list
}

cmd_milestone_start() {
    ensure_project
    local ms_id="${1:-}"
    if [ -z "$ms_id" ]; then
        echo "Usage: beacon milestone start <ms-id>"
        exit 1
    fi
    BEACON_MS_ID="$ms_id" python3 "$COMMANDS_PY" milestone_start
}

cmd_milestone_done() {
    ensure_project
    local ms_id="${1:-}"
    if [ -z "$ms_id" ]; then
        echo "Usage: beacon milestone done <ms-id>"
        exit 1
    fi
    BEACON_MS_ID="$ms_id" python3 "$COMMANDS_PY" milestone_done
}

cmd_log() {
    ensure_project
    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        echo "Error: Not a git repository"
        exit 1
    fi

    local ms_id=""
    local custom_summary=""
    local progress=""

    # Parse options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m)
                ms_id="${2:-}"
                shift 2
                ;;
            -p)
                progress="${2:-}"
                shift 2
                ;;
            *)
                custom_summary="$1"
                shift
                ;;
        esac
    done

    # Block if there are uncommitted changes (staged or unstaged)
    if ! git diff --quiet HEAD 2>/dev/null; then
        echo "Error: uncommitted changes detected."
        echo "Commit your changes first, then run beacon log."
        echo "  (To record a note without a commit, use: beacon task add \"description\")"
        exit 1
    fi

    local hash message date_str
    hash=$(git rev-parse --short HEAD)
    message=$(git log -1 --pretty=%s)
    date_str=$(git log -1 --pretty=%ci | cut -d' ' -f1)

    BEACON_HASH="$hash" BEACON_MESSAGE="$message" BEACON_DATE="$date_str" \
        BEACON_SUMMARY="$custom_summary" BEACON_MS_ID="$ms_id" \
        BEACON_PROGRESS="$progress" \
        python3 "$COMMANDS_PY" log
}

cmd_sync() {
    ensure_project
    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        echo "Error: Not a git repository"
        exit 1
    fi
    python3 "$COMMANDS_PY" sync
}

cmd_summary() {
    ensure_project
    local text="${*:-}"
    BEACON_SUMMARY_TEXT="$text" python3 "$COMMANDS_PY" summary
}

cmd_task_add() {
    ensure_project
    local ms_id=""
    local entry_type="task"
    local description=""
    local detail=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m)
                ms_id="${2:-}"
                shift 2
                ;;
            -t)
                entry_type="${2:-}"
                shift 2
                ;;
            -d)
                detail="${2:-}"
                shift 2
                ;;
            *)
                description="$1"
                shift
                ;;
        esac
    done

    local date_str
    date_str=$(date +%Y-%m-%d)

    BEACON_DESCRIPTION="$description" BEACON_MS_ID="$ms_id" \
        BEACON_TYPE="$entry_type" BEACON_DATE="$date_str" \
        BEACON_DETAIL="$detail" \
        python3 "$COMMANDS_PY" task_add
}

cmd_task_show() {
    ensure_project
    local entry_id="${1:-}"
    if [ -z "$entry_id" ]; then
        echo "Usage: beacon task show <entry-id>"
        exit 1
    fi
    BEACON_ENTRY_ID="$entry_id" python3 "$COMMANDS_PY" task_show
}

cmd_task_detail() {
    ensure_project
    local entry_id="${1:-}"
    local detail="${2:-}"
    if [ -z "$entry_id" ]; then
        echo "Usage: beacon task detail <entry-id> [detail-text]"
        exit 1
    fi
    BEACON_ENTRY_ID="$entry_id" BEACON_DETAIL="$detail" \
        python3 "$COMMANDS_PY" task_detail
}

cmd_task_done() {
    ensure_project
    local entry_id=""
    local progress=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p)
                progress="${2:-}"
                shift 2
                ;;
            *)
                entry_id="$1"
                shift
                ;;
        esac
    done

    if [ -z "$entry_id" ]; then
        echo "Usage: beacon task done <entry-id> [-p <progress>]"
        exit 1
    fi
    BEACON_ENTRY_ID="$entry_id" BEACON_PROGRESS="$progress" \
        python3 "$COMMANDS_PY" task_done
}

cmd_task_list() {
    ensure_project
    local ms_id=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m)
                ms_id="${2:-}"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    BEACON_MS_ID="$ms_id" python3 "$COMMANDS_PY" task_list
}

cmd_entry_move() {
    ensure_project
    local entry_id=""
    local task_id=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -t)
                task_id="${2:-}"
                shift 2
                ;;
            *)
                entry_id="$1"
                shift
                ;;
        esac
    done

    BEACON_ENTRY_ID="$entry_id" BEACON_TASK_ID="$task_id" \
        python3 "$COMMANDS_PY" entry_move
}

cmd_status() {
    ensure_project
    python3 "$COMMANDS_PY" milestone_list
}

cmd_launch() {
    ensure_project

    local session_name="beacon-$(basename "$(pwd)")"
    local abs_project
    abs_project="$(cd "$(dirname "$BEACON_PROJECT_FILE")" && pwd)/$(basename "$BEACON_PROJECT_FILE")"
    local work_dir
    work_dir="$(pwd)"
    local dashboard_pct="${BEACON_DASHBOARD_WIDTH:-33}"
    local work_pct=$((100 - dashboard_pct))

    # Kill existing session if any
    tmux kill-session -t "$session_name" 2>/dev/null || true

    # Create session with working shell, then split-left for dashboard.
    # Dashboard starts in the split pane which already has the correct size.
    tmux new-session -d -s "$session_name" -c "$work_dir"

    # Enable mouse scroll and increase scrollback buffer
    tmux set-option -t "$session_name" -g mouse on
    tmux set-option -t "$session_name" -g history-limit 10000

    # Create dashboard pane to the LEFT of the shell pane
    tmux split-window -hbd -t "$session_name" -c "$work_dir" \
        -l "${dashboard_pct}%" \
        "python3 '$DASHBOARD_PY' '$abs_project'"

    # Re-apply ratio on window resize (no quotes around % value for tmux to parse it)
    tmux set-hook -t "$session_name" after-resize-window \
        "resize-pane -t ${session_name}:.0 -x ${dashboard_pct}%"

    # Focus on the right (working) pane
    tmux select-pane -t "$session_name:.1"

    # Attach
    tmux attach-session -t "$session_name"
}

# --- Main dispatch ---
case "${1:-}" in
    ""|start)
        cmd_launch
        ;;
    init)
        cmd_init
        ;;
    status)
        cmd_status
        ;;
    milestone|ms)
        case "${2:-}" in
            add)    cmd_milestone_add ;;
            list|ls) cmd_milestone_list ;;
            start)  cmd_milestone_start "${3:-}" ;;
            done)   cmd_milestone_done "${3:-}" ;;
            *)      echo "Usage: beacon milestone [add|list|start|done]" ;;
        esac
        ;;
    log)
        shift
        cmd_log "$@"
        ;;
    sync)
        cmd_sync
        ;;
    summary)
        shift
        cmd_summary "$@"
        ;;
    task)
        case "${2:-}" in
            add)
                shift 2
                cmd_task_add "$@"
                ;;
            done)
                cmd_task_done "${3:-}"
                ;;
            list|ls)
                shift 2
                cmd_task_list "$@"
                ;;
            show)
                cmd_task_show "${3:-}"
                ;;
            detail)
                shift 2
                cmd_task_detail "$@"
                ;;
            *)
                echo "Usage: beacon task [add|done|list|show|detail] [-m <ms-id>] [-t <type>] [-d <detail>] [description]"
                ;;
        esac
        ;;
    entry)
        case "${2:-}" in
            move)
                shift 2
                cmd_entry_move "$@"
                ;;
            *)
                echo "Usage: beacon entry move <entry-id> -t <task-id>"
                ;;
        esac
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        echo "Unknown command: $1"
        usage
        exit 1
        ;;
esac
