cmd_task_detail() {
    ensure_project
    local entry_id="${1:-}"
    local detail="${2:-}"
    if [ -z "$entry_id" ]; then
        echo "Usage: beacon task detail <entry-id> [detail-text]"
        exit 1
    fi
    BEACON_ENTRY_ID="$entry_id" BEACON_DETAIL="$detail" \
        python3 "$COMMANDS_PY" task_detail
}

cmd_task_done() {
    ensure_project
    local entry_id=""
    local progress=""
    local reason=""
    local reason_set=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--progress) progress="${2:-}"; shift 2 ;;
            -r|--reason)   reason="${2:-}";   reason_set=1; shift 2 ;;
            *)             entry_id="$1";     shift   ;;
        esac
    done

    if [ -z "$entry_id" ]; then
        echo "Usage: beacon task done <entry-id> --reason <text> [-p <progress>]"
        exit 1
    fi
    # e-976: forward BEACON_REASON only when --reason was passed so the python
    # gate can distinguish "operator omitted the flag" (refuse) from
    # "operator passed --reason ''" (explicit waiver, accepted but discouraged).
    if [ "$reason_set" = "1" ]; then
        BEACON_ENTRY_ID="$entry_id" BEACON_PROGRESS="$progress" BEACON_REASON="$reason" \
            python3 "$COMMANDS_PY" task_done
    else
        BEACON_ENTRY_ID="$entry_id" BEACON_PROGRESS="$progress" \
            python3 "$COMMANDS_PY" task_done
    fi
}

cmd_task_cancel() {
    ensure_project
    local entry_id=""
    local reason=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -r|--reason) reason="${2:-}"; shift 2 ;;
            *)           entry_id="$1";  shift   ;;
        esac
    done

    if [ -z "$entry_id" ]; then
        echo "Usage: beacon task cancel <entry-id> [--reason <text>]"
        exit 1
    fi
    BEACON_ENTRY_ID="$entry_id" BEACON_REASON="$reason" \
        python3 "$COMMANDS_PY" task_cancel
}

cmd_task_list() {
    ensure_project
    local ms_id=""
    local json_flag=""
    local all_flag=""
    local type_filter=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m|--ms)
                ms_id="${2:-}"
                shift 2
                ;;
            --json)
                json_flag="1"
                shift
                ;;
            --all|-a)
                all_flag="1"
                shift
                ;;
            --type|-t)
                type_filter="${2:-}"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    BEACON_MS_ID="$ms_id" BEACON_JSON="$json_flag" BEACON_ALL="$all_flag" \
        BEACON_TYPE_FILTER="$type_filter" python3 "$COMMANDS_PY" task_list
}

cmd_entry_move() {
    ensure_project
    local entry_id=""
    local task_id=""
    local ms_id=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -t|--task)
                task_id="${2:-}"
                shift 2
                ;;
            -m|--ms)
                ms_id="${2:-}"
                shift 2
                ;;
            *)
                entry_id="$1"
                shift
                ;;
        esac
    done

    BEACON_ENTRY_ID="$entry_id" BEACON_TASK_ID="$task_id" BEACON_MS_ID="$ms_id" \
        python3 "$COMMANDS_PY" entry_move
}

cmd_retro() {
    ensure_project
    local since="" until=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --since) since="${2:-}"; shift 2 ;;
            --until) until="${2:-}"; shift 2 ;;
            --prepare) shift ;;
            *) shift ;;
        esac
    done

    # ms-43 e-570: when --since is omitted, prefer "day after last reviewed week"
    # over the naive "this Monday". If the user delayed retro from Friday to
    # Tuesday next week, "this Monday" would cover only 2 days and miss the
    # entire previous week. The Python helper looks at `.beacon/retro/.reviewed`
    # and falls back to ISO-week boundaries when no marker exists.
    if [ -z "$since" ]; then
        since=$(BEACON_DEFAULT_SINCE_QUERY=1 python3 "$COMMANDS_PY" retro_default_since 2>/dev/null)
    fi
    if [ -z "$until" ]; then
        local dow
        dow=$(date +%u)
        if [[ "$dow" -eq 1 ]]; then
            until=$(date -v-1d +%Y-%m-%d 2>/dev/null || date -d "yesterday" +%Y-%m-%d 2>/dev/null || date +%Y-%m-%d)
        else
            until=$(date +%Y-%m-%d)
        fi
    fi

    # Fallback if the helper didn't yield a value (older install, py error, etc.)
    if [ -z "$since" ]; then
        local dow
        dow=$(date +%u)
        if [[ "$(uname)" == "Darwin" ]]; then
            if [[ "$dow" -eq 1 ]]; then
                since=$(date -v-7d +%Y-%m-%d)
            else
                since=$(date -v-"$((dow - 1))"d +%Y-%m-%d)
            fi
        else
            if [[ "$dow" -eq 1 ]]; then
                since=$(date -d "7 days ago" +%Y-%m-%d 2>/dev/null || date +%Y-%m-%d)
            else
                since=$(date -d "last monday" +%Y-%m-%d 2>/dev/null || date +%Y-%m-%d)
            fi
        fi
    fi

    BEACON_SINCE="$since" BEACON_UNTIL="$until" \
        python3 "$COMMANDS_PY" retro_prepare
}

cmd_status() {
    ensure_project
    local json_flag=""
    local all_flag=""
    local ms_filter=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json_flag="1"; shift ;;
            --all|-a) all_flag="1"; shift ;;
            --ms)
                if [ -n "$ms_filter" ]; then
                    ms_filter="$ms_filter,${2:-}"
                else
                    ms_filter="${2:-}"
                fi
                shift 2 ;;
            *) shift ;;
        esac
    done
    BEACON_JSON="$json_flag" BEACON_ALL="$all_flag" BEACON_MS_FILTER="$ms_filter" \
        python3 "$COMMANDS_PY" milestone_list
}

cmd_cloud_launch() {
    local project_id="${1:-}"

    # If no project_id, show list and let user pick
    if [ -z "$project_id" ]; then
        echo "Cloud projects:"
        echo ""
        python3 "$COMMANDS_PY" cloud_list
        echo ""
        read -rp "Project ID to open: " project_id
        if [ -z "$project_id" ]; then
            echo "Cancelled."
            return 1
        fi
    fi

    # Verify the project exists in cloud before writing cloud.json
    if ! python3 "$COMMANDS_PY" cloud_check_project "$project_id" 2>/dev/null; then
        echo "Error: project '$project_id' not found in cloud."
        echo "Run 'beacon cloud list' to see available projects."
        return 1
    fi

    # Guard: warn if cloud.json already exists with a different project
    if [ -f .beacon/cloud.json ]; then
        local existing_id
        existing_id=$(python3 -c "import json; print(json.load(open('.beacon/cloud.json')).get('project_id',''))" 2>/dev/null)
        if [ -n "$existing_id" ] && [ "$existing_id" != "$project_id" ]; then
            echo "Warning: .beacon/cloud.json already points to '$existing_id'."
            read -rp "Switch to '$project_id'? [y/N]: " confirm
            if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
                echo "Cancelled."
                return 1
            fi
        fi
    fi

    # Ensure .beacon dir and cloud.json exist
    # e-1861 (ms-61): cloud.json existence is the sole source of truth. The
    # legacy config.json {"mode": "cloud"} marker is no longer written
    # (closes the silent-drift attack surface — sub-agents can't flip the
    # CLI off cloud by rewriting config.json anymore).
    mkdir -p .beacon
    cat > .beacon/cloud.json <<EOJSON
{
  "project_id": "$project_id",
  "api_url": "https://beacon-ai.dev"
}
EOJSON

    # Create a minimal project.json if it doesn't exist (cloud mode will override reads)
    if [ ! -f "$BEACON_PROJECT_FILE" ]; then
        echo '{"name":"cloud","milestones":[]}' > "$BEACON_PROJECT_FILE"
    fi

    # Launch with BEACON_CLOUD=1
    export BEACON_CLOUD=1
    cmd_launch
}

cmd_launch() {
    # e-764 (ms-4): legacy tmux/curses dashboard archived to
    # .trash/lib-dashboard-py-e764/. The bare `beacon` invocation now
    # prints status plus pointers to the Tauri Desktop App and Web UI,
    # which are the two supported front-ends going forward.
    ensure_project

    # Show the current status summary (same output as `beacon status`)
    cmd_status

    echo ""
    echo "UI:"
    echo "  - Tauri Desktop App: launch the bundled desktop app if installed"
    echo "    (see README → Desktop App)"

    # Show project-specific web URL when the project is cloud-linked.
    if [ -f .beacon/cloud.json ]; then
        local cloud_project_id
        cloud_project_id=$(python3 -c "import json; print(json.load(open('.beacon/cloud.json')).get('project_id',''))" 2>/dev/null || true)
        if [ -n "$cloud_project_id" ]; then
            echo "  - Web UI: https://beacon-ai.dev/?project=$cloud_project_id"
        else
            echo "  - Web UI: https://beacon-ai.dev"
        fi
    else
        echo "  - Web UI: https://beacon-ai.dev  (run 'beacon cloud push' to sync this project)"
    fi
    echo ""
    echo "Run 'beacon help' for the full command list."
}

cmd_doc() {
    ensure_project
    case "${1:-}" in
        add)
            shift
            local doc_title=""
            local doc_id=""
            local doc_content=""
            local doc_scope=""
            local json_flag=""
            local doc_ms=""
            local doc_op=""
            local doc_trek=""
            local doc_bus_origin=""

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --id)         doc_id="${2:-}"; shift 2 ;;
                    --scope|-s)   doc_scope="${2:-}"; shift 2 ;;
                    --ms)         doc_ms="${2:-}"; shift 2 ;;
                    --op)         doc_op="${2:-}"; shift 2 ;;
                    --trek)       doc_trek="${2:-}"; shift 2 ;;
                    --json)       json_flag="1"; shift ;;
                    --content)    doc_content="${2:-}"; shift 2 ;;
                    --bus-origin) doc_bus_origin="1"; shift ;;
                    --stdin)      shift ;;  # stdin is handled by Python side
                    *)            doc_title="$1"; shift ;;
                esac
            done

            if [ -z "$doc_title" ]; then
                echo "Usage: beacon doc add \"title\" [--scope core|spec|memo|retro|report] [--ms ms-id] [--op op-id] [--trek trek-id] [--id slug] [--content text] [--json]"
                echo "  Content can also be piped via stdin."
                exit 1
            fi
            BEACON_TITLE="$doc_title" BEACON_DOC_ID="$doc_id" \
                BEACON_CONTENT="$doc_content" BEACON_SCOPE="$doc_scope" \
                BEACON_MS="$doc_ms" BEACON_OP="$doc_op" \
                BEACON_TREK_ID="$doc_trek" \
                BEACON_JSON="$json_flag" \
                BEACON_BUS_ORIGIN="$doc_bus_origin" \
                python3 "$COMMANDS_PY" doc_add
            ;;
        list|ls)
            shift
            local json_flag=""
            local scope_filter=""
            local ms_filter=""
            local op_filter=""
            local include_trashed=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --json)             json_flag="1"; shift ;;
                    --scope|-s)         scope_filter="${2:-}"; shift 2 ;;
                    --ms)               ms_filter="${2:-}"; shift 2 ;;
                    --op)               op_filter="${2:-}"; shift 2 ;;
                    --include-trashed)  include_trashed="1"; shift ;;
                    *) shift ;;
                esac
            done
            BEACON_JSON="$json_flag" BEACON_SCOPE="$scope_filter" \
                BEACON_MS="$ms_filter" BEACON_OP="$op_filter" \
                BEACON_INCLUDE_TRASHED="$include_trashed" \
                python3 "$COMMANDS_PY" doc_list
            ;;
        update)
            shift
            local doc_id=""
            local doc_content=""
            local doc_title=""
            local doc_scope=""
            local doc_ms=""
            local doc_op=""
            local doc_trek=""
            local json_flag=""
            local doc_bus_origin=""
            # e-1859: distinguish "flag absent" from "flag passed empty".
            # Without this, --ms ms-1 on an op-scoped doc could not know
            # whether the user explicitly wants to switch scope (= drop op)
            # or accidentally keep both. The Python side treats the *_SET
            # marker as "user explicitly set this; honor their value, even
            # if empty (= clear the field)".
            local doc_ms_set=""
            local doc_op_set=""

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --content)    doc_content="${2:-}"; shift 2 ;;
                    --title)      doc_title="${2:-}"; shift 2 ;;
                    --scope|-s)   doc_scope="${2:-}"; shift 2 ;;
                    --ms)         doc_ms="${2:-}"; doc_ms_set="1"; shift 2 ;;
                    --op)         doc_op="${2:-}"; doc_op_set="1"; shift 2 ;;
                    --trek)       doc_trek="${2:-}"; shift 2 ;;
                    --json)       json_flag="1"; shift ;;
                    --bus-origin) doc_bus_origin="1"; shift ;;
                    --stdin)      shift ;;
                    *)            doc_id="$1"; shift ;;
                esac
            done

            if [ -z "$doc_id" ]; then
                echo "Usage: beacon doc update <doc-id> [--title text] [--scope core|spec|memo|retro|report] [--ms ms-id] [--op op-id] [--trek trek-id] [--content text] [--json]"
                echo "  Content can also be piped via stdin."
                exit 1
            fi
            BEACON_DOC_ID="$doc_id" BEACON_TITLE="$doc_title" \
                BEACON_CONTENT="$doc_content" BEACON_SCOPE="$doc_scope" \
                BEACON_MS="$doc_ms" BEACON_OP="$doc_op" \
                BEACON_MS_SET="$doc_ms_set" BEACON_OP_SET="$doc_op_set" \
                BEACON_TREK_ID="$doc_trek" \
                BEACON_JSON="$json_flag" \
                BEACON_BUS_ORIGIN="$doc_bus_origin" \
                python3 "$COMMANDS_PY" doc_update
            ;;
        show|get)
            shift
            local doc_id=""
            local json_flag=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --json) json_flag="1"; shift ;;
                    *)      doc_id="$1"; shift ;;
                esac
            done
            if [ -z "$doc_id" ]; then
                echo "Usage: beacon doc show <doc-id> [--json]"
                exit 1
            fi
            BEACON_DOC_ID="$doc_id" BEACON_JSON="$json_flag" python3 "$COMMANDS_PY" doc_show
            ;;
        delete|rm)
            shift
            local doc_id=""
            local doc_reason=""
            local json_flag=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -r|--reason) doc_reason="${2:-}"; shift 2 ;;
                    --json)      json_flag="1"; shift ;;
                    *)           doc_id="$1"; shift ;;
                esac
            done
            if [ -z "$doc_id" ]; then
                echo "Usage: beacon doc delete <doc-id> [--reason \"text\"] [--json]"
                exit 1
            fi
            BEACON_DOC_ID="$doc_id" BEACON_REASON="$doc_reason" BEACON_JSON="$json_flag" \
                python3 "$COMMANDS_PY" doc_delete
            ;;
        history)
            ensure_project
            BEACON_DOC_ID="${3:-}" python3 "$COMMANDS_PY" doc_history
            ;;
        restore)
            ensure_project
            shift
            local doc_id=""
            local rev=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --rev)       rev="${2:-}"; shift 2 ;;
                    *)           [[ -z "$doc_id" ]] && doc_id="$1"; shift ;;
                esac
            done
            BEACON_DOC_ID="$doc_id" BEACON_REV="$rev" \
                python3 "$COMMANDS_PY" doc_restore
            ;;
        image-upload)
            ensure_project
            shift
            local image_path=""
            local json_flag=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --json) json_flag="1"; shift ;;
                    *)      [[ -z "$image_path" ]] && image_path="$1"; shift ;;
                esac
            done
            if [ -z "$image_path" ]; then
                echo "Usage: beacon doc image-upload <local-file> [--json]"
                echo "  Uploads an image to GCS and prints a markdown img tag to stdout."
                echo "  Paste the output into a doc body (or use with beacon doc update)."
                exit 1
            fi
            BEACON_DOC_IMAGE_PATH="$image_path" BEACON_JSON="$json_flag" \
                python3 "$COMMANDS_PY" doc_image_upload
            ;;
        *)
            echo "Usage: beacon doc [add|list|show|update|delete|restore|history|image-upload]"
            echo "  add          \"title\" --scope core|spec|memo|retro|report [--ms ms-id]"
            echo "  update       <doc-id> [--title text] [--content text]"
            echo "  list         [--scope core|spec|memo|retro|report] [--ms ms-id] [--include-trashed]"
            echo "  show         <doc-id>"
            echo "  delete       <doc-id> [--reason \"text\"]"
            echo "  history      <doc-id>"
            echo "  restore      <doc-id> --rev <n>"
            echo "  image-upload <local-file>                           Upload image, get markdown img tag"
            ;;
    esac
}

cmd_pr() {
    ensure_project
    case "${1:-}" in
        show)
            shift
            local ident=""
            local json_flag=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --json) json_flag="1"; shift ;;
                    *)      ident="$1"; shift ;;
                esac
            done
            if [ -z "$ident" ]; then
                echo "Usage: beacon pr show <entry-id|pr-number|url> [--json]"
                exit 1
            fi
            BEACON_PR_IDENT="$ident" BEACON_JSON="$json_flag" \
                python3 "$COMMANDS_PY" pr_show
            ;;
        add)
            shift
            local url=""
            local ms_id=""
            local intent=""
            local author=""
            local json_flag=""

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -m|--ms)       ms_id="${2:-}"; shift 2 ;;
                    --intent)      intent="${2:-}"; shift 2 ;;
                    --author)      author="${2:-}"; shift 2 ;;
                    --json)        json_flag="1"; shift ;;
                    *)             url="$1"; shift ;;
                esac
            done

            if [ -z "$url" ]; then
                echo "Usage: beacon pr add <github-url> [-m <ms-id>] [--intent \"text\"] [--author user]"
                exit 1
            fi

            local date_str
            date_str=$(date +%Y-%m-%d)

            BEACON_URL="$url" BEACON_MS_ID="$ms_id" BEACON_INTENT="$intent" \
                BEACON_AUTHOR="$author" BEACON_DATE="$date_str" BEACON_JSON="$json_flag" \
                python3 "$COMMANDS_PY" pr_add
            ;;
        close)
            shift
            local entry_id=""
            local json_flag=""

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --json) json_flag="1"; shift ;;
                    *)      entry_id="$1"; shift ;;
                esac
            done

            if [ -z "$entry_id" ]; then
                echo "Usage: beacon pr close <entry-id> [--json]"
                exit 1
            fi
            BEACON_ENTRY_ID="$entry_id" BEACON_JSON="$json_flag" python3 "$COMMANDS_PY" pr_close
            ;;
        approve)
            shift
            local entry_id=""
            local rationale=""
            local json_flag=""

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --rationale) rationale="${2:-}"; shift 2 ;;
                    --json)      json_flag="1"; shift ;;
                    *)           entry_id="$1"; shift ;;
                esac
            done

            if [ -z "$entry_id" ]; then
                echo "Usage: beacon pr approve <entry-id> [--rationale \"text\"] [--json]"
                exit 1
            fi
            BEACON_ENTRY_ID="$entry_id" BEACON_RATIONALE="$rationale" BEACON_JSON="$json_flag" \
                python3 "$COMMANDS_PY" pr_approve
            ;;
        reject)
            shift
            local entry_id=""
            local rationale=""
            local json_flag=""

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --rationale) rationale="${2:-}"; shift 2 ;;
                    --json)      json_flag="1"; shift ;;
                    *)           entry_id="$1"; shift ;;
                esac
            done

            if [ -z "$entry_id" ]; then
                echo "Usage: beacon pr reject <entry-id> [--rationale \"text\"] [--json]"
                exit 1
            fi
            BEACON_ENTRY_ID="$entry_id" BEACON_RATIONALE="$rationale" BEACON_JSON="$json_flag" \
                python3 "$COMMANDS_PY" pr_reject
            ;;
        create)
            shift
            local ms_id=""
            local intent=""
            local gh_args=""

            # Collect known beacon flags; pass remaining args to gh pr create
            local remaining=()
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -m|--ms)     ms_id="${2:-}"; shift 2 ;;
                    --intent)    intent="${2:-}"; shift 2 ;;
                    *)           remaining+=("$1"); shift ;;
                esac
            done

            # Build gh args string for passthrough (printf %q preserves args with spaces)
            if [ ${#remaining[@]} -gt 0 ]; then
                gh_args=$(printf '%q ' "${remaining[@]}")
            fi

            BEACON_MS_ID="$ms_id" BEACON_INTENT="$intent" BEACON_GH_ARGS="$gh_args" \
                python3 "$COMMANDS_PY" pr_create
            ;;
        request-review)
            shift
            local entry_id=""
            local json_flag=""

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --json) json_flag="1"; shift ;;
                    *)      entry_id="$1"; shift ;;
                esac
            done

            if [ -z "$entry_id" ]; then
                echo "Usage: beacon pr request-review <entry-id> [--json]"
                exit 1
            fi
            BEACON_ENTRY_ID="$entry_id" BEACON_JSON="$json_flag" python3 "$COMMANDS_PY" pr_request_review
            ;;
        request-changes)
            shift
            local entry_id=""
            local rationale=""
            local json_flag=""

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --rationale) rationale="${2:-}"; shift 2 ;;
                    --json)      json_flag="1"; shift ;;
                    *)           entry_id="$1"; shift ;;
                esac
            done

            if [ -z "$entry_id" ]; then
                echo "Usage: beacon pr request-changes <entry-id> [--rationale \"text\"] [--json]"
                exit 1
            fi
            BEACON_ENTRY_ID="$entry_id" BEACON_RATIONALE="$rationale" BEACON_JSON="$json_flag" \
                python3 "$COMMANDS_PY" pr_request_changes
            ;;
        review)
            echo "beacon pr review is now handled by the /review Claude Code Skill."
            echo "Use: /review <PR-number>"
            ;;
        merge)
            shift
            local entry_id=""
            local json_flag=""

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --json) json_flag="1"; shift ;;
                    *)      entry_id="$1"; shift ;;
                esac
            done

            if [ -z "$entry_id" ]; then
                echo "Usage: beacon pr merge <entry-id> [--json]"
                exit 1
            fi
            BEACON_ENTRY_ID="$entry_id" BEACON_JSON="$json_flag" python3 "$COMMANDS_PY" pr_merge
            ;;
        *)
            echo "Usage: beacon pr [create|add|show|review|approve|request-changes|reject|merge|close]"
            echo "  create          [-m <ms-id>] [--intent \"text\"] [gh pr create flags...]"
            echo "                  Run gh pr create and auto-record the PR in beacon"
            echo "  add             <github-url> [-m <ms-id>] [--intent \"text\"]  Register a PR"
            echo "  show            <entry-id|pr-number|url> [--json]  Show PR detail (intent, commits, review history)"
            echo "  review          → use /review Claude Code Skill instead"
            echo "  approve         <entry-id> [--rationale \"text\"]  Approve (rationale required)"
            echo "  request-changes <entry-id> [--rationale \"text\"]  Request changes"
            echo "  reject          <entry-id> [--rationale \"text\"]  Reject a PR"
            echo "  merge           <entry-id>   Mark as merged"
            echo "  close           <entry-id>   Close without merging"
            ;;
    esac
}

# --- Locate the project root by walking up from CWD (like git) so beacon
#     works from any subdirectory, not just the dir that holds .beacon/ (e-862).
find_beacon_root() {
    local dir="$PWD"
    while [ -n "$dir" ]; do
        if [ -f "$dir/.beacon/project.json" ]; then
            printf '%s\n' "$dir"
            return 0
        fi
        [ "$dir" = "/" ] && break
        dir="$(dirname "$dir")"
    done
    return 1
}

# e-1227 (ms-17): stash the cwd at invocation time *before* the relocate
# below changes it. Handlers that need git HEAD from the user's actual
# location (notably `cmd_log`, which runs inside parallel sub-agent
# worktrees where .beacon/ lives in the parent repo) consult
# $BEACON_INVOCATION_CWD via `git -C` so they don't accidentally capture
# the parent repo's HEAD after the relocate below.
export BEACON_INVOCATION_CWD="$PWD"

# ms-64 / e-1458: top-level `--profile <name>` flag. Parsed early so it
# affects all subcommands uniformly. Exported as BEACON_PROFILE which the
# Python-side profile resolver (lib/profile.py) honors above cwd cloud.json
# and below an explicit `--profile` passed to a Python entry point. The flag
# is repeatable but only the last value wins.
while [ "${1:-}" = "--profile" ]; do
    if [ -z "${2:-}" ]; then
        echo "Error: --profile requires a value (profile name)" >&2
        exit 2
    fi
    export BEACON_PROFILE="$2"
    shift 2
done

# Relocate to the project root before dispatch. `setup`/`init` operate on the
# current directory by design, so they are exempt.
case "${1:-}" in
    setup|init) ;;
    *)
        if [ ! -f "$BEACON_PROJECT_FILE" ]; then
            _beacon_root="$(find_beacon_root || true)"
            if [ -n "${_beacon_root:-}" ]; then
                cd "$_beacon_root"
            fi
        fi
        ;;
esac

# --- Main dispatch ---
case "${1:-}" in
    ""|start)
        cmd_launch
        ;;
    setup)
        cmd_setup
        ;;
    init)
        shift
        _init_name="" _init_objective="" _init_retro_day="" _init_storage="local"
        # ms-63 / e-1441: default sensitivity is high (= SPEC § 設計方針 2
        # safe default). Opt-in low via --sensitivity low for OSS-style
        # open projects.
        _init_sensitivity="high"
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --name)        _init_name="${2:-}"; shift 2 ;;
                --objective)   _init_objective="${2:-}"; shift 2 ;;
                --retro-day)   _init_retro_day="${2:-}"; shift 2 ;;
                --storage)     _init_storage="${2:-}"; shift 2 ;;
                --sensitivity) _init_sensitivity="${2:-}"; shift 2 ;;
                *) shift ;;
            esac
        done
        BEACON_INIT_NAME="$_init_name" BEACON_INIT_OBJECTIVE="$_init_objective" \
            BEACON_INIT_RETRO_DAY="$_init_retro_day" BEACON_INIT_STORAGE="$_init_storage" \
            BEACON_INIT_SENSITIVITY="$_init_sensitivity" \
            cmd_init
        ;;
    status)
        shift
        cmd_status "$@"
        ;;
    milestone|ms)
        case "${2:-}" in
            add)    shift 2; cmd_milestone_add "$@" ;;
            list|ls) cmd_milestone_list ;;
            start)  shift 2; cmd_milestone_start "$@" ;;
            join)   shift 2; cmd_milestone_join "$@" ;;
            done|close) shift 2; cmd_milestone_done "$@" ;;
            observe)    shift 2; cmd_milestone_observe "$@" ;;
            show)   shift 2; cmd_milestone_show "$@" ;;
            update) shift 2; cmd_milestone_update "$@" ;;
            rename) BEACON_MS_ID="${3:-}" BEACON_TITLE="${4:-}" python3 "$COMMANDS_PY" milestone_update ;;
            delete|cancel) shift 2; cmd_milestone_delete "$@" ;;
            purge) shift 2; cmd_milestone_purge "$@" ;;
            depends) shift 2; cmd_milestone_depends "$@" ;;
            workspace) shift 2; cmd_milestone_workspace "$@" ;;
            workspace-cleanup) shift 2; cmd_milestone_workspace_cleanup "$@" ;;
            graph) shift 2; cmd_milestone_graph "$@" ;;
            *)      echo "Usage: beacon milestone [add|list|start|join|close|observe|done|show|update|rename|delete|purge|depends|workspace|workspace-cleanup|graph]" ;;
        esac
        ;;
    log)
        shift
        cmd_log "$@"
        ;;
    save)
        shift
        cmd_save "$@"
        ;;
    sync)
        cmd_sync
        ;;
    summary)
        shift
        cmd_summary "$@"
        ;;
    task)
        case "${2:-}" in
            add)
                shift 2
                cmd_task_add "$@"
                ;;
            done)
                shift 2
                cmd_task_done "$@"
                ;;
            list|ls)
                shift 2
                cmd_task_list "$@"
                ;;
            show)
                shift 2
                cmd_task_show "$@"
                ;;
            detail)
                shift 2
                cmd_task_detail "$@"
                ;;
            update)
                shift 2
                cmd_task_update "$@"
                ;;
            cancel)
                shift 2
                cmd_task_cancel "$@"
                ;;
            delete)
                shift 2
                cmd_task_delete "$@"
                ;;
            *)
                echo "Usage: beacon task [add|done|list|show|detail|update|cancel|delete] [-m <ms-id>] [-t <type>] [-d <detail>] [description]"
                ;;
        esac
        ;;
    entry)
        case "${2:-}" in
            move)
                shift 2
                cmd_entry_move "$@"
                ;;
            purge)
                shift 2
                cmd_entry_purge "$@"
                ;;
            *)
                echo "Usage: beacon entry move <entry-id> -t <task-id> | -m <ms-id>"
                echo "       beacon entry purge <e-id> --reason <text> [--index <n>]"
                ;;
        esac
        ;;
    pr)
        shift
        cmd_pr "$@"
        ;;
    issue)
        ensure_project
        case "${2:-}" in
            import)
                BEACON_ISSUE_NUMBER="${3:-}" BEACON_MS_ID="${5:-}" \
                    BEACON_JSON="${4:+1}" python3 "$COMMANDS_PY" issue_import
                ;;
            sync)
                shift 2
                ms=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        -m|--ms) ms="${2:-}"; shift 2 ;;
                        *) shift ;;
                    esac
                done
                BEACON_MS_ID="$ms" python3 "$COMMANDS_PY" issue_sync
                ;;
            list)
                BEACON_JSON="${3:+1}" python3 "$COMMANDS_PY" issue_list
                ;;
            *)
                echo "Usage: beacon issue import <number> [-m <ms-id>]"
                echo "       beacon issue sync [-m <ms-id>]"
                echo "       beacon issue list [--json]"
                ;;
        esac
        ;;
    operation)
        # purge is a recovery path — it must run even on a project that fails
        # validation, so it skips ensure_project (like milestone purge).
        if [ "${2:-}" != "purge" ]; then
            ensure_project
        fi
        case "${2:-}" in
            purge)
                shift 2
                cmd_operation_purge "$@"
                ;;
            open)
                shift 2
                title="" schedule="weekdays" log_source="" status="open"
                activation_hint="" objective="" ac="" priority=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --schedule) schedule="${2:-}"; shift 2 ;;
                        --log-source) log_source="${2:-}"; shift 2 ;;
                        --status) status="${2:-}"; shift 2 ;;
                        --activation-hint|--hint) activation_hint="${2:-}"; shift 2 ;;
                        --objective) objective="${2:-}"; shift 2 ;;
                        --acceptance-criteria|--ac) ac="${2:-}"; shift 2 ;;
                        --priority) priority="${2:-}"; shift 2 ;;
                        *) [[ -z "$title" ]] && title="$1"; shift ;;
                    esac
                done
                BEACON_OPERATION_TITLE="$title" \
                    BEACON_OPERATION_SCHEDULE="$schedule" \
                    BEACON_OPERATION_LOG_SOURCE="$log_source" \
                    BEACON_OPERATION_STATUS="$status" \
                    BEACON_ACTIVATION_HINT="$activation_hint" \
                    BEACON_OBJECTIVE="$objective" \
                    BEACON_ACCEPTANCE_CRITERIA="$ac" \
                    BEACON_PRIORITY="$priority" \
                    python3 "$COMMANDS_PY" operation_open
                ;;
            create)
                # alias: create in todo state by default
                shift 2
                title="" schedule="weekdays" log_source="" status="todo"
                activation_hint="" objective="" ac="" priority=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --schedule) schedule="${2:-}"; shift 2 ;;
                        --log-source) log_source="${2:-}"; shift 2 ;;
                        --status) status="${2:-}"; shift 2 ;;
                        --activation-hint|--hint) activation_hint="${2:-}"; shift 2 ;;
                        --objective) objective="${2:-}"; shift 2 ;;
                        --acceptance-criteria|--ac) ac="${2:-}"; shift 2 ;;
                        --priority) priority="${2:-}"; shift 2 ;;
                        *) [[ -z "$title" ]] && title="$1"; shift ;;
                    esac
                done
                BEACON_OPERATION_TITLE="$title" \
                    BEACON_OPERATION_SCHEDULE="$schedule" \
                    BEACON_OPERATION_LOG_SOURCE="$log_source" \
                    BEACON_OPERATION_STATUS="$status" \
                    BEACON_ACTIVATION_HINT="$activation_hint" \
                    BEACON_OBJECTIVE="$objective" \
                    BEACON_ACCEPTANCE_CRITERIA="$ac" \
                    BEACON_PRIORITY="$priority" \
                    python3 "$COMMANDS_PY" operation_open
                ;;
            activate)
                BEACON_OPERATION_ID="${3:-}" BEACON_OPERATION_STATUS="open" \
                    python3 "$COMMANDS_PY" operation_set_status
                ;;
            status)
                BEACON_OPERATION_ID="${3:-}" BEACON_OPERATION_STATUS="${4:-}" \
                    python3 "$COMMANDS_PY" operation_set_status
                ;;
            update)
                shift 2
                op_id="" title="" schedule="" hint="" obj="" ac="" priority=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --title) title="${2:-}"; shift 2 ;;
                        --schedule) schedule="${2:-}"; shift 2 ;;
                        --activation-hint|--hint) hint="${2:-}"; shift 2 ;;
                        --objective) obj="${2:-}"; shift 2 ;;
                        --acceptance-criteria|--ac) ac="${2:-}"; shift 2 ;;
                        --priority) priority="${2:-}"; shift 2 ;;
                        *) [[ -z "$op_id" ]] && op_id="$1"; shift ;;
                    esac
                done
                BEACON_OPERATION_ID="$op_id" BEACON_TITLE="$title" \
                    BEACON_OPERATION_SCHEDULE="$schedule" \
                    BEACON_ACTIVATION_HINT="$hint" \
                    BEACON_OBJECTIVE="$obj" \
                    BEACON_ACCEPTANCE_CRITERIA="$ac" \
                    BEACON_PRIORITY="$priority" \
                    python3 "$COMMANDS_PY" operation_update
                ;;
            close)
                BEACON_OPERATION_ID="${3:-}" python3 "$COMMANDS_PY" operation_close
                ;;
            list)
                BEACON_JSON="${3:+1}" python3 "$COMMANDS_PY" operation_list
                ;;
            show)
                BEACON_OPERATION_ID="${3:-}" BEACON_JSON="${4:+1}" python3 "$COMMANDS_PY" operation_show
                ;;
            approve)
                # beacon operation approve <op-id> --spec <doc-id> [--expires-at YYYY-MM-DD | --ttl-seconds N] [--json]
                shift 2
                op_id="" spec="" expires_at="" ttl_seconds="" json_flag=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --spec) spec="${2:-}"; shift 2 ;;
                        --expires-at) expires_at="${2:-}"; shift 2 ;;
                        --ttl-seconds) ttl_seconds="${2:-}"; shift 2 ;;
                        --json) json_flag="1"; shift ;;
                        *) [[ -z "$op_id" ]] && op_id="$1"; shift ;;
                    esac
                done
                # Translate --expires-at YYYY-MM-DD into ttl_seconds (the API expects seconds).
                if [[ -n "$expires_at" && -z "$ttl_seconds" ]]; then
                    if ! ttl_seconds=$(python3 -c "
import datetime, sys
try:
    target = datetime.datetime.strptime('$expires_at', '%Y-%m-%d').replace(tzinfo=datetime.timezone.utc)
    now = datetime.datetime.now(datetime.timezone.utc)
    delta = int((target - now).total_seconds())
    if delta <= 0:
        sys.exit('Error: --expires-at must be in the future')
    print(delta)
except ValueError as e:
    sys.exit(f'Error: invalid --expires-at format (need YYYY-MM-DD): {e}')
"); then
                        exit 1
                    fi
                fi
                BEACON_OPERATION_ID="$op_id" BEACON_SPEC_DOC_ID="$spec" \
                    BEACON_TTL_SECONDS="$ttl_seconds" BEACON_JSON="$json_flag" \
                    python3 "$COMMANDS_PY" operation_approve
                ;;
            revoke)
                # beacon operation revoke <op-id> [--envelope-id ENV] [--reason TEXT] [--json]
                shift 2
                op_id="" env_id="" reason="" json_flag=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --envelope-id) env_id="${2:-}"; shift 2 ;;
                        -r|--reason) reason="${2:-}"; shift 2 ;;
                        --json) json_flag="1"; shift ;;
                        *) [[ -z "$op_id" ]] && op_id="$1"; shift ;;
                    esac
                done
                BEACON_OPERATION_ID="$op_id" BEACON_ENVELOPE_ID="$env_id" \
                    BEACON_REASON="$reason" BEACON_JSON="$json_flag" \
                    python3 "$COMMANDS_PY" operation_revoke
                ;;
            envelope)
                # beacon operation envelope verify <op-id> <action> [--json]
                case "${3:-}" in
                    verify)
                        shift 3
                        op_id="" action="" json_flag=""
                        while [[ $# -gt 0 ]]; do
                            case "$1" in
                                --json) json_flag="1"; shift ;;
                                *) if [[ -z "$op_id" ]]; then op_id="$1"
                                   elif [[ -z "$action" ]]; then action="$1"
                                   fi; shift ;;
                            esac
                        done
                        BEACON_OPERATION_ID="$op_id" BEACON_ACTION="$action" \
                            BEACON_JSON="$json_flag" \
                            python3 "$COMMANDS_PY" operation_envelope_verify
                        ;;
                    *)
                        echo "Usage: beacon operation envelope verify <op-id> <action> [--json]" >&2
                        exit 1
                        ;;
                esac
                ;;
            task)
                case "${3:-}" in
                    add)
                        shift 3
                        op_id="" desc="" priority="" motivation="" ac=""
                        while [[ $# -gt 0 ]]; do
                            case "$1" in
                                -o|--op) op_id="${2:-}"; shift 2 ;;
                                --priority) priority="${2:-}"; shift 2 ;;
                                --motivation|--why) motivation="${2:-}"; shift 2 ;;
                                --acceptance-criteria|--ac) ac="${2:-}"; shift 2 ;;
                                *) [[ -z "$desc" ]] && desc="$1"; shift ;;
                            esac
                        done
                        BEACON_OPERATION_ID="$op_id" BEACON_DESCRIPTION="$desc" \
                            BEACON_PRIORITY="$priority" \
                            BEACON_MOTIVATION="$motivation" \
                            BEACON_ACCEPTANCE_CRITERIA="$ac" \
                            python3 "$COMMANDS_PY" operation_task_add
                        ;;
                    done)
                        shift 3
                        entry_id="" reason=""
                        while [[ $# -gt 0 ]]; do
                            case "$1" in
                                -r|--reason) reason="${2:-}"; shift 2 ;;
                                *) [[ -z "$entry_id" ]] && entry_id="$1"; shift ;;
                            esac
                        done
                        BEACON_ENTRY_ID="$entry_id" BEACON_REASON="$reason" \
                            python3 "$COMMANDS_PY" operation_task_done
                        ;;
                    list)
                        shift 3
                        op_id="" json_flag=""
                        while [[ $# -gt 0 ]]; do
                            case "$1" in
                                -o|--op) op_id="${2:-}"; shift 2 ;;
                                --json) json_flag="1"; shift ;;
                                *) shift ;;
                            esac
                        done
                        BEACON_OPERATION_ID="$op_id" BEACON_JSON="$json_flag" \
                            python3 "$COMMANDS_PY" operation_task_list
                        ;;
                    *)
                        echo "Usage: beacon operation task add \"<desc>\" -o <op-id> [--priority P --why W --ac A]"
                        echo "       beacon operation task done <entry-id> [--reason R]"
                        echo "       beacon operation task list -o <op-id> [--json]"
                        ;;
                esac
                ;;
            *)
                echo "Usage: beacon operation open \"<title>\" [--schedule daily|weekdays|weekly]"
                echo "                                [--status todo|in_progress|open|closed]"
                echo "                                [--activation-hint H --objective O --ac A --priority P]"
                echo "       beacon operation create \"<title>\" ...    (alias for open --status todo)"
                echo "       beacon operation activate <op-id>          (todo/in_progress → open)"
                echo "       beacon operation status <op-id> <status>   (any transition)"
                echo "       beacon operation update <op-id> [--title --schedule --hint --objective --ac --priority]"
                echo "       beacon operation close <op-id>"
                echo "       beacon operation list [--json]"
                echo "       beacon operation show <op-id> [--json]"
                echo "       beacon operation approve <op-id> --spec <doc-id> [--expires-at YYYY-MM-DD] [--json]"
                echo "       beacon operation revoke <op-id> [--envelope-id ENV] [--reason TEXT] [--json]"
                echo "       beacon operation envelope verify <op-id> <action> [--json]"
                echo "       beacon operation task add/done/list ..."
                ;;
        esac
        ;;
    trek)
        # Trek is a top-level cross-project entity, so we don't call
        # ensure_project. Storage is ~/.beacon/treks/ (local mode) until
        # the HTTP path lands in e-1656.
        case "${2:-}" in
            create)
                shift 2
                title="" type_="" desc=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --type) type_="${2:-}"; shift 2 ;;
                        --description|--desc) desc="${2:-}"; shift 2 ;;
                        --json) export BEACON_JSON=1; shift ;;
                        *) [[ -z "$title" ]] && title="$1"; shift ;;
                    esac
                done
                BEACON_TREK_TITLE="$title" \
                    BEACON_TREK_TYPE="$type_" \
                    BEACON_TREK_DESCRIPTION="$desc" \
                    python3 "$COMMANDS_PY" trek_create
                ;;
            list|ls)
                shift 2
                status_filter="" include_archived="" all_actors=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --status) status_filter="${2:-}"; shift 2 ;;
                        --all|--include-archived) include_archived="1"; shift ;;
                        --all-actors) all_actors="1"; shift ;;
                        --json) export BEACON_JSON=1; shift ;;
                        *) shift ;;
                    esac
                done
                BEACON_TREK_STATUS="$status_filter" \
                    BEACON_TREK_INCLUDE_ARCHIVED="$include_archived" \
                    BEACON_TREK_ALL_ACTORS="$all_actors" \
                    python3 "$COMMANDS_PY" trek_list
                ;;
            show|get)
                shift 2
                trek_id=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --json) export BEACON_JSON=1; shift ;;
                        *) [[ -z "$trek_id" ]] && trek_id="$1"; shift ;;
                    esac
                done
                BEACON_TREK_ID="$trek_id" python3 "$COMMANDS_PY" trek_show
                ;;
            start)
                shift 2
                trek_id=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --json) export BEACON_JSON=1; shift ;;
                        *) [[ -z "$trek_id" ]] && trek_id="$1"; shift ;;
                    esac
                done
                BEACON_TREK_ID="$trek_id" python3 "$COMMANDS_PY" trek_start
                ;;
            archive)
                shift 2
                trek_id=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --json) export BEACON_JSON=1; shift ;;
                        *) [[ -z "$trek_id" ]] && trek_id="$1"; shift ;;
                    esac
                done
                BEACON_TREK_ID="$trek_id" python3 "$COMMANDS_PY" trek_archive
                ;;
            invite)
                shift 2
                trek_id="" actor="" notify=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --actor) actor="${2:-}"; shift 2 ;;
                        --notify) notify="1"; shift ;;
                        --json) export BEACON_JSON=1; shift ;;
                        *) [[ -z "$trek_id" ]] && trek_id="$1"; shift ;;
                    esac
                done
                BEACON_TREK_ID="$trek_id" \
                    BEACON_TREK_ACTOR="$actor" \
                    BEACON_TREK_NOTIFY="$notify" \
                    python3 "$COMMANDS_PY" trek_invite
                ;;
            join)
                shift 2
                trek_id=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --json) export BEACON_JSON=1; shift ;;
                        *) [[ -z "$trek_id" ]] && trek_id="$1"; shift ;;
                    esac
                done
                BEACON_TREK_ID="$trek_id" python3 "$COMMANDS_PY" trek_join
                ;;
            leave)
                shift 2
                trek_id=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --json) export BEACON_JSON=1; shift ;;
                        *) [[ -z "$trek_id" ]] && trek_id="$1"; shift ;;
                    esac
                done
                BEACON_TREK_ID="$trek_id" python3 "$COMMANDS_PY" trek_leave
                ;;
            plan)
                shift 2
                trek_id="" scope_add="" scope_remove=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --add-scope) scope_add="${2:-}"; shift 2 ;;
                        --remove-scope) scope_remove="${2:-}"; shift 2 ;;
                        --json) export BEACON_JSON=1; shift ;;
                        *) [[ -z "$trek_id" ]] && trek_id="$1"; shift ;;
                    esac
                done
                BEACON_TREK_ID="$trek_id" \
                    BEACON_TREK_SCOPE_ADD="$scope_add" \
                    BEACON_TREK_SCOPE_REMOVE="$scope_remove" \
                    python3 "$COMMANDS_PY" trek_plan
                ;;
            stop)
                shift 2
                trek_id="" reason=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --reason) reason="${2:-}"; shift 2 ;;
                        --json) export BEACON_JSON=1; shift ;;
                        *) [[ -z "$trek_id" ]] && trek_id="$1"; shift ;;
                    esac
                done
                BEACON_TREK_ID="$trek_id" BEACON_TREK_REASON="$reason" \
                    python3 "$COMMANDS_PY" trek_stop
                ;;
            resume)
                shift 2
                trek_id=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --json) export BEACON_JSON=1; shift ;;
                        *) [[ -z "$trek_id" ]] && trek_id="$1"; shift ;;
                    esac
                done
                BEACON_TREK_ID="$trek_id" python3 "$COMMANDS_PY" trek_resume
                ;;
            transfer-leader)
                shift 2
                trek_id="" to_sid=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --to) to_sid="${2:-}"; shift 2 ;;
                        --json) export BEACON_JSON=1; shift ;;
                        *) [[ -z "$trek_id" ]] && trek_id="$1"; shift ;;
                    esac
                done
                BEACON_TREK_ID="$trek_id" BEACON_TREK_TO="$to_sid" \
                    python3 "$COMMANDS_PY" trek_transfer_leader
                ;;
            *)
                echo "Usage: beacon trek <subcommand> [args]"
                echo ""
                echo "Subcommands:"
                echo "  create \"<title>\" [--type temporary|persistent] [--description \"...\"]"
                echo "  list [--status S] [--all] [--all-actors] [--json]"
                echo "  show <trek-id> [--json]"
                echo "  start <trek-id>"
                echo "  archive <trek-id>"
                echo "  invite <trek-id> --actor <email> [--notify]"
                echo "  join <trek-id>"
                echo "  leave <trek-id>"
                echo "  plan <trek-id> --add-scope <project[:ref]>"
                echo "  plan <trek-id> --remove-scope <project[:ref]>"
                echo "  stop <trek-id> [--reason \"...\"]    (= Andon cord、halt 信号を立てる)"
                echo "  resume <trek-id>                     (= halt 信号を clear)"
                echo "  transfer-leader <trek-id> --to <session-id>"
                echo ""
                echo "Env (creator identity, required for 'create'):"
                echo "  BEACON_USER_EMAIL    creator email"
                echo "  BEACON_SESSION_ID    creator session id (becomes initial leader)"
                echo "  BEACON_USER_ID       creator user_id (fallback: whoami)"
                exit 1
                ;;
        esac
        ;;
    run)
        ensure_project
        case "${2:-}" in
            record)
                shift 2
                op_id=""
                batch=""
                status=""
                desc=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        -o|--op) op_id="${2:-}"; shift 2 ;;
                        --batch) batch="${2:-}"; shift 2 ;;
                        --status) status="${2:-}"; shift 2 ;;
                        --desc) desc="${2:-}"; shift 2 ;;
                        *) shift ;;
                    esac
                done
                BEACON_OPERATION_ID="$op_id" BEACON_RUN_BATCH="$batch" \
                    BEACON_RUN_STATUS="$status" BEACON_RUN_DESC="$desc" \
                    python3 "$COMMANDS_PY" run_record
                ;;
            list)
                shift 2
                op_id=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        -o|--op) op_id="${2:-}"; shift 2 ;;
                        --json) BEACON_JSON=1; shift ;;
                        *) shift ;;
                    esac
                done
                BEACON_OPERATION_ID="$op_id" python3 "$COMMANDS_PY" run_list
                ;;
            *)
                echo "Usage: beacon run record -o <op-id> --batch <name> --status ok|warning|error --desc \"...\""
                echo "       beacon run list -o <op-id> [--json]"
                ;;
        esac
        ;;
    incident)
        ensure_project
        case "${2:-}" in
            open)
                shift 2
                op_id=""
                title=""
                desc=""
                priority=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        -o|--op)    op_id="${2:-}";    shift 2 ;;
                        --desc)     desc="${2:-}";     shift 2 ;;
                        --priority) priority="${2:-}"; shift 2 ;;
                        *) [[ -z "$title" ]] && title="$1"; shift ;;
                    esac
                done
                BEACON_OPERATION_ID="$op_id" BEACON_INCIDENT_TITLE="$title" \
                    BEACON_INCIDENT_DESC="$desc" BEACON_INCIDENT_PRIORITY="$priority" \
                    python3 "$COMMANDS_PY" incident_open
                ;;
            close)
                shift 2
                incident_id=""
                resolution=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --resolution) resolution="${2:-}"; shift 2 ;;
                        *) [[ -z "$incident_id" ]] && incident_id="$1"; shift ;;
                    esac
                done
                BEACON_INCIDENT_ID="$incident_id" BEACON_INCIDENT_RESOLUTION="$resolution" \
                    python3 "$COMMANDS_PY" incident_close
                ;;
            escalate)
                shift 2
                incident_id=""
                ms_id=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        -m|--ms) ms_id="${2:-}"; shift 2 ;;
                        *) [[ -z "$incident_id" ]] && incident_id="$1"; shift ;;
                    esac
                done
                BEACON_INCIDENT_ID="$incident_id" BEACON_MS_ID="$ms_id" \
                    python3 "$COMMANDS_PY" incident_escalate
                ;;
            list)
                shift 2
                op_id=""
                status=""
                include_closed=""
                json_mode=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        -o|--op)         op_id="${2:-}"; shift 2 ;;
                        --status)        status="${2:-}"; shift 2 ;;
                        --include-closed) include_closed="1"; shift ;;
                        --json)          json_mode="1"; shift ;;
                        *) shift ;;
                    esac
                done
                BEACON_OPERATION_ID="$op_id" BEACON_INCIDENT_STATUS="$status" \
                    BEACON_INCLUDE_CLOSED="$include_closed" BEACON_JSON="$json_mode" \
                    python3 "$COMMANDS_PY" incident_list
                ;;
            *)
                echo "Usage: beacon incident open \"<title>\" -o <op-id> [--desc \"...\"]"
                echo "       beacon incident close <id> --resolution \"...\""
                echo "       beacon incident escalate <id> -m <ms-id>"
                echo "       beacon incident list [-o <op-id>] [--status open|closed] [--include-closed] [--json]"
                ;;
        esac
        ;;
    session)
        ensure_project
        case "${2:-}" in
            end)
                shift 2
                _se_summary=""
                _se_session_id=""
                _se_json=""
                _se_bus_origin=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --summary)    _se_summary="${2:-}"; shift 2 ;;
                        --session-id) _se_session_id="${2:-}"; shift 2 ;;
                        --json)       _se_json="1"; shift ;;
                        --bus-origin) _se_bus_origin="1"; shift ;;
                        *) shift ;;
                    esac
                done
                BEACON_SUMMARY="$_se_summary" BEACON_SESSION_ID="$_se_session_id" \
                    BEACON_JSON="$_se_json" BEACON_BUS_ORIGIN="$_se_bus_origin" \
                    python3 "$COMMANDS_PY" session_end
                ;;
            rescue)
                shift 2
                _sr_json=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --json) _sr_json="1"; shift ;;
                        *) shift ;;
                    esac
                done
                BEACON_JSON="$_sr_json" python3 "$COMMANDS_PY" session_rescue
                ;;
            log)
                case "${3:-}" in
                    list|ls)
                        shift 3
                        _sl_limit="0"
                        _sl_json=""
                        while [[ $# -gt 0 ]]; do
                            case "$1" in
                                --limit) _sl_limit="${2:-0}"; shift 2 ;;
                                --json)  _sl_json="1"; shift ;;
                                *) shift ;;
                            esac
                        done
                        BEACON_LIMIT="$_sl_limit" BEACON_JSON="$_sl_json" \
                            python3 "$COMMANDS_PY" session_log_list
                        ;;
                    show|get)
                        shift 3
                        _ss_id=""
                        _ss_json=""
                        while [[ $# -gt 0 ]]; do
                            case "$1" in
                                --json) _ss_json="1"; shift ;;
                                *) _ss_id="$1"; shift ;;
                            esac
                        done
                        BEACON_SESSION_ID="$_ss_id" BEACON_JSON="$_ss_json" \
                            python3 "$COMMANDS_PY" session_log_show
                        ;;
                    *)
                        echo "Usage: beacon session log [list|show]"
                        ;;
                esac
                ;;
            id)
                # ms-54 e-1150 / e-1152: print the current session_id, minting
                # and persisting .beacon/session.json as a side effect. Used by
                # channel/bus.mjs at startup and /beacon-session-start Skill
                # for explicit heartbeat.
                python3 "$COMMANDS_PY" session_id
                ;;
            focus)
                # ms-54 / e-1369 Layer 4: AI-authored intent.
                shift 2
                _sf_text=""
                _sf_clear=""
                _sf_show=""
                _sf_json=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --clear) _sf_clear="1"; shift ;;
                        --show)  _sf_show="1";  shift ;;
                        --json)  _sf_json="1";  shift ;;
                        *)
                            if [[ -z "$_sf_text" && "${1:0:1}" != "-" ]]; then
                                _sf_text="$1"
                            fi
                            shift ;;
                    esac
                done
                BEACON_SESSION_FOCUS_TEXT="$_sf_text" \
                    BEACON_SESSION_FOCUS_CLEAR="$_sf_clear" \
                    BEACON_SESSION_FOCUS_SHOW="$_sf_show" \
                    BEACON_JSON="$_sf_json" \
                    python3 "$COMMANDS_PY" session_focus
                ;;
            attention)
                # ms-54 / e-1369 Layer 4: AI signals "human input required".
                shift 2
                _sa_set=""
                _sa_json=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --set)  _sa_set="${2:-}"; shift 2 ;;
                        --json) _sa_json="1";     shift ;;
                        *)      shift ;;
                    esac
                done
                BEACON_SESSION_ATTENTION_SET="$_sa_set" \
                    BEACON_JSON="$_sa_json" \
                    python3 "$COMMANDS_PY" session_attention
                ;;
            fork)
                # ms-67 / e-1549: create a sibling worktree + bclaude-ready
                # workspace for parallel work on a target milestone.
                # ms-67 / e-1553: `fork list` sub-sub-command to enumerate
                # active forks (used by /beacon-session-merge-back picker).
                shift 2
                if [[ "${1:-}" == "list" ]]; then
                    shift
                    _sfl_json=""
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --json) _sfl_json="1"; shift ;;
                            *) shift ;;
                        esac
                    done
                    BEACON_JSON="$_sfl_json" \
                        python3 "$COMMANDS_PY" session_fork_list
                else
                    _sfork_ms_id=""
                    _sfork_json=""
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --json) _sfork_json="1"; shift ;;
                            ms-*)
                                if [[ -z "$_sfork_ms_id" ]]; then
                                    _sfork_ms_id="$1"
                                fi
                                shift ;;
                            *) shift ;;
                        esac
                    done
                    BEACON_SESSION_FORK_MS_ID="$_sfork_ms_id" \
                        BEACON_JSON="$_sfork_json" \
                        python3 "$COMMANDS_PY" session_fork
                fi
                ;;
            "")
                echo "Usage: beacon session end [--summary <text>] [--session-id <id>] [--json] [--bus-origin]"
                echo "       beacon session rescue [--json]"
                echo "       beacon session log list [--limit N] [--json]"
                echo "       beacon session log show <session-id> [--json]"
                echo "       beacon session id"
                echo "       beacon session focus \"<text>\" | --clear | --show [--json]"
                echo "       beacon session attention --set true|false [--json]"
                echo "       beacon session fork <ms-id> [--json]"
                echo "       beacon session fork list [--json]"
                echo "  --bus-origin: refuse the write (persistence poisoning defense, ms-54 / e-1293)"
                ;;
            *)
                echo "Unknown session subcommand: ${2:-}"
                echo "Usage: beacon session [end|rescue|log|id|focus|attention|fork]"
                ;;
        esac
        ;;
    profile)
        # ms-64 / e-1461: enumerate Beacon profiles under ~/.beacon/profiles/.
        # cwd-independent: profiles live in the user home, not the project.
        shift || true
        _prof_sub="${1:-list}"
        _prof_json=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                list)     shift ;;
                --json)   _prof_json="1"; shift ;;
                -h|--help)
                    cat <<'EOF'
Usage: beacon profile list [--json]

List Beacon profiles registered under ~/.beacon/profiles/. The active profile
(per --profile / BEACON_PROFILE / cwd cloud.json) is marked with `*`. Each row
also shows whether credentials.json is present and the resolved api_url.
EOF
                    exit 0
                    ;;
                *) shift ;;
            esac
        done
        case "$_prof_sub" in
            list|"")
                BEACON_JSON="$_prof_json" python3 "$COMMANDS_PY" profile_list
                ;;
            *)
                echo "Unknown profile subcommand: $_prof_sub"
                echo "Usage: beacon profile list [--json]"
                exit 2
                ;;
        esac
        ;;
    sessions)
        # ms-54 / e-1587: cross-project session directory. Cwd-independent —
        # no ensure_project here, the API resolves the calling user across
        # all their project memberships.
        shift || true
        _ses_live=""
        _ses_healthy=""
        _ses_since_min="5"
        _ses_machine=""
        _ses_agent=""
        _ses_json=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                list)         shift ;;
                --live)       _ses_live="1"; shift ;;
                --healthy)    _ses_healthy="1"; shift ;;
                --since-min)  _ses_since_min="${2:-5}"; shift 2 ;;
                --machine)    _ses_machine="${2:-}"; shift 2 ;;
                --agent)      _ses_agent="${2:-}"; shift 2 ;;
                --json)       _ses_json="1"; shift ;;
                -h|--help)
                    cat <<'EOF'
Usage: beacon sessions [list] [--live] [--healthy] [--since-min <N>] [--machine <name>] [--agent <name>] [--json]

Cross-project session directory. Lists the calling user's bclaude sessions
across ALL projects they own or are a member of. Use this when you need
"who is live anywhere right now" — e.g. picking a DM recipient in another
project (/beacon-dm-send), or diagnosing a heartbeat-stop incident
(e-1579-style) without cd-ing through each project.

For "who in this project is live" use `beacon bus directory --live` instead.
EOF
                    exit 0
                    ;;
                *) shift ;;
            esac
        done
        BEACON_SESSIONS_LIVE="$_ses_live" \
            BEACON_SESSIONS_HEALTHY="$_ses_healthy" \
            BEACON_SESSIONS_SINCE_MIN="$_ses_since_min" \
            BEACON_SESSIONS_MACHINE="$_ses_machine" \
            BEACON_SESSIONS_AGENT="$_ses_agent" \
            BEACON_JSON="$_ses_json" \
            python3 "$COMMANDS_PY" sessions_list
        ;;
    note)
        ensure_project
        case "${2:-}" in
            list)
                BEACON_JSON="${3:+1}" python3 "$COMMANDS_PY" note_list
                ;;
            clear)
                python3 "$COMMANDS_PY" note_clear
                ;;
            "")
                echo "Usage: beacon note \"<text>\" [--context \"<label>\"]"
                echo "       beacon note list [--json]"
                echo "       beacon note clear"
                ;;
            *)
                shift
                note_text=""
                note_context=""
                note_bus_origin=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --context)    note_context="${2:-}"; shift 2 ;;
                        --bus-origin) note_bus_origin="1"; shift ;;
                        *) [[ -z "$note_text" ]] && note_text="$1"; shift ;;
                    esac
                done
                BEACON_NOTE_TEXT="$note_text" BEACON_NOTE_CONTEXT="$note_context" \
                    BEACON_BUS_ORIGIN="$note_bus_origin" \
                    python3 "$COMMANDS_PY" note_add
                ;;
        esac
        ;;
    stop)
        # ms-55 e-1646: Andon-cord-style halt protocol.
        # `beacon stop scoped --target <kind>:<id>` halts a specific MS / task
        # / session; `beacon stop global` halts the whole project.
        # SPEC §2: anyone can broadcast (no envelope-tier gate here).
        ensure_project
        _stop_sub="${2:-}"
        shift 2 || true
        _stop_target=""
        _stop_reason=""
        _stop_reason_kind=""
        _stop_machine_reason=""
        _stop_json=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --target)         _stop_target="${2:-}"; shift 2 ;;
                --reason)         _stop_reason="${2:-}"; shift 2 ;;
                --reason-kind)    _stop_reason_kind="${2:-}"; shift 2 ;;
                --machine-reason) _stop_machine_reason="${2:-}"; shift 2 ;;
                --json)           _stop_json="1"; shift ;;
                *) shift ;;
            esac
        done
        # --target is "kind:id" (e.g. "ms:ms-55") — split into env vars so the
        # Python CLI can validate each piece independently.
        _stop_target_kind=""
        _stop_target_id=""
        if [[ -n "$_stop_target" ]]; then
            _stop_target_kind="${_stop_target%%:*}"
            _stop_target_id="${_stop_target#*:}"
            # If no colon was present the substitutions both yield the whole
            # string — guard against that so a bare `--target ms-55` doesn't
            # silently encode kind="ms-55" id="ms-55".
            if [[ "$_stop_target_kind" == "$_stop_target_id" && "$_stop_target" != *:* ]]; then
                echo "Error: --target must be <kind>:<id> (e.g. ms:ms-55)" >&2
                exit 1
            fi
        fi
        case "$_stop_sub" in
            scoped)
                BEACON_STOP_TARGET_KIND="$_stop_target_kind" \
                    BEACON_STOP_TARGET_ID="$_stop_target_id" \
                    BEACON_STOP_REASON="$_stop_reason" \
                    BEACON_STOP_REASON_KIND="$_stop_reason_kind" \
                    BEACON_STOP_MACHINE_REASON="$_stop_machine_reason" \
                    BEACON_JSON="$_stop_json" \
                    python3 "$COMMANDS_PY" stop_scoped
                ;;
            global)
                BEACON_STOP_REASON="$_stop_reason" \
                    BEACON_STOP_REASON_KIND="$_stop_reason_kind" \
                    BEACON_STOP_MACHINE_REASON="$_stop_machine_reason" \
                    BEACON_JSON="$_stop_json" \
                    python3 "$COMMANDS_PY" stop_global
                ;;
            status)
                BEACON_JSON="$_stop_json" python3 "$COMMANDS_PY" stop_status
                ;;
            "")
                cat <<'EOF'
Usage: beacon stop scoped --target <kind>:<id> [--reason "..."] [--reason-kind X] [--machine-reason '<json>'] [--json]
       beacon stop global [--reason "..."] [--reason-kind X] [--machine-reason '<json>'] [--json]
       beacon stop status [--json]

target kind: ms | task | session
reason-kind: manual | build_fail | deploy_fail | test_fail | approved_actions_violation | stuck | other

Examples:
  beacon stop scoped --target ms:ms-55 --reason "build fail 3 retries" --reason-kind build_fail
  beacon stop global --reason "hostile prompt detected" --reason-kind approved_actions_violation
  beacon stop status                # list active stop signals
EOF
                ;;
            *)
                echo "Error: unknown subcommand 'beacon stop $_stop_sub'" >&2
                echo "Try 'beacon stop' for usage." >&2
                exit 1
                ;;
        esac
        ;;
    rollback)
        # ms-55 e-1647: SPEC §4 safe-boundary rollback. Working tree edits +
        # un-pushed commits are auto-undone; anything past upstream is
        # surfaced as a "report + compensation proposal" instead of being
        # silently destroyed.
        ensure_project
        shift
        _rb_commits=""
        _rb_reason=""
        _rb_dry_run=""
        _rb_json=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --commits) _rb_commits="${2:-0}"; shift 2 ;;
                --reason)  _rb_reason="${2:-}"; shift 2 ;;
                --dry-run) _rb_dry_run="1"; shift ;;
                --json)    _rb_json="1"; shift ;;
                -h|--help)
                    cat <<'EOF'
Usage: beacon rollback [--commits N] [--reason "..."] [--dry-run] [--json]

Inspect the local git state and roll back the safe portion:
  • Dirty working tree → `git stash push -u` (preserved, recoverable via `git stash`)
  • Un-pushed local commits → `git reset --soft HEAD~N` (changes stay staged)

Anything past your branch's upstream (= already pushed / merged / deployed)
is NOT touched. Instead the report lists concrete compensation proposals
(open a revert PR, etc.) so a human can decide.

Flags:
  --commits N    Number of HEAD commits to undo. 0 (default) means
                 "auto-decide": when an upstream is configured, undo
                 everything ahead of upstream (capped). Without
                 upstream, default is 0 — pass --commits explicitly.
  --reason TEXT  Free-text reason. Recorded into the stash message and
                 the printed report.
  --dry-run      Print the plan, do not execute.
  --json         Machine-readable plan + result.
EOF
                    exit 0
                    ;;
                *) shift ;;
            esac
        done
        BEACON_ROLLBACK_COMMITS="${_rb_commits:-0}" \
            BEACON_ROLLBACK_REASON="$_rb_reason" \
            BEACON_ROLLBACK_DRY_RUN="$_rb_dry_run" \
            BEACON_JSON="$_rb_json" \
            python3 "$COMMANDS_PY" rollback
        ;;
    resume)
        # ms-55 e-1646: clear a previously-broadcast stop signal.
        # Resume itself is also unrestricted at this layer — a workflow that
        # wants leader-only resume can layer a hook on the receive side.
        ensure_project
        _res_sub="${2:-}"
        shift 2 || true
        _res_target=""
        _res_reason=""
        _res_json=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --target) _res_target="${2:-}"; shift 2 ;;
                --reason) _res_reason="${2:-}"; shift 2 ;;
                --json)   _res_json="1"; shift ;;
                *) shift ;;
            esac
        done
        _res_target_kind=""
        _res_target_id=""
        if [[ -n "$_res_target" ]]; then
            _res_target_kind="${_res_target%%:*}"
            _res_target_id="${_res_target#*:}"
            if [[ "$_res_target_kind" == "$_res_target_id" && "$_res_target" != *:* ]]; then
                echo "Error: --target must be <kind>:<id>" >&2
                exit 1
            fi
        fi
        case "$_res_sub" in
            scoped)
                BEACON_STOP_TARGET_KIND="$_res_target_kind" \
                    BEACON_STOP_TARGET_ID="$_res_target_id" \
                    BEACON_STOP_REASON="$_res_reason" \
                    BEACON_JSON="$_res_json" \
                    python3 "$COMMANDS_PY" resume_scoped
                ;;
            global)
                BEACON_STOP_REASON="$_res_reason" \
                    BEACON_JSON="$_res_json" \
                    python3 "$COMMANDS_PY" resume_global
                ;;
            "")
                cat <<'EOF'
Usage: beacon resume scoped --target <kind>:<id> [--reason "..."] [--json]
       beacon resume global [--reason "..."] [--json]

Clears a previously-issued stop signal of matching scope/target.
See `beacon stop status` for the currently active stops.
EOF
                ;;
            *)
                echo "Error: unknown subcommand 'beacon resume $_res_sub'" >&2
                exit 1
                ;;
        esac
        ;;
    morning)
        # ms-55 e-1650: 4-category briefing of recent autonomous activity.
        # Reads stop-signal + claim-signal channels (or a JSON dump for
        # offline / testing) and renders 完了 / 停止 / skip / 介入要望.
        ensure_project
        shift
        _morning_since=""
        _morning_file=""
        _morning_json=""
        _morning_no_doc=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --since-hours) _morning_since="${2:-}"; shift 2 ;;
                --events-file) _morning_file="${2:-}"; shift 2 ;;
                --json)        _morning_json="1"; shift ;;
                --no-doc)      _morning_no_doc="1"; shift ;;
                -h|--help)
                    cat <<'EOF'
Usage: beacon morning [--since-hours N] [--events-file <path>] [--json] [--no-doc]

Read recent activity on the stop-signal + claim-signal channels and
render a 4-bucket morning briefing:

  ✓ 完了 (Completed):      claim released with outcome=completed
  ⚠ 停止 (Halted):         stop signals (manual / build_fail / etc.)
  ✗ Skip:                  claim released with outcome=abandoned
  ⏱ 介入要望 (Needs hand): STUCK signals (= idle > timeout)

Flags:
  --since-hours N       window length, default 12
  --events-file PATH    skip the bus query and read events from a JSON
                        array file (= replay / offline / dogfood mode)
  --json                machine-readable output
  --no-doc              do not persist the briefing as a `report` doc
                        (default: save so it shows up in Web UI)
EOF
                    exit 0
                    ;;
                *) shift ;;
            esac
        done
        BEACON_MORNING_SINCE_HOURS="${_morning_since:-12}" \
            BEACON_MORNING_EVENTS_FILE="$_morning_file" \
            BEACON_JSON="$_morning_json" \
            BEACON_MORNING_NO_DOC="$_morning_no_doc" \
            python3 "$COMMANDS_PY" morning
        ;;
    stuck)
        # ms-55 e-1649: STUCK detector. Read session telemetry, identify
        # rows past the idle timeout, emit stop signals with
        # reason_kind="stuck" so the morning briefing can categorize
        # them as "intervention needed".
        ensure_project
        _stuck_sub="${2:-}"
        shift 2 || true
        _stuck_inline=""
        _stuck_file=""
        _stuck_timeout=""
        _stuck_dry_run=""
        _stuck_json=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --telemetry-inline) _stuck_inline="${2:-}"; shift 2 ;;
                --telemetry-file)   _stuck_file="${2:-}"; shift 2 ;;
                --timeout-minutes)  _stuck_timeout="${2:-}"; shift 2 ;;
                --dry-run)          _stuck_dry_run="1"; shift ;;
                --json)             _stuck_json="1"; shift ;;
                *) shift ;;
            esac
        done
        case "$_stuck_sub" in
            check)
                BEACON_STUCK_TELEMETRY_INLINE="$_stuck_inline" \
                    BEACON_STUCK_TELEMETRY_FILE="$_stuck_file" \
                    BEACON_STUCK_TIMEOUT_MINUTES="${_stuck_timeout:-30}" \
                    BEACON_STUCK_DRY_RUN="$_stuck_dry_run" \
                    BEACON_JSON="$_stuck_json" \
                    python3 "$COMMANDS_PY" stuck_check
                ;;
            "")
                cat <<'EOF'
Usage: beacon stuck check (--telemetry-inline '<json>' | --telemetry-file <path>)
                          [--timeout-minutes N] [--dry-run] [--json]

Read session telemetry from a JSON array and emit STUCK signals for
sessions whose last_active is older than --timeout-minutes (default 30).

Each telemetry record needs at least:
  { "session_id": "sv-...", "last_active": "2026-06-15T11:00:00Z" }

Optional fields:
  - "ms_id" / "task_id": included in the emitted signal's machine_reason
  - "ignore": true → skip this row from detection

STUCK signals are stop-signal channel events with reason_kind="stuck".
They are processed by the same receivers as any other stop signal —
this is the same protocol, not a new one.

Examples:
  beacon stuck check --telemetry-file telemetry.json --timeout-minutes 20
  beacon stuck check --telemetry-inline '[{"session_id":"sv-A","last_active":"..."}]' --dry-run
EOF
                ;;
            *)
                echo "Error: unknown subcommand 'beacon stuck $_stuck_sub'" >&2
                exit 1
                ;;
        esac
        ;;
    claim)
        # ms-55 e-1648: claim primitives. request / handoff need a
        # recipient (--to); plain claim is broadcast. respond / release /
        # list round out the lifecycle. Local persistence keeps the
        # issuer's view across session restarts.
        ensure_project
        _claim_sub="${2:-}"
        shift 2 || true
        _claim_id_positional=""
        # respond + release take a positional claim_id as the first arg.
        if [[ "$_claim_sub" == "respond" || "$_claim_sub" == "release" ]]; then
            if [[ -n "${1:-}" && "${1:0:1}" != "-" ]]; then
                _claim_id_positional="${1:-}"
                shift || true
            fi
        fi
        _claim_target=""
        _claim_intent=""
        _claim_to=""
        _claim_expires=""
        _claim_decision=""
        _claim_reason=""
        _claim_outcome=""
        _claim_mine=""
        _claim_json=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --target)  _claim_target="${2:-}"; shift 2 ;;
                --intent)  _claim_intent="${2:-}"; shift 2 ;;
                --to)      _claim_to="${2:-}"; shift 2 ;;
                --expires-at) _claim_expires="${2:-}"; shift 2 ;;
                --accept)  _claim_decision="accept"; shift ;;
                --decline) _claim_decision="decline"; shift ;;
                --reason)  _claim_reason="${2:-}"; shift 2 ;;
                --outcome) _claim_outcome="${2:-}"; shift 2 ;;
                --mine)    _claim_mine="1"; shift ;;
                --json)    _claim_json="1"; shift ;;
                *) shift ;;
            esac
        done
        # Split --target kind:id.
        _claim_tk=""
        _claim_ti=""
        if [[ -n "$_claim_target" ]]; then
            _claim_tk="${_claim_target%%:*}"
            _claim_ti="${_claim_target#*:}"
            if [[ "$_claim_tk" == "$_claim_ti" && "$_claim_target" != *:* ]]; then
                echo "Error: --target must be <kind>:<id> (e.g. task:e-1648)" >&2
                exit 1
            fi
        fi
        case "$_claim_sub" in
            request|handoff|post)
                # `post` maps to the broadcast `claim` kind on the Python side.
                _claim_py="claim_$_claim_sub"
                BEACON_CLAIM_TARGET_KIND="$_claim_tk" \
                    BEACON_CLAIM_TARGET_ID="$_claim_ti" \
                    BEACON_CLAIM_INTENT="$_claim_intent" \
                    BEACON_CLAIM_TO="$_claim_to" \
                    BEACON_CLAIM_EXPIRES_AT="$_claim_expires" \
                    BEACON_JSON="$_claim_json" \
                    python3 "$COMMANDS_PY" "$_claim_py"
                ;;
            respond)
                if [[ -z "$_claim_id_positional" ]]; then
                    echo "Error: beacon claim respond <claim_id> [--accept|--decline] [--reason ...]" >&2
                    exit 1
                fi
                BEACON_CLAIM_ID="$_claim_id_positional" \
                    BEACON_CLAIM_DECISION="$_claim_decision" \
                    BEACON_CLAIM_REASON="$_claim_reason" \
                    BEACON_JSON="$_claim_json" \
                    python3 "$COMMANDS_PY" claim_respond
                ;;
            release)
                if [[ -z "$_claim_id_positional" ]]; then
                    echo "Error: beacon claim release <claim_id> [--outcome completed|abandoned] [--reason ...]" >&2
                    exit 1
                fi
                BEACON_CLAIM_ID="$_claim_id_positional" \
                    BEACON_CLAIM_OUTCOME="$_claim_outcome" \
                    BEACON_CLAIM_REASON="$_claim_reason" \
                    BEACON_JSON="$_claim_json" \
                    python3 "$COMMANDS_PY" claim_release
                ;;
            list)
                BEACON_CLAIM_MINE="$_claim_mine" \
                    BEACON_CLAIM_TARGET_KIND="$_claim_tk" \
                    BEACON_CLAIM_TARGET_ID="$_claim_ti" \
                    BEACON_JSON="$_claim_json" \
                    python3 "$COMMANDS_PY" claim_list
                ;;
            "")
                cat <<'EOF'
Usage:
  beacon claim post     --target <kind>:<id> [--intent "..."] [--json]
                                    Broadcast a claim (= "I'm taking X").
                                    First-publisher-wins; no consent needed.
  beacon claim request  --target <kind>:<id> --to <sid> [--intent "..."]
                                    Ask a specific session to take X.
                                    Recipient must accept.
  beacon claim handoff  --target <kind>:<id> --to <sid> [--intent "..."]
                                    Transfer in-progress X to a specific
                                    session. Recipient must accept.
  beacon claim respond  <claim_id> [--accept|--decline] [--reason "..."]
                                    Reply to a pending request / handoff.
  beacon claim release  <claim_id> [--outcome completed|abandoned] [--reason "..."]
                                    Mark a claim as done so others can take it.
  beacon claim list     [--mine] [--target <kind>:<id>] [--json]
                                    List active claims in the local cache.
                                    Use --mine after session restart to
                                    recover what you were in the middle of.

target kind: ms | task | operation | trek | free
EOF
                ;;
            *)
                echo "Error: unknown subcommand 'beacon claim $_claim_sub'" >&2
                echo "Try 'beacon claim' for usage." >&2
                exit 1
                ;;
        esac
        ;;
    bus)
        ensure_project
        _bus_sub="${2:-}"
        shift 2 || true
        # `budget` has a 2nd-level subcommand (grant/show/clear) — extract it
        # before the generic arg-parsing loop eats it as an unknown positional.
        _bud_sub=""
        if [[ "$_bus_sub" == "budget" ]]; then
            _bud_sub="${1:-}"
            shift || true
        fi
        # `auto-execute` mirrors the budget shape: <add|remove|list> as a
        # 2nd-level subcommand. Extracted up front so --channel still flows
        # through the generic arg-parsing loop.
        _ae_sub=""
        if [[ "$_bus_sub" == "auto-execute" ]]; then
            _ae_sub="${1:-}"
            shift || true
        fi
        # ms-54 / e-1348: `status <event_id>` takes a single positional arg.
        # Extract it up front so the generic flag loop below doesn't drop it.
        _bus_event_id=""
        if [[ "$_bus_sub" == "status" && -n "${1:-}" && "${1:0:1}" != "-" ]]; then
            _bus_event_id="${1:-}"
            shift || true
        fi
        _bus_channel=""
        _bus_payload=""
        _bus_sender=""
        _bus_recipient=""
        _bus_delivery=""
        _bus_interval=""
        _bus_timeout=""
        _bus_last_seen=""
        _bus_ack_event_id=""
        _bus_once=""
        _bus_auto_ack=""
        _bus_json=""
        _bus_user=""
        _bus_machine=""
        _bus_agent=""
        _bus_live=""
        _bus_healthy=""
        _bus_since_min=""
        _bud_turns=""
        _bus_in_reply_to=""
        _bus_project_id=""
        _bus_to=""
        _bus_action=""          # e-1290: comma-joined actions_authorized for T1 envelope
        _bus_no_envelope=""     # e-1290: opt-out of envelope path (debug legacy)
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --channel)        _bus_channel="${2:-}"; shift 2 ;;
                --payload)        _bus_payload="${2:-}"; shift 2 ;;
                --sender)         _bus_sender="${2:-}"; shift 2 ;;
                --recipient)      _bus_recipient="${2:-}"; shift 2 ;;
                --to)             _bus_to="${2:-}"; shift 2 ;;
                --delivery)       _bus_delivery="${2:-}"; shift 2 ;;
                --interval)       _bus_interval="${2:-}"; shift 2 ;;
                --timeout)        _bus_timeout="${2:-}"; shift 2 ;;
                --last-seen-at)   _bus_last_seen="${2:-}"; shift 2 ;;
                # e-1423 (ms-54, Bug 4 第 2 層): ack a specific event_id;
                # the server resolves its created_at and advances the cursor
                # past it. Used by /beacon-operation-execute as a forcing
                # function so Skill completion structurally clears the
                # triggering event from the next inbox-hook inject.
                --event)          _bus_ack_event_id="${2:-}"; shift 2 ;;
                --once)           _bus_once="1"; shift ;;
                --auto-ack)       _bus_auto_ack="1"; shift ;;
                --json)           _bus_json="1"; shift ;;
                --user)           _bus_user="${2:-}"; shift 2 ;;
                --machine)        _bus_machine="${2:-}"; shift 2 ;;
                --agent)          _bus_agent="${2:-}"; shift 2 ;;
                --live)           _bus_live="1"; shift ;;
                --healthy)        _bus_healthy="1"; shift ;;
                --since-min)      _bus_since_min="${2:-}"; shift 2 ;;
                --turns|-n)       _bud_turns="${2:-}"; shift 2 ;;
                --in-reply-to)    _bus_in_reply_to="${2:-}"; shift 2 ;;
                --project)        _bus_project_id="${2:-}"; shift 2 ;;
                # e-1290: --action <name> may repeat; collected as
                # comma-joined string then split back in commands.py. Wildcards
                # are rejected server-side at envelope/issue time.
                --action)
                    if [[ -n "$_bus_action" ]]; then
                        _bus_action="${_bus_action},${2:-}"
                    else
                        _bus_action="${2:-}"
                    fi
                    shift 2 ;;
                --no-envelope)    _bus_no_envelope="1"; shift ;;
                *)                shift ;;
            esac
        done
        case "$_bus_sub" in
            send)
                BEACON_BUS_CHANNEL="$_bus_channel" \
                    BEACON_BUS_PAYLOAD="$_bus_payload" \
                    BEACON_BUS_SENDER="$_bus_sender" \
                    BEACON_BUS_RECIPIENT_SESSION="$_bus_to" \
                    BEACON_BUS_DELIVERY="$_bus_delivery" \
                    BEACON_BUS_IN_REPLY_TO="$_bus_in_reply_to" \
                    BEACON_BUS_PROJECT_ID="$_bus_project_id" \
                    BEACON_BUS_ACTION="$_bus_action" \
                    BEACON_BUS_NO_ENVELOPE="$_bus_no_envelope" \
                    BEACON_JSON="$_bus_json" \
                    python3 "$COMMANDS_PY" bus_send
                ;;
            listen)
                BEACON_BUS_RECIPIENT="$_bus_recipient" \
                    BEACON_BUS_CHANNEL="$_bus_channel" \
                    BEACON_BUS_INTERVAL="$_bus_interval" \
                    BEACON_BUS_AUTO_ACK="$_bus_auto_ack" \
                    BEACON_BUS_ONCE="$_bus_once" \
                    BEACON_BUS_PROJECT_ID="$_bus_project_id" \
                    python3 "$COMMANDS_PY" bus_listen
                ;;
            receive)
                BEACON_BUS_RECIPIENT="$_bus_recipient" \
                    BEACON_BUS_CHANNEL="$_bus_channel" \
                    BEACON_BUS_INTERVAL="$_bus_interval" \
                    BEACON_BUS_TIMEOUT="$_bus_timeout" \
                    BEACON_BUS_AUTO_ACK="$_bus_auto_ack" \
                    BEACON_BUS_PROJECT_ID="$_bus_project_id" \
                    python3 "$COMMANDS_PY" bus_receive
                ;;
            ack)
                BEACON_BUS_RECIPIENT="$_bus_recipient" \
                    BEACON_BUS_LAST_SEEN_AT="$_bus_last_seen" \
                    BEACON_BUS_ACK_EVENT_ID="$_bus_ack_event_id" \
                    BEACON_BUS_PROJECT_ID="$_bus_project_id" \
                    BEACON_JSON="$_bus_json" \
                    python3 "$COMMANDS_PY" bus_ack
                ;;
            status)
                # ms-54 / e-1348: 3-stage receipt view (sent / delivered / opened).
                BEACON_BUS_EVENT_ID="$_bus_event_id" \
                    BEACON_BUS_PROJECT_ID="$_bus_project_id" \
                    BEACON_JSON="$_bus_json" \
                    python3 "$COMMANDS_PY" bus_status
                ;;
            directory|dir)
                BEACON_DIR_USER="$_bus_user" \
                    BEACON_DIR_MACHINE="$_bus_machine" \
                    BEACON_DIR_AGENT="$_bus_agent" \
                    BEACON_DIR_LIVE="$_bus_live" \
                    BEACON_DIR_HEALTHY="$_bus_healthy" \
                    BEACON_DIR_SINCE_MIN="$_bus_since_min" \
                    BEACON_BUS_PROJECT_ID="$_bus_project_id" \
                    BEACON_JSON="$_bus_json" \
                    python3 "$COMMANDS_PY" bus_directory
                ;;
            budget)
                case "$_bud_sub" in
                    grant)
                        BEACON_BUS_BUDGET_N="$_bud_turns" \
                            BEACON_JSON="$_bus_json" \
                            python3 "$COMMANDS_PY" bus_budget_grant
                        ;;
                    show)
                        BEACON_JSON="$_bus_json" \
                            python3 "$COMMANDS_PY" bus_budget_show
                        ;;
                    clear)
                        python3 "$COMMANDS_PY" bus_budget_clear
                        ;;
                    *)
                        cat <<'EOF'
Usage: beacon bus budget grant --turns <N> [--json]
       beacon bus budget show [--json]
       beacon bus budget clear
EOF
                        ;;
                esac
                ;;
            auto-execute)
                case "$_ae_sub" in
                    add)
                        BEACON_BUS_AUTO_EXEC_CHANNEL="$_bus_channel" \
                            BEACON_JSON="$_bus_json" \
                            python3 "$COMMANDS_PY" bus_auto_execute_add
                        ;;
                    remove)
                        BEACON_BUS_AUTO_EXEC_CHANNEL="$_bus_channel" \
                            BEACON_JSON="$_bus_json" \
                            python3 "$COMMANDS_PY" bus_auto_execute_remove
                        ;;
                    list)
                        BEACON_JSON="$_bus_json" \
                            python3 "$COMMANDS_PY" bus_auto_execute_list
                        ;;
                    *)
                        cat <<'EOF'
Usage: beacon bus auto-execute add --channel <name> [--json]
       beacon bus auto-execute remove --channel <name> [--json]
       beacon bus auto-execute list [--json]

Default: empty allowlist. Every incoming auto-execute event is downgraded
to propose-to-ai until you explicitly add its channel.
EOF
                        ;;
                esac
                ;;
            *)
                cat <<'EOF'
Usage: beacon bus send         --channel <ch> [--to <session_id>] [--payload '<json>'] [--sender <id>] [--delivery <mode>] [--in-reply-to <event_id>] [--action <name>]... [--no-envelope] [--project <id>]
       beacon bus listen       [--recipient <id>] [--channel <ch>] [--interval <sec>] [--auto-ack] [--once] [--project <id>]
       beacon bus receive      [--recipient <id>] [--channel <ch>] [--timeout <sec>] [--auto-ack] [--project <id>]
       beacon bus ack          [--recipient <id>] (--last-seen-at <iso8601> | --event <event_id>) [--project <id>]
       beacon bus status       <event_id> [--project <id>] [--json]
       beacon bus directory    [--user <email>] [--machine <name>] [--agent <name>] [--live] [--healthy] [--since-min <N>] [--project <id>] [--json]
       beacon bus budget       grant --turns <N>  |  show  |  clear
       beacon bus auto-execute add --channel <name>  |  remove --channel <name>  |  list

delivery: auto-execute | propose-to-ai (default) | notify-user-only
--to:          (send) stamp payload.recipient_session_id for 1:1 unicast (e-1209).
               Required for channel=dm; without it the server drops the event
               rather than broadcasting to every dm-subscribed session.
               (e-1402) directory に live+healthy で見えない sid を渡すと stderr に
               警告 (soft-warn、送信は続行)。BEACON_BUS_NO_LIVE_CHECK=1 で抑制。
--in-reply-to: mark as AI-authored reply. Requires `bus budget grant N` first.
               Without it, sends bypass the budget gate (manual mode).
               The same gate applies via the MCP reply tool (channel/bus.mjs).
--project:     override the cwd's project_id (e-1151) for cross-project DM/directory.
               Auth + API URL still come from the current project; only the
               target project_id in the API call changes.
--action:      (send, repeatable) action name the receiver should be authorized
               to auto-execute on the signed T1 envelope. Wildcards / regex
               are rejected server-side; enumerate. High-risk actions
               (deploy, project.delete, ...) require T1 = human signature,
               which CLI sends are.
--no-envelope: (send) skip the envelope/issue → /bus round-trip and post on
               the legacy path directly. Useful for debugging the server's
               backward-compat lane. Envelope is on by default (e-1290).
auto-execute:  receiver-side opt-in allowlist. Default empty ⇒ all auto-execute
               events get downgraded to propose-to-ai by the inbox hook.
EOF
                ;;
        esac
        ;;
    retro)
        shift
        case "${1:-}" in
            done)
                python3 "$COMMANDS_PY" retro_done
                ;;
            save)
                shift
                _retro_week=""
                _retro_content=""
                _retro_json=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --week)    _retro_week="${2:-}"; shift 2 ;;
                        --content) _retro_content="${2:-}"; shift 2 ;;
                        --json)    _retro_json="1"; shift ;;
                        --stdin)   shift ;;
                        *) shift ;;
                    esac
                done
                if [ -z "$_retro_week" ]; then
                    echo "Usage: beacon retro save --week YYYY-WNN [--content text | --stdin] [--json]"
                    echo "  Content can be piped via stdin."
                    exit 1
                fi
                BEACON_RETRO_WEEK="$_retro_week" BEACON_CONTENT="$_retro_content" \
                    BEACON_JSON="$_retro_json" python3 "$COMMANDS_PY" retro_save
                ;;
            *)
                cmd_retro "$@"
                ;;
        esac
        ;;
    trigger)
        case "${2:-}" in
            fire)
                BEACON_TRIGGER_NAME="${3:-}" BEACON_TRIGGER_MESSAGE="${4:-}" \
                    python3 "$COMMANDS_PY" trigger_fire
                ;;
            check)
                python3 "$COMMANDS_PY" trigger_check
                ;;
            clear)
                BEACON_TRIGGER_NAME="${3:-}" python3 "$COMMANDS_PY" trigger_clear
                ;;
            *)
                echo "Usage: beacon trigger [fire|check|clear] <name> [message]"
                ;;
        esac
        ;;
    doc|document)
        shift
        cmd_doc "$@"
        ;;
    cloud)
        case "${2:-}" in
            push)
                ensure_project
                force=""
                [[ "${3:-}" == "--force" || "${3:-}" == "-f" ]] && force="1"
                BEACON_FORCE="$force" python3 "$COMMANDS_PY" cloud_push
                ;;
            pull)   ensure_project; python3 "$COMMANDS_PY" cloud_pull ;;
            join)
                if [ -z "${3:-}" ]; then
                    echo "Usage: beacon cloud join <project-id>"
                    exit 1
                fi
                BEACON_CLOUD_PROJECT_ID="${3}" python3 "$COMMANDS_PY" cloud_join
                ;;
            status) python3 "$COMMANDS_PY" cloud_status ;;
            list)   python3 "$COMMANDS_PY" cloud_list ;;
            off)
                # e-1861 (ms-61): "cloud off" is sandbox / verification-only now.
                # Beacon = cloud-only in normal operation (Claude Code requires
                # internet, so local mode has no production use case). This
                # subcommand stays available for testing and for users who
                # explicitly want to detach from cloud sync — but it requires
                # ``--confirm <project_id>`` to prevent silent / accidental
                # invocation by sub-agents (the same pattern that triggered the
                # 2026-06-15 data-loss panic incident).
                if [ ! -f .beacon/cloud.json ]; then
                    echo "Not in cloud mode (no .beacon/cloud.json found)."
                    exit 0
                fi
                expected_pid=$(python3 -c "import json; print(json.load(open('.beacon/cloud.json')).get('project_id',''))" 2>/dev/null)
                if [ -z "$expected_pid" ]; then
                    echo "Error: .beacon/cloud.json is malformed (no project_id)."
                    exit 1
                fi
                # parse --confirm flag
                given_pid=""
                if [ "${3:-}" = "--confirm" ] && [ -n "${4:-}" ]; then
                    given_pid="${4}"
                fi
                if [ -z "$given_pid" ] || [ "$given_pid" != "$expected_pid" ]; then
                    echo "Refusing to disable cloud sync without two-factor confirmation."
                    echo ""
                    echo "  Sandbox / verification only — Beacon assumes cloud mode in production."
                    echo "  To disable: beacon cloud off --confirm \"$expected_pid\""
                    echo ""
                    echo "  This guard exists because a 2026-06-15 incident (e-1776) saw a"
                    echo "  sub-agent silently flip cloud → local and trigger a data-loss panic."
                    exit 1
                fi
                # Move cloud.json into .beacon/.trash/ with timestamp (never rm).
                trash_dir=".beacon/.trash"
                mkdir -p "$trash_dir"
                ts=$(date +%Y%m%d-%H%M%S)
                mv .beacon/cloud.json "$trash_dir/cloud.json.disabled-$ts"
                echo "Cloud sync disabled for this directory."
                echo "  .beacon/cloud.json → $trash_dir/cloud.json.disabled-$ts"
                echo "  To re-enable: beacon cloud join $expected_pid  (or beacon cloud setup)"
                ;;
            open)
                if [ -z "${3:-}" ]; then
                    echo "Usage: beacon cloud open <project-id>"
                    exit 1
                fi
                cmd_cloud_launch "${3}"
                ;;
            "")     cmd_cloud_launch ;;
            *)
                echo "Error: unknown subcommand '${2}'."
                echo "Usage: beacon cloud [push|pull|join|open|list|status]"
                echo "       (sandbox: cloud off --confirm <project_id>)"
                exit 1
                ;;
        esac
        ;;
    auth)
        case "${2:-}" in
            login)
                python3 "$COMMANDS_PY" auth_login
                if [ ! -d "${HOME}/.claude/skills/beacon-log" ]; then
                    echo ""
                    echo "Tip: Run 'beacon skill install' to set up Claude Code Skills."
                fi
                ;;
            logout) python3 "$COMMANDS_PY" auth_logout ;;
            status) python3 "$COMMANDS_PY" auth_status ;;
            *)      echo "Usage: beacon auth [login|logout|status]" ;;
        esac
        ;;
    skill)
        case "${2:-}" in
            install) python3 "$COMMANDS_PY" skill_install ;;
            *)       echo "Usage: beacon skill install" ;;
        esac
        ;;
    channel)
        # ms-54 e-1152 / e-1266: project-level Channel install + uninstall +
        # opt-out + status. ensure_project runs on the python side so a
        # clearer error surfaces when the user is outside a project root.
        case "${2:-}" in
            install) python3 "$COMMANDS_PY" channel_install ;;
            uninstall)
                shift 2
                _ch_purge=""
                # --keep-files is the default behavior (just skip --purge-files).
                # We accept it explicitly so the user-facing command surface
                # documents both intents symmetrically.
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --purge-files) _ch_purge="1"; shift ;;
                        --keep-files)  shift ;;  # default, no flag needed
                        *)             shift ;;
                    esac
                done
                BEACON_CHANNEL_PURGE_FILES="$_ch_purge" \
                    python3 "$COMMANDS_PY" channel_uninstall
                ;;
            opt-out|opt_out)
                shift 2
                _ch_scope="project"
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --global)  _ch_scope="global";  shift ;;
                        --project) _ch_scope="project"; shift ;;
                        *)         shift ;;
                    esac
                done
                BEACON_CHANNEL_SCOPE="$_ch_scope" \
                    python3 "$COMMANDS_PY" channel_opt_out
                ;;
            opt-in|opt_in)
                shift 2
                _ch_scope="project"
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --global)  _ch_scope="global";  shift ;;
                        --project) _ch_scope="project"; shift ;;
                        *)         shift ;;
                    esac
                done
                BEACON_CHANNEL_SCOPE="$_ch_scope" \
                    python3 "$COMMANDS_PY" channel_opt_in
                ;;
            status)
                python3 "$COMMANDS_PY" channel_status
                ;;
            "")
                echo "Usage: beacon channel install"
                echo "       beacon channel uninstall [--purge-files|--keep-files]"
                echo "       beacon channel opt-out [--project|--global]"
                echo "       beacon channel opt-in  [--project|--global]"
                echo "       beacon channel status"
                ;;
            *)
                echo "Unknown channel subcommand: ${2:-}"
                echo "Run: beacon channel  (no args, prints usage)"
                ;;
        esac
        ;;
    monitor)
        # ms-44 e-854: context-usage Stop hook discoverable from the CLI.
        # The Stop hook itself is registered via beacon-hook-context-monitor
        # (entry-point) or bin/context-usage-monitor.sh / .py — this verb is
        # the same code path so users can dry-run the threshold logic.
        case "${2:-}" in
            context)
                shift 2
                dry=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --dry-run) dry="1"; shift ;;
                        *)         shift ;;
                    esac
                done
                if [[ -n "$dry" ]]; then
                    BEACON_CONTEXT_MONITOR_DRY_RUN=1 python3 -m beacon_cli.hooks.context_monitor
                else
                    python3 -m beacon_cli.hooks.context_monitor
                fi
                ;;
            "")  echo "Usage: beacon monitor context [--dry-run]" ;;
            *)   echo "Unknown monitor subcommand: ${2:-}"; echo "Usage: beacon monitor context [--dry-run]" ;;
        esac
        ;;
    member)
        ensure_project
        case "${2:-}" in
            add)
                shift 2
                mid="" mname="" memail="" mrole="contributor" mjson=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --name)  mname="${2:-}"; shift 2 ;;
                        --email) memail="${2:-}"; shift 2 ;;
                        --role)  mrole="${2:-}"; shift 2 ;;
                        --json)  mjson="1"; shift ;;
                        *)       [[ -z "$mid" ]] && mid="$1"; shift ;;
                    esac
                done
                if [ -z "$mid" ]; then
                    echo "Usage: beacon member add <id> [--name N] [--email E] [--role owner|maintainer|contributor|viewer] [--json]"
                    exit 1
                fi
                BEACON_MEMBER_ID="$mid" BEACON_MEMBER_NAME="$mname" \
                    BEACON_MEMBER_EMAIL="$memail" BEACON_MEMBER_ROLE="$mrole" \
                    BEACON_JSON="$mjson" \
                    python3 "$COMMANDS_PY" member_add
                ;;
            list|ls)
                shift 2
                mjson=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --json) mjson="1"; shift ;;
                        *) shift ;;
                    esac
                done
                BEACON_JSON="$mjson" python3 "$COMMANDS_PY" member_list
                ;;
            remove|rm)
                shift 2
                mid="" reason="" mjson=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        -r|--reason) reason="${2:-}"; shift 2 ;;
                        --json)      mjson="1"; shift ;;
                        *)           [[ -z "$mid" ]] && mid="$1"; shift ;;
                    esac
                done
                if [ -z "$mid" ]; then
                    echo "Usage: beacon member remove <id> --reason <text> [--json]"
                    exit 1
                fi
                BEACON_MEMBER_ID="$mid" BEACON_REASON="$reason" BEACON_JSON="$mjson" \
                    python3 "$COMMANDS_PY" member_remove
                ;;
            role)
                shift 2
                mid="${1:-}"
                mrole="${2:-}"
                if [ -z "$mid" ] || [ -z "$mrole" ]; then
                    echo "Usage: beacon member role <id> <owner|maintainer|contributor|viewer>"
                    exit 1
                fi
                BEACON_MEMBER_ID="$mid" BEACON_MEMBER_ROLE="$mrole" \
                    python3 "$COMMANDS_PY" member_role
                ;;
            *)
                echo "Usage: beacon member [add|list|remove|role]"
                echo "  add <id> [--name N] [--email E] [--role R]   Add a member to the project"
                echo "  list [--json]                                  List members"
                echo "  remove <id> --reason <text>                    Remove a member (audit reason required)"
                echo "  role <id> <role>                               Change role (owner|maintainer|contributor|viewer)"
                ;;
        esac
        ;;
    update)
        shift
        upd_check="" upd_skill_only="" upd_yes=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --check)      upd_check="1"; shift ;;
                --skill-only) upd_skill_only="1"; shift ;;
                -y|--yes)     upd_yes="1"; shift ;;
                -h|--help)
                    echo "Usage: beacon update [--check] [--skill-only] [-y|--yes]"
                    echo ""
                    echo "Self-update beacon and refresh Claude Code Skills."
                    echo "  --check       Dry-run: show what would happen, no changes."
                    echo "  --skill-only  Skip brew/git upgrade; only re-install Skills."
                    echo "  -y, --yes     Skip interactive confirmation."
                    exit 0
                    ;;
                *) shift ;;
            esac
        done
        BEACON_UPDATE_CHECK="$upd_check" \
            BEACON_UPDATE_SKILL_ONLY="$upd_skill_only" \
            BEACON_UPDATE_YES="$upd_yes" \
            python3 "$COMMANDS_PY" update
        ;;
    deploy)
        ensure_project
        case "${2:-}" in
            record)
                shift 2
                revision="" semver="" desc="" hash="" date="" before="" mode="" type="" env="" version=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --prepare)       mode="prepare";    shift ;;
                        --finalize)      mode="finalize";   shift ;;
                        --revision)      revision="${2:-}"; shift 2 ;;
                        --semver)        semver="${2:-}";   shift 2 ;;
                        --version)       version="${2:-}";  shift 2 ;;
                        --desc)          desc="${2:-}";     shift 2 ;;
                        --hash)          hash="${2:-}";     shift 2 ;;
                        --date)          date="${2:-}";     shift 2 ;;
                        --insert-before) before="${2:-}";   shift 2 ;;
                        --type)          type="${2:-}";     shift 2 ;;
                        --env)           env="${2:-}";      shift 2 ;;
                        *) shift ;;
                    esac
                done
                BEACON_MODE="$mode" BEACON_REVISION="$revision" BEACON_SEMVER="$semver" \
                    BEACON_VERSION="$version" \
                    BEACON_DESCRIPTION="$desc" BEACON_HASH="$hash" \
                    BEACON_DATE="$date" BEACON_INSERT_BEFORE="$before" BEACON_TYPE="$type" \
                    BEACON_ENVIRONMENT="$env" \
                    python3 "$COMMANDS_PY" deploy_record
                ;;
            list)
                shift 2
                env="" json=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --env)    env="${2:-}"; shift 2 ;;
                        --json)   json="1";     shift ;;
                        *) shift ;;
                    esac
                done
                BEACON_JSON="$json" BEACON_ENVIRONMENT="$env" python3 "$COMMANDS_PY" deploy_list ;;
            delete)
                BEACON_DEPLOY_ID="${3:-}" python3 "$COMMANDS_PY" deploy_delete ;;
            void)
                _void_deploy_id="${3:-}"
                _void_reason=""
                shift 3 || true
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        -r|--reason) _void_reason="${2:-}"; shift 2 ;;
                        *) shift ;;
                    esac
                done
                BEACON_DEPLOY_ID="$_void_deploy_id" BEACON_REASON="$_void_reason" \
                    python3 "$COMMANDS_PY" deploy_void
                ;;
            rollback)
                shift 2
                rb_reason="" rb_execute="" rb_service="" rb_json=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        -r|--reason)  rb_reason="${2:-}"; shift 2 ;;
                        --execute)    rb_execute="1"; shift ;;
                        --service)    rb_service="${2:-}"; shift 2 ;;
                        --json)       rb_json="1"; shift ;;
                        *) shift ;;
                    esac
                done
                BEACON_REASON="$rb_reason" BEACON_EXECUTE="$rb_execute" \
                    BEACON_SERVICE="$rb_service" BEACON_JSON="$rb_json" \
                    python3 "$COMMANDS_PY" deploy_rollback
                ;;
            *)
                echo "Usage: beacon deploy record [--env <env>] [--revision <rev>] [--semver <v1.0.0>] [--version <tag>] [--desc <text>]"
                echo "       beacon deploy list [--env <env>] [--json]"
                echo "       beacon deploy void <id> --reason <text>"
                echo "       beacon deploy rollback --reason <text> [--service <name>] [--execute]"
                ;;
        esac
        ;;
    push)
        ensure_project
        case "${2:-}" in
            record)
                shift 2
                from="" to="" branch="" desc="" ms="" version=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --prepare)  mode="prepare"; shift ;;
                        --finalize) mode="finalize"; shift ;;
                        --from)     from="${2:-}"; shift 2 ;;
                        --to)       to="${2:-}"; shift 2 ;;
                        --branch)   branch="${2:-}"; shift 2 ;;
                        --desc)     desc="${2:-}"; shift 2 ;;
                        --version)  version="${2:-}"; shift 2 ;;
                        -m|--ms)    ms="${2:-}"; shift 2 ;;
                        *) shift ;;
                    esac
                done
                BEACON_MODE="${mode:-}" BEACON_FROM="$from" BEACON_TO="$to" \
                    BEACON_BRANCH="$branch" BEACON_DESCRIPTION="$desc" BEACON_MS="$ms" \
                    BEACON_VERSION="$version" \
                    python3 "$COMMANDS_PY" push_record
                ;;
            list)
                BEACON_JSON="${3:+1}" python3 "$COMMANDS_PY" push_list ;;
            *)
                echo "Usage: beacon push record [--from <hash>] [--to <hash>] [--desc <text>] [--version <tag>] [-m <ms-id>]"
                echo "       beacon push list [--json]"
                ;;
        esac
        ;;
    project)
        ensure_project
        case "${2:-}" in
            archive)   python3 "$COMMANDS_PY" project_archive ;;
            unarchive) python3 "$COMMANDS_PY" project_unarchive ;;
            export)
                shift 2
                _out=""
                _backup="0"
                _json="0"
                while [ "$#" -gt 0 ]; do
                    case "$1" in
                        --backup) _backup="1"; shift ;;
                        -o|--output) _out="$2"; shift 2 ;;
                        --json) _json="1"; shift ;;
                        -h|--help)
                            echo "Usage: beacon project export [--backup] -o <output.zip> [--json]"
                            exit 0 ;;
                        *) echo "Unknown flag: $1"; exit 1 ;;
                    esac
                done
                BEACON_OUTPUT="$_out" BEACON_BACKUP="$_backup" BEACON_JSON="$_json" \
                    python3 "$COMMANDS_PY" project_export
                ;;
            import)
                shift 2
                _in=""
                _target=""
                _force="0"
                _json="0"
                while [ "$#" -gt 0 ]; do
                    case "$1" in
                        -i|--input) _in="$2"; shift 2 ;;
                        -t|--target) _target="$2"; shift 2 ;;
                        --force) _force="1"; shift ;;
                        --json) _json="1"; shift ;;
                        -h|--help)
                            echo "Usage: beacon project import -i <backup.zip> -t <target-dir> [--force] [--json]"
                            exit 0 ;;
                        *) echo "Unknown flag: $1"; exit 1 ;;
                    esac
                done
                BEACON_INPUT="$_in" BEACON_TARGET="$_target" BEACON_FORCE="$_force" BEACON_JSON="$_json" \
                    python3 "$COMMANDS_PY" project_import
                ;;
            *) echo "Usage: beacon project archive|unarchive|export|import" ;;
        esac
        ;;
    reset)
        # ⚠️  DANGER: moves .beacon/ to a timestamped backup. LOCAL ONLY — cloud data is untouched.
        if [ ! -f "$BEACON_PROJECT_FILE" ]; then
            echo "Error: No .beacon/project.json found."
            exit 1
        fi
        _reset_beacon_dir="$(dirname "$BEACON_PROJECT_FILE")"
        _reset_project_name=$(python3 -c "import json; print(json.load(open('$BEACON_PROJECT_FILE')).get('name','?'))" 2>/dev/null)
        _reset_backup_dir="${_reset_beacon_dir}.bak.$(date +%Y%m%d_%H%M%S)"

        echo ""
        echo "WARNING: beacon reset"
        echo "========================================"
        echo "  Project : $_reset_project_name"
        echo "  Location: $(pwd)/$_reset_beacon_dir"
        echo ""
        echo "  ALL local beacon data will be moved to:"
        echo "  $(pwd)/$_reset_backup_dir"
        echo ""
        echo "  Cloud data is NOT affected."
        echo "  Fully reversible: mv $_reset_backup_dir $_reset_beacon_dir"
        echo "========================================"
        echo ""
        read -rp "  Type RESET to confirm: " _reset_confirm
        if [ "$_reset_confirm" != "RESET" ]; then
            echo "Cancelled."
            exit 0
        fi
        mv "$_reset_beacon_dir" "$_reset_backup_dir"
        echo ""
        echo "Moved: $_reset_beacon_dir -> $_reset_backup_dir"
        echo "Restore: mv $_reset_backup_dir $_reset_beacon_dir"
        ;;
    search)
        ensure_project
        # Unified search (CORE doc 検索基盤の原則).
        # Flags mirror SPEC `3ne57ccZegYQXDQA03op` so the CLI, server API, and
        # /beacon-retrospect Skill all share the same parameter surface.
        search_query=""
        search_ms_id=""
        search_op_id=""
        search_entry_id=""
        search_scope=""
        search_assignee=""
        search_owner=""
        search_from=""
        search_to=""
        search_type=""
        search_status=""
        search_priority=""
        search_limit=""
        search_offset=""
        search_json_flag=""
        shift
        while [[ $# -gt 0 ]]; do
            case "$1" in
                -m|--ms)       search_ms_id="${2:-}";    shift 2 ;;
                -o|--op)       search_op_id="${2:-}";    shift 2 ;;
                --id)          search_entry_id="${2:-}"; shift 2 ;;
                --scope)       search_scope="${2:-}";    shift 2 ;;
                --assignee)    search_assignee="${2:-}"; shift 2 ;;
                --owner)       search_owner="${2:-}";    shift 2 ;;
                --from)        search_from="${2:-}";     shift 2 ;;
                --to)          search_to="${2:-}";       shift 2 ;;
                --type)        search_type="${2:-}";     shift 2 ;;
                --status)      search_status="${2:-}";   shift 2 ;;
                --priority)    search_priority="${2:-}"; shift 2 ;;
                --limit)       search_limit="${2:-}";    shift 2 ;;
                --offset)      search_offset="${2:-}";   shift 2 ;;
                --json)        search_json_flag="1";     shift ;;
                *) [[ -z "$search_query" ]] && search_query="$1"; shift ;;
            esac
        done
        BEACON_QUERY="$search_query" \
            BEACON_MS_ID="$search_ms_id" \
            BEACON_OPERATION_ID="$search_op_id" \
            BEACON_ENTRY_ID="$search_entry_id" \
            BEACON_SCOPE="$search_scope" \
            BEACON_ASSIGNEE="$search_assignee" \
            BEACON_OWNER="$search_owner" \
            BEACON_FROM="$search_from" \
            BEACON_TO="$search_to" \
            BEACON_TYPE="$search_type" \
            BEACON_STATUS="$search_status" \
            BEACON_PRIORITY="$search_priority" \
            BEACON_LIMIT="$search_limit" \
            BEACON_OFFSET="$search_offset" \
            BEACON_JSON="$search_json_flag" \
            python3 "$COMMANDS_PY" search
        ;;
    doctor)
        python3 "$COMMANDS_PY" doctor
        ;;
    cycle)
        ensure_project
        shift
        cycle_sub="${1:-status}"
        case "$cycle_sub" in
            status)
                shift
                cycle_json_flag=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --json) cycle_json_flag="1"; shift ;;
                        *) shift ;;
                    esac
                done
                BEACON_JSON="$cycle_json_flag" python3 "$COMMANDS_PY" cycle_status
                ;;
            *)
                echo "Unknown cycle subcommand: $cycle_sub"
                echo "Usage: beacon cycle status [--json]"
                exit 1
                ;;
        esac
        ;;
    help|-h|--help)
        if [[ "${2:-}" == "--json" ]]; then
            python3 "$COMMANDS_PY" help_json
        else
            usage
        fi
        ;;
    --version|-V)
        python3 "$COMMANDS_PY" version
        ;;
    *)
        echo "Unknown command: $1"
        usage
        exit 1
        ;;
esac
