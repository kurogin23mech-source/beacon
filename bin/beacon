}

cmd_task_done() {
    ensure_project
    local entry_id=""
    local progress=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--progress)
                progress="${2:-}"
                shift 2
                ;;
            *)
                entry_id="$1"
                shift
                ;;
        esac
    done

    if [ -z "$entry_id" ]; then
        echo "Usage: beacon task done <entry-id> [-p <progress>]"
        exit 1
    fi
    BEACON_ENTRY_ID="$entry_id" BEACON_PROGRESS="$progress" \
        python3 "$COMMANDS_PY" task_done
}

cmd_task_list() {
    ensure_project
    local ms_id=""
    local json_flag=""
    local all_flag=""
    local type_filter=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m|--ms)
                ms_id="${2:-}"
                shift 2
                ;;
            --json)
                json_flag="1"
                shift
                ;;
            --all|-a)
                all_flag="1"
                shift
                ;;
            --type|-t)
                type_filter="${2:-}"
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    BEACON_MS_ID="$ms_id" BEACON_JSON="$json_flag" BEACON_ALL="$all_flag" \
        BEACON_TYPE_FILTER="$type_filter" python3 "$COMMANDS_PY" task_list
}

cmd_entry_move() {
    ensure_project
    local entry_id=""
    local task_id=""
    local ms_id=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -t|--task)
                task_id="${2:-}"
                shift 2
                ;;
            -m|--ms)
                ms_id="${2:-}"
                shift 2
                ;;
            *)
                entry_id="$1"
                shift
                ;;
        esac
    done

    BEACON_ENTRY_ID="$entry_id" BEACON_TASK_ID="$task_id" BEACON_MS_ID="$ms_id" \
        python3 "$COMMANDS_PY" entry_move
}

cmd_retro() {
    ensure_project
    local since="" until=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --since) since="${2:-}"; shift 2 ;;
            --until) until="${2:-}"; shift 2 ;;
            --prepare) shift ;;
            *) shift ;;
        esac
    done

    # Default: current week (Monday to today)
    if [ -z "$since" ]; then
        local dow
        dow=$(date +%u)  # 1=Mon, 7=Sun
        if [[ "$(uname)" == "Darwin" ]]; then
            since=$(date -v-"$((dow - 1))"d +%Y-%m-%d)
        else
            since=$(date -d "last monday" +%Y-%m-%d 2>/dev/null || date +%Y-%m-%d)
        fi
    fi
    if [ -z "$until" ]; then
        until=$(date +%Y-%m-%d)
    fi

    BEACON_SINCE="$since" BEACON_UNTIL="$until" \
        python3 "$COMMANDS_PY" retro_prepare
}

cmd_status() {
    ensure_project
    local json_flag=""
    local all_flag=""
    local ms_filter=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json_flag="1"; shift ;;
            --all|-a) all_flag="1"; shift ;;
            --ms)
                if [ -n "$ms_filter" ]; then
                    ms_filter="$ms_filter,${2:-}"
                else
                    ms_filter="${2:-}"
                fi
                shift 2 ;;
            *) shift ;;
        esac
    done
    BEACON_JSON="$json_flag" BEACON_ALL="$all_flag" BEACON_MS_FILTER="$ms_filter" \
        python3 "$COMMANDS_PY" milestone_list
}

cmd_cloud_launch() {
    local project_id="${1:-}"

    # If no project_id, show list and let user pick
    if [ -z "$project_id" ]; then
        echo "Cloud projects:"
        echo ""
        python3 "$COMMANDS_PY" cloud_list
        echo ""
        read -rp "Project ID to open: " project_id
        if [ -z "$project_id" ]; then
            echo "Cancelled."
            return 1
        fi
    fi

    # Ensure .beacon dir, cloud.json, and config.json exist
    mkdir -p .beacon
    cat > .beacon/cloud.json <<EOJSON
{
  "project_id": "$project_id"
}
EOJSON
    cat > .beacon/config.json <<EOJSON
{
  "mode": "cloud"
}
EOJSON

    # Create a minimal project.json if it doesn't exist (cloud mode will override reads)
    if [ ! -f "$BEACON_PROJECT_FILE" ]; then
        echo '{"name":"cloud","milestones":[]}' > "$BEACON_PROJECT_FILE"
    fi

    # Launch with BEACON_CLOUD=1
    export BEACON_CLOUD=1
    cmd_launch
}

cmd_launch() {
    ensure_project

    local abs_project
    abs_project="$(cd "$(dirname "$BEACON_PROJECT_FILE")" && pwd)/$(basename "$BEACON_PROJECT_FILE")"
    local work_dir
    work_dir="$(pwd)"
    # Use full path hash to avoid name collisions between dirs with same basename
    local dir_hash
    dir_hash=$(echo -n "$work_dir" | md5 -q 2>/dev/null || echo -n "$work_dir" | md5sum | cut -d' ' -f1)
    local session_name="beacon-${dir_hash:0:8}"
    local dashboard_pct="${BEACON_DASHBOARD_WIDTH:-33}"

    # If already inside this beacon session, restart dashboard pane if needed
    if [ "${TMUX:-}" ]; then
        local current_session
        current_session=$(tmux display-message -p '#{session_name}' 2>/dev/null)
        if [ "$current_session" = "$session_name" ]; then
            # Already inside this session — check if dashboard pane exists
            local pane_count
            pane_count=$(tmux list-panes -t "$session_name" 2>/dev/null | wc -l | tr -d ' ')
            if [ "$pane_count" -lt 2 ]; then
                echo "Restarting dashboard pane..."
                local env_prefix=""
                [ "${BEACON_CLOUD:-}" = "1" ] && env_prefix="BEACON_CLOUD=1 "
                tmux split-window -hbd -t "$session_name" -c "$work_dir" \
                    -l "${dashboard_pct}%" \
                    "${env_prefix}python3 '$DASHBOARD_PY' '$abs_project'"
                tmux select-pane -t "$session_name:.1"
            else
                echo "Beacon is already running."
            fi
            return 0
        fi
    fi

    # If session already exists, just re-attach
    if tmux has-session -t "$session_name" 2>/dev/null; then
        echo "Re-attaching to existing beacon session."
        if [ "${TMUX:-}" ]; then
            tmux switch-client -t "$session_name"
        else
            tmux attach-session -t "$session_name"
        fi
        return 0
    fi

    # Create new session
    tmux new-session -d -s "$session_name" -c "$work_dir"

    # Session-specific settings (no -g flag to avoid polluting other sessions)
    tmux set-option -t "$session_name" history-limit 10000

    # Build env prefix for cloud mode
    local env_prefix=""
    if [ "${BEACON_CLOUD:-}" = "1" ]; then
        tmux set-environment -t "$session_name" BEACON_CLOUD 1
        env_prefix="BEACON_CLOUD=1 "
    fi

    # Create dashboard pane to the LEFT of the shell pane
    # When dashboard exits (q), kill the entire session to clean up
    tmux split-window -hbd -t "$session_name" -c "$work_dir" \
        -l "${dashboard_pct}%" \
        "${env_prefix}python3 '$DASHBOARD_PY' '$abs_project'"

    # Re-apply ratio on window resize (no quotes around % value for tmux to parse it)
    tmux set-hook -t "$session_name" after-resize-window \
        "resize-pane -t ${session_name}:.0 -x ${dashboard_pct}%"

    # When shell pane exits (exit/ctrl-d), also kill session
    tmux set-hook -t "$session_name" pane-exited \
        "kill-session"

    # Focus on the right (working) pane
    tmux select-pane -t "$session_name:.1"

    # Attach (use switch-client if already inside tmux)
    if [ "${TMUX:-}" ]; then
        tmux switch-client -t "$session_name"
    else
        tmux attach-session -t "$session_name"
    fi
}

cmd_doc() {
    ensure_project
    case "${1:-}" in
        add)
            shift
            local doc_title=""
            local doc_id=""
            local doc_content=""
            local doc_scope=""
            local json_flag=""
            local doc_ms=""

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --id)       doc_id="${2:-}"; shift 2 ;;
                    --scope|-s) doc_scope="${2:-}"; shift 2 ;;
                    --ms)       doc_ms="${2:-}"; shift 2 ;;
                    --json)     json_flag="1"; shift ;;
                    --content)  doc_content="${2:-}"; shift 2 ;;
                    --stdin)    shift ;;  # stdin is handled by Python side
                    *)          doc_title="$1"; shift ;;
                esac
            done

            if [ -z "$doc_title" ]; then
                echo "Usage: beacon doc add \"title\" [--scope core|spec|memo] [--ms ms-id] [--id slug] [--content text] [--json]"
                echo "  Content can also be piped via stdin."
                exit 1
            fi
            BEACON_TITLE="$doc_title" BEACON_DOC_ID="$doc_id" \
                BEACON_CONTENT="$doc_content" BEACON_SCOPE="$doc_scope" \
                BEACON_MS="$doc_ms" BEACON_JSON="$json_flag" \
                python3 "$COMMANDS_PY" doc_add
            ;;
        list|ls)
            shift
            local json_flag=""
            local scope_filter=""
            local ms_filter=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --json)     json_flag="1"; shift ;;
                    --scope|-s) scope_filter="${2:-}"; shift 2 ;;
                    --ms)       ms_filter="${2:-}"; shift 2 ;;
                    *) shift ;;
                esac
            done
            BEACON_JSON="$json_flag" BEACON_SCOPE="$scope_filter" \
                BEACON_MS="$ms_filter" python3 "$COMMANDS_PY" doc_list
            ;;
        update)
            shift
            local doc_id=""
            local doc_content=""
            local doc_title=""
            local doc_scope=""
            local doc_ms=""
            local json_flag=""

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --content)  doc_content="${2:-}"; shift 2 ;;
                    --title)    doc_title="${2:-}"; shift 2 ;;
                    --scope|-s) doc_scope="${2:-}"; shift 2 ;;
                    --ms)       doc_ms="${2:-}"; shift 2 ;;
                    --json)     json_flag="1"; shift ;;
                    --stdin)    shift ;;
                    *)          doc_id="$1"; shift ;;
                esac
            done

            if [ -z "$doc_id" ]; then
                echo "Usage: beacon doc update <doc-id> [--title text] [--scope core|spec|memo] [--ms ms-id] [--content text] [--json]"
                echo "  Content can also be piped via stdin."
                exit 1
            fi
            BEACON_DOC_ID="$doc_id" BEACON_TITLE="$doc_title" \
                BEACON_CONTENT="$doc_content" BEACON_SCOPE="$doc_scope" \
                BEACON_MS="$doc_ms" BEACON_JSON="$json_flag" \
                python3 "$COMMANDS_PY" doc_update
            ;;
        show|get)
            shift
            local doc_id=""
            local json_flag=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --json) json_flag="1"; shift ;;
                    *)      doc_id="$1"; shift ;;
                esac
            done
            if [ -z "$doc_id" ]; then
                echo "Usage: beacon doc show <doc-id> [--json]"
                exit 1
            fi
            BEACON_DOC_ID="$doc_id" BEACON_JSON="$json_flag" python3 "$COMMANDS_PY" doc_show
            ;;
        delete|rm)
            shift
            local doc_id=""
            local json_flag=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --json) json_flag="1"; shift ;;
                    *)      doc_id="$1"; shift ;;
                esac
            done
            if [ -z "$doc_id" ]; then
                echo "Usage: beacon doc delete <doc-id>"
                exit 1
            fi
            BEACON_DOC_ID="$doc_id" BEACON_JSON="$json_flag" python3 "$COMMANDS_PY" doc_delete
            ;;
        *)
            echo "Usage: beacon doc [add|list|show|update|delete]"
            echo "  add    \"title\" --scope core|spec|memo [--ms ms-id]  Create a document"
            echo "  update <doc-id> [--title text] [--content text]     Update a document"
            echo "  list   [--scope core|spec|memo] [--ms ms-id]        List documents"
            echo "  show   <doc-id>                                      Show document content"
            echo "  delete <doc-id>                                      Delete a document"
            ;;
    esac
}

cmd_pr() {
    ensure_project
    case "${1:-}" in
        add)
            shift
            local url=""
            local ms_id=""
            local intent=""
            local author=""
            local json_flag=""

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -m|--ms)       ms_id="${2:-}"; shift 2 ;;
                    --intent)      intent="${2:-}"; shift 2 ;;
                    --author)      author="${2:-}"; shift 2 ;;
                    --json)        json_flag="1"; shift ;;
                    *)             url="$1"; shift ;;
                esac
            done

            if [ -z "$url" ]; then
                echo "Usage: beacon pr add <github-url> [-m <ms-id>] [--intent \"text\"] [--author user]"
                exit 1
            fi

            local date_str
            date_str=$(date +%Y-%m-%d)

            BEACON_URL="$url" BEACON_MS_ID="$ms_id" BEACON_INTENT="$intent" \
                BEACON_AUTHOR="$author" BEACON_DATE="$date_str" BEACON_JSON="$json_flag" \
                python3 "$COMMANDS_PY" pr_add
            ;;
        close)
            shift
            local entry_id=""
            local json_flag=""

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --json) json_flag="1"; shift ;;
                    *)      entry_id="$1"; shift ;;
                esac
            done

            if [ -z "$entry_id" ]; then
                echo "Usage: beacon pr close <entry-id> [--json]"
                exit 1
            fi
            BEACON_ENTRY_ID="$entry_id" BEACON_JSON="$json_flag" python3 "$COMMANDS_PY" pr_close
            ;;
        approve)
            shift
            local entry_id=""
            local rationale=""
            local json_flag=""

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --rationale) rationale="${2:-}"; shift 2 ;;
                    --json)      json_flag="1"; shift ;;
                    *)           entry_id="$1"; shift ;;
                esac
            done

            if [ -z "$entry_id" ]; then
                echo "Usage: beacon pr approve <entry-id> [--rationale \"text\"] [--json]"
                exit 1
            fi
            BEACON_ENTRY_ID="$entry_id" BEACON_RATIONALE="$rationale" BEACON_JSON="$json_flag" \
                python3 "$COMMANDS_PY" pr_approve
            ;;
        reject)
            shift
            local entry_id=""
            local rationale=""
            local json_flag=""

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --rationale) rationale="${2:-}"; shift 2 ;;
                    --json)      json_flag="1"; shift ;;
                    *)           entry_id="$1"; shift ;;
                esac
            done

            if [ -z "$entry_id" ]; then
                echo "Usage: beacon pr reject <entry-id> [--rationale \"text\"] [--json]"
                exit 1
            fi
            BEACON_ENTRY_ID="$entry_id" BEACON_RATIONALE="$rationale" BEACON_JSON="$json_flag" \
                python3 "$COMMANDS_PY" pr_reject
            ;;
        create)
            shift
            local ms_id=""
            local intent=""
            local gh_args=""

            # Collect known beacon flags; pass remaining args to gh pr create
            local remaining=()
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -m|--ms)     ms_id="${2:-}"; shift 2 ;;
                    --intent)    intent="${2:-}"; shift 2 ;;
                    *)           remaining+=("$1"); shift ;;
                esac
            done

            # Build gh args string for passthrough
            if [ ${#remaining[@]} -gt 0 ]; then
                gh_args="${remaining[*]}"
            fi

            BEACON_MS_ID="$ms_id" BEACON_INTENT="$intent" BEACON_GH_ARGS="$gh_args" \
                python3 "$COMMANDS_PY" pr_create
            ;;
        *)
            echo "Usage: beacon pr [create|add|close|approve|reject]"
            echo "  create [-m <ms-id>] [--intent \"text\"] [gh pr create flags...]"
            echo "         Run gh pr create and auto-record the PR in beacon"
            echo "  add    <github-url> [-m <ms-id>] [--intent \"text\"]  Register a PR"
            echo "  close  <entry-id>                                     Close a PR"
            echo "  approve <entry-id> [--rationale \"text\"]              Approve a PR"
            echo "  reject  <entry-id> [--rationale \"text\"]              Reject a PR"
            ;;
    esac
}

# --- Main dispatch ---
case "${1:-}" in
    ""|start)
        cmd_launch
        ;;
    setup)
        cmd_setup
        ;;
    init)
        shift
        cmd_init "$@"
        ;;
    status)
        shift
        cmd_status "$@"
        ;;
    milestone|ms)
        case "${2:-}" in
            add)    shift 2; cmd_milestone_add "$@" ;;
            list|ls) cmd_milestone_list ;;
            start)  cmd_milestone_start "${3:-}" ;;
            done|close) cmd_milestone_done "${3:-}" ;;
            observe)    cmd_milestone_observe "${3:-}" ;;
            show)   shift 2; cmd_milestone_show "$@" ;;
            update) shift 2; cmd_milestone_update "$@" ;;
            delete|cancel) shift 2; cmd_milestone_delete "$@" ;;
            depends) shift 2; cmd_milestone_depends "$@" ;;
            workspace) shift 2; cmd_milestone_workspace "$@" ;;
            graph) shift 2; cmd_milestone_graph "$@" ;;
            *)      echo "Usage: beacon milestone [add|list|start|close|observe|done|show|update|delete|depends|workspace|graph]" ;;
        esac
        ;;
    log)
        shift
        cmd_log "$@"
        ;;
    save)
        shift
        cmd_save "$@"
        ;;
    sync)
        cmd_sync
        ;;
    summary)
        shift
        cmd_summary "$@"
        ;;
    task)
        case "${2:-}" in
            add)
                shift 2
                cmd_task_add "$@"
                ;;
            done)
                cmd_task_done "${3:-}"
                ;;
            list|ls)
                shift 2
                cmd_task_list "$@"
                ;;
            show)
                shift 2
                cmd_task_show "$@"
                ;;
            detail)
                shift 2
                cmd_task_detail "$@"
                ;;
            update)
                shift 2
                cmd_task_update "$@"
                ;;
            delete|cancel)
                shift 2
                cmd_task_delete "$@"
                ;;
            *)
                echo "Usage: beacon task [add|done|list|show|detail|update|delete] [-m <ms-id>] [-t <type>] [-d <detail>] [description]"
                ;;
        esac
        ;;
    entry)
        case "${2:-}" in
            move)
                shift 2
                cmd_entry_move "$@"
                ;;
            *)
                echo "Usage: beacon entry move <entry-id> -t <task-id> | -m <ms-id>"
                ;;
        esac
        ;;
    pr)
        shift
        cmd_pr "$@"
        ;;
    retro)
        shift
        case "${1:-}" in
            done)
                python3 "$COMMANDS_PY" retro_done
                ;;
            *)
                cmd_retro "$@"
                ;;
        esac
        ;;
    trigger)
        case "${2:-}" in
            fire)
                BEACON_TRIGGER_NAME="${3:-}" BEACON_TRIGGER_MESSAGE="${4:-}" \
                    python3 "$COMMANDS_PY" trigger_fire
                ;;
            check)
                python3 "$COMMANDS_PY" trigger_check
                ;;
            clear)
                BEACON_TRIGGER_NAME="${3:-}" python3 "$COMMANDS_PY" trigger_clear
                ;;
            *)
                echo "Usage: beacon trigger [fire|check|clear] <name> [message]"
                ;;
        esac
        ;;
    doc|document)
        shift
        cmd_doc "$@"
        ;;
    cloud)
        case "${2:-}" in
            push)   ensure_project; python3 "$COMMANDS_PY" cloud_push ;;
            pull)   ensure_project; python3 "$COMMANDS_PY" cloud_pull ;;
            join)
                if [ -z "${3:-}" ]; then
                    echo "Usage: beacon cloud join <project-id>"
                    exit 1
                fi
                BEACON_CLOUD_PROJECT_ID="${3}" python3 "$COMMANDS_PY" cloud_join
                ;;
            status) python3 "$COMMANDS_PY" cloud_status ;;
            list)   python3 "$COMMANDS_PY" cloud_list ;;
            off)
                if [ -f .beacon/config.json ]; then
                    echo '{"mode": "local"}' > .beacon/config.json
                    echo "Switched to local mode."
                else
                    echo "No .beacon/config.json found."
                fi
                ;;
            "")     cmd_cloud_launch ;;
            *)      cmd_cloud_launch "$2" ;;
        esac
        ;;
    auth)
        case "${2:-}" in
            login)
                python3 "$COMMANDS_PY" auth_login
                echo ""
                echo "Tip: Run 'beacon skill install' to set up Claude Code Skills."
                ;;
            logout) python3 "$COMMANDS_PY" auth_logout ;;
            status) python3 "$COMMANDS_PY" auth_status ;;
            *)      echo "Usage: beacon auth [login|logout|status]" ;;
        esac
        ;;
    skill)
        case "${2:-}" in
            install) python3 "$COMMANDS_PY" skill_install ;;
            *)       echo "Usage: beacon skill install" ;;
        esac
        ;;
    help|-h|--help)
        usage
        ;;
    --version|-V)
        python3 "$COMMANDS_PY" version
        ;;
    *)
        echo "Unknown command: $1"
        usage
        exit 1
        ;;
esac
