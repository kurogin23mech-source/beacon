            add)     shift 2; cmd_phase_add "$@" ;;
            rename)  shift 2; cmd_phase_rename "$@" ;;
            move)    shift 2; cmd_phase_move "$@" ;;
            remove|delete|rm) shift 2; cmd_phase_remove "$@" ;;
            *)       echo "Usage: beacon phase list|add|rename|move|remove ..." ;;
        esac
        ;;
    sync)
        cmd_sync
        ;;
    summary)
        shift
        cmd_summary "$@"
        ;;
    task)
        case "${2:-}" in
            add)
                shift 2
