#!/usr/bin/env bash
# Beacon - Milestone-driven project dashboard
set -euo pipefail

BEACON_DIR="$(cd "$(dirname "$0")/.." && pwd)"
COMMANDS_PY="$BEACON_DIR/lib/commands.py"
export BEACON_PROJECT_FILE=".beacon/project.json"

usage() {
    cat <<'EOF'
Beacon - Milestone-driven project management

Usage:
  beacon                        Show status + pointers to Tauri Desktop App / Web UI
  beacon setup                  First-time setup wizard (auth + hooks + project)
  beacon init                   Initialize .beacon/ in current directory
  beacon status                 Show current milestone status

Milestones:
  beacon milestone add "title" [--priority P] [--objective O] [--ac A]   Add a new milestone
  beacon milestone list         List milestones
  beacon milestone start <id>   Activate + auto-create ms-XX-<slug> branch + self-add as assignee
  beacon milestone join <id> [--checkout]  Add self as assignee (and optionally switch branch)
  beacon milestone close <id>   Close milestone (keeps current progress)
  beacon milestone observe <id> Set milestone to observing
  beacon milestone update <id>  Update title/progress/status/description/priority/objective/ac
  beacon milestone delete <id>  Delete (soft) a milestone
  beacon milestone purge <id> --reason <text> [--index <n>]   Hard delete (recovery only; Issue #14)
  beacon milestone depends <id> Set milestone dependencies
  beacon milestone graph        Show dependency graph
  beacon milestone add ... [--owner U] [--assignee U]   Set owner/assignee at creation
  beacon milestone update <id> [--owner U] [--assignee U]   Change owner/assignee

Members (2-5 person teams):
  beacon member add <id> [--name N] [--email E] [--role R]   Add a project member
  beacon member list [--json]                                 List members
  beacon member remove <id> --reason <text>                   Remove (audit required)
  beacon member role <id> <role>                              Change role

Tasks & Progress:
  beacon task add "desc" [-m <ms-id>]   Add a task to a milestone
  beacon task done <entry-id>           Mark task as done
  beacon task list [-m <ms-id>]         List tasks
  beacon task update <entry-id>         Update task description/status
  beacon task cancel <entry-id>         Cancel a task
  beacon entry purge <e-id> --reason <text> [--index <n>]   Hard delete an entry (recovery; e-863)
  beacon log [message]                  Record HEAD commit to active milestone
  beacon save "desc" [-m <ms-id>]       Record a manual progress note
  beacon sync                           Auto-sync recent git commits
  beacon summary "text"                 Update the project summary

Pull Requests:
  beacon pr create [-m <ms-id>] [gh flags...]  Create PR and record it
  beacon pr add <url> [-m <ms-id>]             Register an existing PR
  beacon pr show <id|number|url> [--json]      Show PR detail (intent / commits)
  beacon pr approve <entry-id>                 Approve a PR
  beacon pr request-changes <entry-id>         Request changes on a PR
  beacon pr reject <entry-id>                  Reject a PR
  beacon pr merge <entry-id>                   Mark PR as merged
  beacon pr close <entry-id>                   Close PR without merging

Documents:
  beacon doc add "title" [--scope core|spec|memo|retro|report]  Create a document
  beacon doc list [--scope <scope>]                List all documents
  beacon doc show <doc-id>                         Show document content
  beacon doc update <doc-id>                       Update a document
  beacon doc delete <doc-id>                       Delete a document
  beacon doc image-upload <local-file>             Upload image, get markdown img tag
  (doc add / doc update support --bus-origin to refuse bus-derived
   writes — persistence poisoning defense, ms-54 / e-1293)

Operations:
  beacon operation open "<title>" [--schedule daily|weekdays|weekly] [--log-source <name>]
  beacon operation close <op-id>
  beacon operation purge <op-id> --reason <text> [--index <n>]   Hard delete an operation (recovery; e-863)
  beacon operation list [--json]
  beacon operation show <op-id> [--json]
  beacon operation approve <op-id> --spec <doc-id> [--expires-at YYYY-MM-DD]  Mint T2 envelope from SPEC (ms-60)
  beacon operation revoke <op-id> [--envelope-id ENV] [--reason TEXT]         Invalidate the active envelope
  beacon operation envelope verify <op-id> <action>                           Self-check: is action permitted by the active envelope?
  beacon run record -o <op-id> --batch <name> --status ok|warning|error --desc "..."
  beacon run list -o <op-id> [--json]
  beacon incident open "<title>" -o <op-id> [--desc "..."]
  beacon incident close <id> --resolution "..."
  beacon incident escalate <id> -m <ms-id>

Treks (cross-project / cross-session 協奏作業領域 — ms-69):
  beacon trek create "<title>" [--type temporary|persistent] [--description "..."]
                                    Create a trek; caller becomes leader
  beacon trek list [--status s] [--include-archived] [--all-actors] [--json]
                                    List treks visible to the caller
  beacon trek show <trek-id> [--json]
                                    Show members / scope / status / halt
  beacon trek start <trek-id>       Transition planning → active
  beacon trek archive <trek-id>     Archive (= terminal; restart by new trek)
  beacon trek invite <trek-id> --actor <email> [--notify]
                                    Invite by email
  beacon trek join <trek-id>        Accept own invitation
  beacon trek leave <trek-id>       Remove self (leader must transfer first)
  beacon trek plan <trek-id> --add-scope <project:ref> | --remove-scope <project:ref>
                                    Edit scope (ms-/op-/e- ref, or project-wide)
  beacon trek stop <trek-id> [--reason "..."]
                                    Pull the Andon cord (halt signal)
  beacon trek resume <trek-id>      Clear the halt signal
  beacon trek transfer-leader <trek-id> --to <session-id>
                                    Hand off leader_session_id

Stop signal (ms-55: Andon cord — anyone can broadcast a halt):
  beacon stop scoped --target <kind>:<id> [--reason "..."] [--reason-kind X]
                                    Halt sessions matching kind:id (ms|task|session)
  beacon stop global [--reason "..."] [--reason-kind X]
                                    Halt every active autonomous session in the project
  beacon stop status [--json]       List currently active stop signals
  beacon resume scoped --target <kind>:<id> [--reason "..."]
                                    Clear a scoped stop signal
  beacon resume global [--reason "..."]
                                    Clear the global stop signal

Rollback (ms-55: safe boundary — local-only is auto, pushed is report-only):
  beacon rollback [--commits N] [--reason "..."] [--dry-run] [--json]
                                    Stash dirty edits + git reset --soft un-pushed
                                    commits; pushed history surfaces as
                                    compensation proposals (= revert PR etc.)

Claim primitives (ms-55: who is taking what work — coordination):
  beacon claim post    --target <kind>:<id> [--intent "..."]
                                    Broadcast "I'm taking X" (first-publisher-wins)
  beacon claim request --target <kind>:<id> --to <sid> [--intent "..."]
                                    Ask a specific session to take X
  beacon claim handoff --target <kind>:<id> --to <sid> [--intent "..."]
                                    Hand off in-progress X to another session
  beacon claim respond <claim_id> [--accept|--decline] [--reason "..."]
                                    Reply to a request/handoff
  beacon claim release <claim_id> [--outcome completed|abandoned]
                                    Mark a claim done
  beacon claim list    [--mine] [--target <kind>:<id>]
                                    List local active claims (= restart recovery)
  beacon stuck check   (--telemetry-inline '<json>' | --telemetry-file <path>)
                       [--timeout-minutes N] [--dry-run] [--json]
                                    Detect silent sessions (= idle > N min) and
                                    emit STUCK signals (= stop with reason="stuck")
  beacon morning [--since-hours N] [--events-file <path>] [--json]
                                    4-bucket digest of recent autonomous activity:
                                    完了 / 停止 / skip / 介入要望

Releases & Deploys:
  beacon deploy record [--revision <rev>] [--semver <v>] [--version <tag>] [--desc <text>]
  beacon deploy list
  beacon deploy void <id> --reason <text>
  beacon push record [--from <hash>] [--to <hash>] [--desc <text>] [--version <tag>] [-m <ms-id>]
  beacon push list

Cloud:
  beacon cloud                  Open cloud project (interactive select)
  beacon cloud list             List accessible cloud projects
  beacon cloud push             Push local project to cloud
  beacon cloud pull             Pull project from cloud
  beacon cloud join <id>        Join an existing cloud project
  beacon cloud open <id>        Open a specific cloud project
  beacon cloud status           Show cloud config status

  (sandbox / verification only, e-1861/ms-61: `cloud off --confirm <project_id>`
   disables cloud sync — archives cloud.json to .beacon/.trash/, no data loss.)

Server (maintainer only):
  gcloud run deploy beacon-api-prod --source . --region asia-northeast1 \
    --build-arg CACHE_BUST=$(date +%s)

DM Channel (multi-session messaging):
  beacon channel install            Install the beacon-bus MCP entry into .mcp.json
  beacon channel uninstall [--purge-files|--keep-files]
                                    Remove MCP entry; --purge-files also wipes channel/node_modules
  beacon channel opt-out [--project|--global]
                                    Block install / auto-install (persists across runs)
  beacon channel opt-in  [--project|--global]
                                    Lift the opt-out flag
  beacon channel status             Show install / files / opt-out / next-action state

Other:
  beacon note "<text>" [--context "<label>"]   Add a session note (ephemeral, cleared at session-end)
                                               (also accepts --bus-origin to refuse bus-derived
                                                writes — persistence poisoning defense, ms-54 / e-1293)
  beacon note list                             Show session notes
  beacon note clear                            Clear all session notes
  beacon trigger fire <name> [msg]  Fire a named trigger
  beacon trigger check              Check pending triggers
  beacon trigger clear <name>       Clear a trigger
  beacon retro                      Prepare weekly retro
  beacon search "query"             Search milestones and entries
  beacon doctor                     Check PATH, hooks, skills, token, cloud.json
  beacon reset                      Move .beacon/ to timestamped backup (reversible)
  beacon auth login                 Sign in with Google (use this, not 'cloud login')
  beacon auth logout                Remove cached credentials
  beacon auth status                Show login status
  beacon skill install              Install Claude Code Skills
  beacon monitor context [--dry-run]
                                    Stop hook: context-usage threshold monitor (e-854)
  beacon update [--check] [--skill-only] [--yes]
                                    Self-update: brew upgrade + skill install (one shot)
  beacon help                       Show this help
  beacon --version                  Show version
EOF
}

ensure_project() {
    if [ ! -f "$BEACON_PROJECT_FILE" ]; then
        echo "Error: No .beacon/project.json found."
        echo "Run 'beacon init' first."
        exit 1
    fi
}

# Guard a free-text positional (title / description) against flag-like tokens.
# Without this, the `*)` catch-all in add-style commands swallows any unknown
# flag as the value — so `beacon milestone add --help` silently stores
# "--help" as the title. This was observed as Claude Code creating bogus
# "--help" milestones across projects (e-902). Called only with tokens that
# already matched `-?*` (a dash followed by at least one char), so a lone "-"
# is still a valid value. $1 = the token, $2 = a usage line to show.
_guard_positional() {
    case "$1" in
        -h|--help)
            echo "$2"
            exit 0
            ;;
        *)
            echo "Error: '$1' looks like a flag, not a value." >&2
            echo "$2" >&2
            exit 1
            ;;
    esac
}

cmd_init() {
    if [ -f "$BEACON_PROJECT_FILE" ]; then
        echo ".beacon/project.json already exists."
        exit 1
    fi

    # Guard: warn if initializing in home directory
    if [ "$(pwd)" = "$HOME" ]; then
        echo "Warning: You are about to initialize beacon in your home directory."
        echo "This will create ~/.beacon/ and modify ~/CLAUDE.md."
        echo "Beacon is designed for project directories, not the home directory."
        echo ""
        read -rp "Continue anyway? [y/N] " confirm
        if [[ ! "$confirm" =~ ^[Yy] ]]; then
            echo "Aborted."
            exit 1
        fi
    fi

    local name="${BEACON_INIT_NAME:-}"
    local objective="${BEACON_INIT_OBJECTIVE:-}"
    local retro_day="${BEACON_INIT_RETRO_DAY:-}"
    local storage="${BEACON_INIT_STORAGE:-local}"
    # ms-63 / e-1441: default-high sensitivity unless caller opts in to low.
    local sensitivity="${BEACON_INIT_SENSITIVITY:-high}"
    local storage_choice="1"
    [[ "$storage" == "cloud" ]] && storage_choice="2"

    # Interactive mode: ask for missing fields
    if [ -z "$name" ] || [ -z "$objective" ]; then
        echo "Beacon - Project Initialization"
        echo "================================"
        echo ""

        if [ -z "$name" ]; then
            echo "Project name:"
            echo "  リポジトリ名や略称で構いません。ダッシュボードの表示名になります。"
            read -rp "> " name
            echo ""
        fi

        if [ -z "$objective" ]; then
            echo "Project objective:"
            echo "  このプロジェクトで最終的に何を実現したいですか？"
            echo "  あなたとAIが共有するゴール宣言です。セッションをまたいで判断の基準になります。"
            echo "  「何を作るか」ではなく「誰がどんな状態になるか」で書いてください。"
            echo "  例）「AI駆動で開発するユーザーが、目的と今やっていることを常にクリアに保ちながら開発に集中できるようにする」"
            read -rp "> " objective
            echo ""
        fi

        if [ -z "$retro_day" ]; then
            echo "Weekly retro day:"
            echo "  毎週この曜日にAIが振り返りを促します。週の締めに近い曜日がおすすめです。"
            echo "  1=Mon  2=Tue  3=Wed  4=Thu  5=Fri  6=Sat  7=Sun"
            read -rp "> [5]: " retro_choice_input
            retro_choice_input="${retro_choice_input:-5}"
            case "$retro_choice_input" in
                1) retro_day="monday" ;;
                2) retro_day="tuesday" ;;
                3) retro_day="wednesday" ;;
                4) retro_day="thursday" ;;
                5) retro_day="friday" ;;
                6) retro_day="saturday" ;;
                7) retro_day="sunday" ;;
                *) retro_day="friday" ;;
            esac
            echo ""
        fi

        if [ "$storage_choice" = "1" ]; then
            echo "Storage:"
            echo "  1=Local   .beacon/ をローカルのみで管理。チーム共有・Web UIは使えません。"
            echo "  2=Cloud   クラウドに同期。Web UIとチーム共有が使えます（Googleアカウント必要）。"
            read -rp "> [1]: " storage_choice
            storage_choice="${storage_choice:-1}"
        fi
    fi

    BEACON_NAME="$name" BEACON_OBJECTIVE="$objective" \
        BEACON_RETRO_DAY="${retro_day:-friday}" \
        BEACON_SENSITIVITY="$sensitivity" \
        python3 "$COMMANDS_PY" init

    # Cloud setup if selected
    if [ "${storage_choice}" = "2" ]; then
        python3 "$COMMANDS_PY" cloud_push
        # e-1861 (ms-61): cloud.json existence is sole source of truth.
        # cmd_cloud_push above already created .beacon/cloud.json — no need
        # to write the legacy `{"mode": "cloud"}` marker into config.json.
        echo "Cloud mode enabled."
    fi
}

cmd_setup() {
    echo "Beacon Setup"
    echo "============"
    echo ""

    # Step 1: Auth
    if python3 "$COMMANDS_PY" auth_check &>/dev/null; then
        echo "Step 1/5: Already signed in."
    else
        echo "Step 1/5: Sign in with Google"
        python3 "$COMMANDS_PY" auth_login
    fi
    echo ""

    # Step 2: Claude Code integration
    echo "Step 2/5: Installing Claude Code hooks and Skills..."
    python3 "$COMMANDS_PY" common_setup
    echo ""

    # Step 3: Project
    echo "Step 3/5: Project setup"
    echo "  1) Create a new local project"
    echo "  2) Join a cloud project (by project ID)"
    echo "  3) Skip (hooks only)"
    read -rp "Choose [1]: " proj_choice
    proj_choice="${proj_choice:-1}"
    echo ""

    case "$proj_choice" in
        1)
            if [ -f "$BEACON_PROJECT_FILE" ]; then
                echo "  .beacon/project.json already exists — skipping init."
            else
                echo "  Project name:"
                echo "    リポジトリ名や略称で構いません。ダッシュボードの表示名になります。"
                read -rp "  > " proj_name
                echo ""
                echo "  Project objective:"
                echo "    このプロジェクトで最終的に何を実現したいですか？"
                echo "    あなたとAIが共有するゴール宣言です。セッションをまたいで判断の基準になります。"
                echo "    「何を作るか」ではなく「誰がどんな状態になるか」で書いてください。"
                echo "    例）「AI駆動で開発するユーザーが、目的と今やっていることを常にクリアに保ちながら開発に集中できるようにする」"
                read -rp "  > " proj_objective
                echo ""
                echo "  Weekly retro day:"
                echo "    毎週この曜日にAIが振り返りを促します。週の締めに近い曜日がおすすめです。"
                echo "    1=Mon  2=Tue  3=Wed  4=Thu  5=Fri  6=Sat  7=Sun"
                read -rp "  > [5]: " retro_choice
                retro_choice="${retro_choice:-5}"
                local retro_day
                case "$retro_choice" in
                    1) retro_day="monday" ;;
                    2) retro_day="tuesday" ;;
                    3) retro_day="wednesday" ;;
                    4) retro_day="thursday" ;;
                    5) retro_day="friday" ;;
                    6) retro_day="saturday" ;;
                    7) retro_day="sunday" ;;
                    *) retro_day="friday" ;;
                esac
                # ms-63 / e-1441: setup-driven init also honours the
                # default-high sensitivity posture (no opt-in path from the
                # interactive setup yet; users get the safe default).
                BEACON_NAME="$proj_name" BEACON_OBJECTIVE="$proj_objective" \
                    BEACON_RETRO_DAY="$retro_day" \
                    BEACON_SENSITIVITY="high" python3 "$COMMANDS_PY" init
            fi
            ;;
        2)
            echo ""
            echo "  Fetching accessible projects..."
            local projects_json
            projects_json=$(BEACON_JSON=1 python3 "$COMMANDS_PY" cloud_list 2>/dev/null || echo "[]")

            # Print numbered list and capture IDs via Python
            local list_output
            list_output=$(echo "$projects_json" | python3 -c "
import sys, json
projects = json.load(sys.stdin)
if not projects:
    print('EMPTY')
else:
    for i, p in enumerate(projects, 1):
        name = p.get('name', '')
        obj = p.get('objective', '')[:50]
        suffix = ('  ' + obj) if obj else ''
        print(f'{i}) {p[\"project_id\"]}  \"{name}\"{suffix}')
    print('IDS:' + ','.join(p['project_id'] for p in projects))
" 2>/dev/null)

            if [ "$list_output" = "EMPTY" ] || [ -z "$list_output" ]; then
                echo "  No accessible projects found."
                echo "  Ask your team owner to invite you first, then re-run beacon setup."
            else
                local ids_line
                ids_line=$(echo "$list_output" | grep "^IDS:")
                local display
                display=$(echo "$list_output" | grep -v "^IDS:")
                echo "$display" | sed 's/^/  /'
                echo ""
                read -rp "  Select project [1]: " proj_num
                proj_num="${proj_num:-1}"
                local selected_id
                selected_id=$(echo "${ids_line#IDS:}" | cut -d',' -f"$proj_num")
                if [ -n "$selected_id" ]; then
                    BEACON_CLOUD_PROJECT_ID="$selected_id" python3 "$COMMANDS_PY" cloud_join
                else
                    echo "  Invalid selection — skipped."
                fi
            fi
            ;;
        3)
            echo "  Skipped."
            ;;
    esac
    echo ""

    # Step 4: DM channel auto-install (ms-54 e-1238)
    # Routes through the same opt-out gate as `beacon channel install`. If
    # any of (env BEACON_NO_BUS, project flag, global flag) is set we
    # silently skip + audit-log a single line. If install itself fails
    # (no node, no .mcp.json writable, etc.), surface the error but do
    # not block the rest of setup — the user can re-run `beacon channel
    # install` later.
    echo "Step 4/5: DM channel (multi-session messaging)"
    if [ -f "$BEACON_PROJECT_FILE" ]; then
        # Use a dry probe of the status command to decide whether to attempt.
        # The python command refuses with exit 1 if opted out, which we treat
        # as expected and silent.
        if python3 "$COMMANDS_PY" channel_install 2>&1 | sed 's/^/  /'; then
            :
        else
            # channel_install returns non-zero on opt-out or genuine failure.
            # We don't differentiate here — the python side already printed
            # the cause. Setup continues either way.
            :
        fi
    else
        echo "  (no project initialized — skipping DM channel install)"
    fi
    echo ""

    # Step 5: Launch
    echo "Step 5/5: Show status + UI pointers"
    read -rp "Show now? [Y/n]: " launch_choice
    launch_choice="${launch_choice:-Y}"
    if [[ "$launch_choice" =~ ^[Yy] ]]; then
        if [ -f "$BEACON_PROJECT_FILE" ]; then
            cmd_launch
        else
            echo "  No project initialized — skipping launch."
        fi
    fi

    echo ""
    echo "✅ Setup complete!"
    echo ""
    echo "Next step:"
    echo "  Start Claude Code in this project directory and talk to /beacon-init."
    echo "  It will guide you through naming the project and shaping milestones"
    echo "  in a conversational form."
    echo ""
    echo "  Example:"
    echo "    cd ~/projects/your-project"
    echo "    claude          # launch Claude Code"
    echo "    > /beacon-init"
    echo ""
    echo "Tip: run 'beacon' any time to open the dashboard."
}

cmd_milestone_add() {
    ensure_project
    local title=""
    local target_date=""
    local description=""
    local priority=""
    local objective=""
    local acceptance_criteria=""
    local owner=""
    local assignee=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d)                         target_date="${2:-}";          shift 2 ;;
            --description|--desc)       description="${2:-}";          shift 2 ;;
            --priority)                 priority="${2:-}";             shift 2 ;;
            --objective)                objective="${2:-}";            shift 2 ;;
            --acceptance-criteria|--ac) acceptance_criteria="${2:-}";  shift 2 ;;
            --owner)                    owner="${2:-}";                shift 2 ;;
            --assignee)                 assignee="${2:-}";             shift 2 ;;
            -?*)                        _guard_positional "$1" "Usage: beacon milestone add \"<title>\" [-d <date>] [--priority P] [--objective O] [--ac A] [--owner U] [--assignee U]" ;;
            *)                          title="$1";                    shift   ;;
        esac
    done

    if [ -z "$title" ]; then
        echo "Add Milestone"
        echo "============="
        read -rp "Title: " title
        read -rp "Target date (YYYY-MM-DD): " target_date
        read -rp "Description: " description
        read -rp "Priority (highest/high/middle/low/lowest): " priority
        read -rp "Objective (what becomes possible): " objective
        read -rp "Acceptance criteria (when is it done): " acceptance_criteria
    fi

    BEACON_TITLE="$title" BEACON_TARGET_DATE="$target_date" \
        BEACON_DESCRIPTION="$description" BEACON_PRIORITY="$priority" \
        BEACON_OBJECTIVE="$objective" BEACON_ACCEPTANCE_CRITERIA="$acceptance_criteria" \
        BEACON_OWNER="$owner" BEACON_ASSIGNEE="$assignee" \
        python3 "$COMMANDS_PY" milestone_add
}

cmd_milestone_list() {
    ensure_project
    python3 "$COMMANDS_PY" milestone_list
}

cmd_milestone_start() {
    ensure_project
    local ms_id=""
    local no_branch=""
    local no_assignee=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-branch)   no_branch="1"; shift ;;
            --no-assignee) no_assignee="1"; shift ;;
            *)             ms_id="$1"; shift ;;
        esac
    done

    if [ -z "$ms_id" ]; then
        echo "Usage: beacon milestone start <ms-id> [--no-branch] [--no-assignee]"
        exit 1
    fi
    BEACON_MS_ID="$ms_id" \
        BEACON_NO_BRANCH="$no_branch" \
        BEACON_NO_ASSIGNEE="$no_assignee" \
        python3 "$COMMANDS_PY" milestone_start
}

cmd_milestone_done() {
    ensure_project
    local ms_id=""
    local reason=""
    local reason_set=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -r|--reason) reason="${2:-}"; reason_set=1; shift 2 ;;
            *)           ms_id="$1";     shift   ;;
        esac
    done

    if [ -z "$ms_id" ]; then
        echo "Usage: beacon milestone done <ms-id> --reason <text>"
        exit 1
    fi
    # e-976: forward BEACON_REASON only when --reason was passed. The python
    # gate (_require_reason_or_skip) refuses missing env, so the dispatcher
    # must not silently set an empty default.
    if [ "$reason_set" = "1" ]; then
        BEACON_MS_ID="$ms_id" BEACON_REASON="$reason" python3 "$COMMANDS_PY" milestone_done
    else
        BEACON_MS_ID="$ms_id" python3 "$COMMANDS_PY" milestone_done
    fi
}

cmd_milestone_join() {
    ensure_project
    local ms_id=""
    local checkout=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --checkout) checkout="1"; shift ;;
            *)          ms_id="$1";   shift ;;
        esac
    done

    if [ -z "$ms_id" ]; then
        echo "Usage: beacon ms join <ms-id> [--checkout]"
        exit 1
    fi
    BEACON_MS_ID="$ms_id" BEACON_CHECKOUT="$checkout" \
        python3 "$COMMANDS_PY" milestone_join
}

cmd_milestone_observe() {
    ensure_project
    local ms_id=""
    local reason=""
    local reason_set=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -r|--reason) reason="${2:-}"; reason_set=1; shift 2 ;;
            *)           ms_id="$1";     shift   ;;
        esac
    done

    if [ -z "$ms_id" ]; then
        echo "Usage: beacon milestone observe <ms-id> --reason <text>"
        exit 1
    fi
    # e-976: route observe to the dedicated milestone_observe handler so the
    # --reason gate applies. The handler still forwards to core.milestone_update
    # internally, so behavior other than the gate is identical.
    if [ "$reason_set" = "1" ]; then
        BEACON_MS_ID="$ms_id" BEACON_REASON="$reason" \
            python3 "$COMMANDS_PY" milestone_observe
    else
        BEACON_MS_ID="$ms_id" \
            python3 "$COMMANDS_PY" milestone_observe
    fi
}

cmd_milestone_show() {
    ensure_project
    local ms_id=""
    local json_flag=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json_flag="1"; shift ;;
            *)      ms_id="$1"; shift ;;
        esac
    done

    if [ -z "$ms_id" ]; then
        echo "Usage: beacon milestone show <ms-id> [--json]"
        exit 1
    fi
    BEACON_MS_ID="$ms_id" BEACON_JSON="$json_flag" python3 "$COMMANDS_PY" milestone_show
}

cmd_milestone_update() {
    ensure_project
    local ms_id=""
    local json_flag=""
    local title=""
    local progress=""
    local target_date=""
    local status=""
    local description=""
    local priority=""
    local objective=""
    local acceptance_criteria=""
    local owner=""
    local assignee=""
    local reason=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json)         json_flag="1"; shift ;;
            --title)        title="${2:-}"; shift 2 ;;
            -p|--progress)  progress="${2:-}"; shift 2 ;;
            --target-date)  target_date="${2:-}"; shift 2 ;;
            --status)       status="${2:-}"; shift 2 ;;
            --description|--desc) description="${2:-}"; shift 2 ;;
            --priority)     priority="${2:-}"; shift 2 ;;
            --objective)    objective="${2:-}"; shift 2 ;;
            --acceptance-criteria|--ac) acceptance_criteria="${2:-}"; shift 2 ;;
            --owner)        owner="${2:-}"; shift 2 ;;
            --assignee)     assignee="${2:-}"; shift 2 ;;
            -r|--reason)    reason="${2:-}"; shift 2 ;;
            *)              ms_id="$1"; shift ;;
        esac
    done

    if [ -z "$ms_id" ]; then
        echo "Usage: beacon milestone update <ms-id> [--title T] [--progress N] [--target-date D] [--status S] [--description D] [--priority P] [--objective O] [--ac A] [--owner OWNER] [--assignee ASSIGNEE] [-r REASON] [--json]"
        echo "  Tip: pass --owner '-' or --assignee '-' to clear the field."
        exit 1
    fi
    BEACON_MS_ID="$ms_id" BEACON_JSON="$json_flag" BEACON_TITLE="$title" \
        BEACON_PROGRESS="$progress" BEACON_TARGET_DATE="$target_date" \
        BEACON_STATUS="$status" BEACON_DESCRIPTION="$description" \
        BEACON_PRIORITY="$priority" BEACON_OBJECTIVE="$objective" \
        BEACON_ACCEPTANCE_CRITERIA="$acceptance_criteria" \
        BEACON_OWNER="$owner" BEACON_ASSIGNEE="$assignee" \
        BEACON_REASON="$reason" \
        python3 "$COMMANDS_PY" milestone_update
}

