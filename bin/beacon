#!/usr/bin/env bash
# Beacon - Milestone-driven project dashboard
set -euo pipefail

BEACON_DIR="$(cd "$(dirname "$0")/.." && pwd)"
DASHBOARD_PY="$BEACON_DIR/lib/dashboard.py"
COMMANDS_PY="$BEACON_DIR/lib/commands.py"
export BEACON_PROJECT_FILE=".beacon/project.json"

usage() {
    cat <<'EOF'
Beacon - Milestone-driven project management

Usage:
  beacon                  Launch tmux dashboard + shell
  beacon init             Initialize .beacon/ in current directory
  beacon status           Show current status (no tmux)
  beacon milestone add    Add a new milestone (interactive)
  beacon milestone list   List milestones
  beacon milestone start <id>  Set milestone as active
  beacon milestone close <id>  Close milestone (keeps current progress)
  beacon milestone observe <id> Set milestone to observing (watching)
  beacon log [message]    Record current HEAD commit to active milestone
  beacon sync             Auto-sync recent git commits to active milestone
  beacon cloud             Open cloud project (interactive select)
  beacon cloud <id>        Open cloud project by ID
  beacon cloud list        List cloud projects
  beacon cloud push        Push local project to Firestore
  beacon cloud pull        Pull project from Firestore
  beacon cloud status      Show cloud config status
  beacon auth login       Sign in with Google
  beacon auth logout      Remove cached credentials
  beacon auth status      Show login status
  beacon help             Show this help
  beacon --version        Show version
EOF
}

ensure_project() {
    if [ ! -f "$BEACON_PROJECT_FILE" ]; then
        echo "Error: No .beacon/project.json found."
        echo "Run 'beacon init' first."
        exit 1
    fi
}

cmd_init() {
    if [ -f "$BEACON_PROJECT_FILE" ]; then
        echo ".beacon/project.json already exists."
        exit 1
    fi

    local name="${1:-}"
    local objective="${2:-}"

    local retro_day=""

    if [ -z "$name" ]; then
        echo "Beacon - Project Initialization"
        echo "================================"
        echo ""
        read -rp "Project name: " name
        read -rp "Project objective: " objective
        echo ""
        echo "Weekly retro day (1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat, 7=Sun)"
        read -rp "Retro day [1]: " retro_choice
        retro_choice="${retro_choice:-1}"
        case "$retro_choice" in
            1) retro_day="monday" ;;
            2) retro_day="tuesday" ;;
            3) retro_day="wednesday" ;;
            4) retro_day="thursday" ;;
            5) retro_day="friday" ;;
            6) retro_day="saturday" ;;
            7) retro_day="sunday" ;;
            *) retro_day="monday" ;;
        esac
    fi

    BEACON_NAME="$name" BEACON_OBJECTIVE="$objective" \
        BEACON_RETRO_DAY="${retro_day:-monday}" \
        python3 "$COMMANDS_PY" init
}

cmd_milestone_add() {
    ensure_project
    local title=""
    local target_date=""

    # Parse arguments: beacon milestone add "title" [-d target_date]
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d)
                target_date="${2:-}"
                shift 2
                ;;
            *)
                title="$1"
                shift
                ;;
        esac
    done

    # Fall back to interactive if no title given
    if [ -z "$title" ]; then
        echo "Add Milestone"
        echo "============="
        read -rp "Title: " title
        read -rp "Target date (YYYY-MM-DD): " target_date
    fi

    BEACON_TITLE="$title" BEACON_TARGET_DATE="$target_date" \
        python3 "$COMMANDS_PY" milestone_add
}

cmd_milestone_list() {
    ensure_project
    python3 "$COMMANDS_PY" milestone_list
}

cmd_milestone_start() {
    ensure_project
    local ms_id="${1:-}"
    if [ -z "$ms_id" ]; then
        echo "Usage: beacon milestone start <ms-id>"
        exit 1
    fi
    BEACON_MS_ID="$ms_id" python3 "$COMMANDS_PY" milestone_start
}

cmd_milestone_done() {
    ensure_project
    local ms_id="${1:-}"
    if [ -z "$ms_id" ]; then
        echo "Usage: beacon milestone close <ms-id>"
        exit 1
    fi
    BEACON_MS_ID="$ms_id" python3 "$COMMANDS_PY" milestone_done
}

cmd_milestone_observe() {
    ensure_project
    local ms_id="${1:-}"
    if [ -z "$ms_id" ]; then
        echo "Usage: beacon milestone observe <ms-id>"
        exit 1
    fi
    BEACON_MS_ID="$ms_id" BEACON_STATUS="observing" python3 "$COMMANDS_PY" milestone_update
}

cmd_milestone_show() {
    ensure_project
    local ms_id=""
    local json_flag=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json_flag="1"; shift ;;
            *)      ms_id="$1"; shift ;;
        esac
    done

    if [ -z "$ms_id" ]; then
        echo "Usage: beacon milestone show <ms-id> [--json]"
        exit 1
    fi
    BEACON_MS_ID="$ms_id" BEACON_JSON="$json_flag" python3 "$COMMANDS_PY" milestone_show
}

cmd_milestone_update() {
    ensure_project
    local ms_id=""
    local json_flag=""
    local title=""
    local progress=""
    local target_date=""
    local status=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json)         json_flag="1"; shift ;;
            --title)        title="${2:-}"; shift 2 ;;
            -p|--progress)  progress="${2:-}"; shift 2 ;;
            --target-date)  target_date="${2:-}"; shift 2 ;;
            --status)       status="${2:-}"; shift 2 ;;
            *)              ms_id="$1"; shift ;;
        esac
    done

    if [ -z "$ms_id" ]; then
        echo "Usage: beacon milestone update <ms-id> [--title T] [--progress N] [--target-date D] [--status S] [--json]"
        exit 1
    fi
    BEACON_MS_ID="$ms_id" BEACON_JSON="$json_flag" BEACON_TITLE="$title" \
        BEACON_PROGRESS="$progress" BEACON_TARGET_DATE="$target_date" \
        BEACON_STATUS="$status" \
        python3 "$COMMANDS_PY" milestone_update
}

cmd_milestone_delete() {
    ensure_project
    local ms_id=""
    local json_flag=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json_flag="1"; shift ;;
            *)      ms_id="$1"; shift ;;
        esac
    done

    if [ -z "$ms_id" ]; then
        echo "Usage: beacon milestone delete <ms-id> [--json]"
        exit 1
    fi
    BEACON_MS_ID="$ms_id" BEACON_JSON="$json_flag" python3 "$COMMANDS_PY" milestone_delete
}

cmd_log() {
    ensure_project
    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        echo "Error: Not a git repository"
        exit 1
    fi

    local ms_id=""
    local custom_summary=""
    local progress=""
    local json_flag=""
    local mode="normal"

    # Parse options
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m|--ms)
                ms_id="${2:-}"
                shift 2
                ;;
            -p|--progress)
                progress="${2:-}"
                shift 2
                ;;
            --json)
                json_flag="1"
                shift
                ;;
            --prepare)
                mode="prepare"
                shift
                ;;
            --finalize)
                mode="finalize"
                shift
                ;;
            --summary)
                custom_summary="${2:-}"
                shift 2
                ;;
            *)
                custom_summary="$1"
                shift
                ;;
        esac
    done

    # Block if there are uncommitted changes (staged or unstaged)
    # --prepare is read-only, so skip this check
    if [ "$mode" != "prepare" ] && ! git diff --quiet HEAD 2>/dev/null; then
        echo "Error: uncommitted changes detected."
        echo "Commit your changes first, then run beacon log."
        echo "  (To record a note without a commit, use: beacon task add \"description\")"
        exit 1
    fi

    local hash message date_str
    hash=$(git rev-parse --short HEAD)
    message=$(git log -1 --pretty=%s)
    date_str=$(git log -1 --pretty=%ci | cut -d' ' -f1)

    case "$mode" in
        prepare)
            BEACON_HASH="$hash" BEACON_MESSAGE="$message" BEACON_DATE="$date_str" \
                BEACON_SUMMARY="$custom_summary" BEACON_MS_ID="$ms_id" \
                python3 "$COMMANDS_PY" log_prepare
            ;;
        finalize)
            BEACON_HASH="$hash" BEACON_MESSAGE="$message" BEACON_DATE="$date_str" \
                BEACON_SUMMARY="$custom_summary" BEACON_MS_ID="$ms_id" \
                BEACON_PROGRESS="$progress" \
                BEACON_NEW_SUMMARY="${BEACON_NEW_SUMMARY:-$custom_summary}" \
                BEACON_JSON="$json_flag" \
                python3 "$COMMANDS_PY" log_finalize
            ;;
        normal)
            BEACON_HASH="$hash" BEACON_MESSAGE="$message" BEACON_DATE="$date_str" \
                BEACON_SUMMARY="$custom_summary" BEACON_MS_ID="$ms_id" \
                BEACON_PROGRESS="$progress" BEACON_JSON="$json_flag" \
                python3 "$COMMANDS_PY" log
            ;;
    esac
}

cmd_sync() {
    ensure_project
    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        echo "Error: Not a git repository"
        exit 1
    fi
    python3 "$COMMANDS_PY" sync
}

cmd_summary() {
    ensure_project
    local text=""
    local json_flag=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json)
                json_flag="1"
                shift
                ;;
            *)
                if [ -z "$text" ]; then
                    text="$1"
                else
                    text="$text $1"
                fi
                shift
                ;;
        esac
    done

    BEACON_SUMMARY_TEXT="$text" BEACON_JSON="$json_flag" python3 "$COMMANDS_PY" summary
}

cmd_task_add() {
    ensure_project
    local ms_id=""
    local entry_type="task"
    local description=""
    local detail=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m|--ms)
                ms_id="${2:-}"
                shift 2
                ;;
            -t|--type)
                entry_type="${2:-}"
                shift 2
                ;;
            -d|--detail)
                detail="${2:-}"
                shift 2
                ;;
            *)
                description="$1"
                shift
                ;;
        esac
    done

    local date_str
    date_str=$(date +%Y-%m-%d)

    BEACON_DESCRIPTION="$description" BEACON_MS_ID="$ms_id" \
        BEACON_TYPE="$entry_type" BEACON_DATE="$date_str" \
        BEACON_DETAIL="$detail" \
        python3 "$COMMANDS_PY" task_add
}

cmd_task_show() {
    ensure_project
    local entry_id=""
    local json_flag=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json_flag="1"; shift ;;
            *)      entry_id="$1"; shift ;;
        esac
    done

    if [ -z "$entry_id" ]; then
        echo "Usage: beacon task show <entry-id> [--json]"
        exit 1
    fi
    BEACON_ENTRY_ID="$entry_id" BEACON_JSON="$json_flag" python3 "$COMMANDS_PY" task_show
}

cmd_task_update() {
    ensure_project
    local entry_id=""
    local json_flag=""
    local description=""
    local status=""
    local detail=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json)         json_flag="1"; shift ;;
            --description)  description="${2:-}"; shift 2 ;;
            --status)       status="${2:-}"; shift 2 ;;
            -d|--detail)    detail="${2:-}"; shift 2 ;;
            *)              entry_id="$1"; shift ;;
        esac
    done

    if [ -z "$entry_id" ]; then
        echo "Usage: beacon task update <entry-id> [--description D] [--status S] [--detail D] [--json]"
        exit 1
    fi
    BEACON_ENTRY_ID="$entry_id" BEACON_JSON="$json_flag" \
        BEACON_DESCRIPTION="$description" BEACON_STATUS="$status" \
        BEACON_DETAIL="$detail" \
        python3 "$COMMANDS_PY" task_update
}

cmd_task_delete() {
    ensure_project
    local entry_id=""
    local json_flag=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json_flag="1"; shift ;;
            *)      entry_id="$1"; shift ;;
        esac
    done

    if [ -z "$entry_id" ]; then
        echo "Usage: beacon task delete <entry-id> [--json]"
        exit 1
    fi
    BEACON_ENTRY_ID="$entry_id" BEACON_JSON="$json_flag" python3 "$COMMANDS_PY" task_delete
}

cmd_task_detail() {
    ensure_project
    local entry_id="${1:-}"
    local detail="${2:-}"
    if [ -z "$entry_id" ]; then
        echo "Usage: beacon task detail <entry-id> [detail-text]"
        exit 1
    fi
    BEACON_ENTRY_ID="$entry_id" BEACON_DETAIL="$detail" \
        python3 "$COMMANDS_PY" task_detail
}

cmd_task_done() {
    ensure_project
    local entry_id=""
    local progress=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--progress)
                progress="${2:-}"
                shift 2
                ;;
            *)
                entry_id="$1"
                shift
                ;;
        esac
    done

    if [ -z "$entry_id" ]; then
        echo "Usage: beacon task done <entry-id> [-p <progress>]"
        exit 1
    fi
    BEACON_ENTRY_ID="$entry_id" BEACON_PROGRESS="$progress" \
        python3 "$COMMANDS_PY" task_done
}

cmd_task_list() {
    ensure_project
    local ms_id=""
    local json_flag=""
    local all_flag=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m|--ms)
                ms_id="${2:-}"
                shift 2
                ;;
            --json)
                json_flag="1"
                shift
                ;;
            --all|-a)
                all_flag="1"
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    BEACON_MS_ID="$ms_id" BEACON_JSON="$json_flag" BEACON_ALL="$all_flag" python3 "$COMMANDS_PY" task_list
}

cmd_entry_move() {
    ensure_project
    local entry_id=""
    local task_id=""
    local ms_id=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            -t|--task)
                task_id="${2:-}"
                shift 2
                ;;
            -m|--ms)
                ms_id="${2:-}"
                shift 2
                ;;
            *)
                entry_id="$1"
                shift
                ;;
        esac
    done

    BEACON_ENTRY_ID="$entry_id" BEACON_TASK_ID="$task_id" BEACON_MS_ID="$ms_id" \
        python3 "$COMMANDS_PY" entry_move
}

cmd_retro() {
    ensure_project
    local since="" until=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --since) since="${2:-}"; shift 2 ;;
            --until) until="${2:-}"; shift 2 ;;
            --prepare) shift ;;
            *) shift ;;
        esac
    done

    # Default: current week (Monday to today)
    if [ -z "$since" ]; then
        local dow
        dow=$(date +%u)  # 1=Mon, 7=Sun
        if [[ "$(uname)" == "Darwin" ]]; then
            since=$(date -v-"$((dow - 1))"d +%Y-%m-%d)
        else
            since=$(date -d "last monday" +%Y-%m-%d 2>/dev/null || date +%Y-%m-%d)
        fi
    fi
    if [ -z "$until" ]; then
        until=$(date +%Y-%m-%d)
    fi

    BEACON_SINCE="$since" BEACON_UNTIL="$until" \
        python3 "$COMMANDS_PY" retro_prepare
}

cmd_status() {
    ensure_project
    local json_flag=""
    local all_flag=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) json_flag="1"; shift ;;
            --all|-a) all_flag="1"; shift ;;
            *) shift ;;
        esac
    done
    BEACON_JSON="$json_flag" BEACON_ALL="$all_flag" python3 "$COMMANDS_PY" milestone_list
}

cmd_cloud_launch() {
    local project_id="${1:-}"

    # If no project_id, show list and let user pick
    if [ -z "$project_id" ]; then
        echo "Cloud projects:"
        echo ""
        python3 "$COMMANDS_PY" cloud_list
        echo ""
        read -rp "Project ID to open: " project_id
        if [ -z "$project_id" ]; then
            echo "Cancelled."
            return 1
        fi
    fi

    # Ensure .beacon dir and cloud.json exist
    mkdir -p .beacon
    cat > .beacon/cloud.json <<EOJSON
{
  "project_id": "$project_id"
}
EOJSON

    # Create a minimal project.json if it doesn't exist (cloud mode will override reads)
    if [ ! -f "$BEACON_PROJECT_FILE" ]; then
        echo '{"name":"cloud","milestones":[]}' > "$BEACON_PROJECT_FILE"
    fi

    # Launch with BEACON_CLOUD=1
    export BEACON_CLOUD=1
    cmd_launch
}

cmd_launch() {
    ensure_project

    local abs_project
    abs_project="$(cd "$(dirname "$BEACON_PROJECT_FILE")" && pwd)/$(basename "$BEACON_PROJECT_FILE")"
    local work_dir
    work_dir="$(pwd)"
    # Use full path hash to avoid name collisions between dirs with same basename
    local dir_hash
    dir_hash=$(echo -n "$work_dir" | md5 -q 2>/dev/null || echo -n "$work_dir" | md5sum | cut -d' ' -f1)
    local session_name="beacon-${dir_hash:0:8}"
    local dashboard_pct="${BEACON_DASHBOARD_WIDTH:-33}"

    # If already inside this beacon session, restart dashboard pane if needed
    if [ "${TMUX:-}" ]; then
        local current_session
        current_session=$(tmux display-message -p '#{session_name}' 2>/dev/null)
        if [ "$current_session" = "$session_name" ]; then
            # Already inside this session — check if dashboard pane exists
            local pane_count
            pane_count=$(tmux list-panes -t "$session_name" 2>/dev/null | wc -l | tr -d ' ')
            if [ "$pane_count" -lt 2 ]; then
                echo "Restarting dashboard pane..."
                tmux split-window -hbd -t "$session_name" -c "$work_dir" \
                    -l "${dashboard_pct}%" \
                    "python3 '$DASHBOARD_PY' '$abs_project'"
                tmux select-pane -t "$session_name:.1"
            else
                echo "Beacon is already running."
            fi
            return 0
        fi
    fi

    # If session already exists, just re-attach
    if tmux has-session -t "$session_name" 2>/dev/null; then
        echo "Re-attaching to existing beacon session."
        if [ "${TMUX:-}" ]; then
            tmux switch-client -t "$session_name"
        else
            tmux attach-session -t "$session_name"
        fi
        return 0
    fi

    # Create new session
    tmux new-session -d -s "$session_name" -c "$work_dir"

    # Session-specific settings (no -g flag to avoid polluting other sessions)
    tmux set-option -t "$session_name" history-limit 10000

    # Pass cloud mode to all panes in this session
    if [ "${BEACON_CLOUD:-}" = "1" ]; then
        tmux set-environment -t "$session_name" BEACON_CLOUD 1
    fi

    # Create dashboard pane to the LEFT of the shell pane
    # When dashboard exits (q), kill the entire session to clean up
    tmux split-window -hbd -t "$session_name" -c "$work_dir" \
        -l "${dashboard_pct}%" \
        "python3 '$DASHBOARD_PY' '$abs_project'"

    # Re-apply ratio on window resize (no quotes around % value for tmux to parse it)
    tmux set-hook -t "$session_name" after-resize-window \
        "resize-pane -t ${session_name}:.0 -x ${dashboard_pct}%"

    # When shell pane exits (exit/ctrl-d), also kill session
    tmux set-hook -t "$session_name" pane-exited \
        "kill-session"

    # Focus on the right (working) pane
    tmux select-pane -t "$session_name:.1"

    # Attach (use switch-client if already inside tmux)
    if [ "${TMUX:-}" ]; then
        tmux switch-client -t "$session_name"
    else
        tmux attach-session -t "$session_name"
    fi
}

# --- Main dispatch ---
case "${1:-}" in
    ""|start)
        cmd_launch
        ;;
    init)
        shift
        cmd_init "$@"
        ;;
    status)
        shift
        cmd_status "$@"
        ;;
    milestone|ms)
        case "${2:-}" in
            add)    shift 2; cmd_milestone_add "$@" ;;
            list|ls) cmd_milestone_list ;;
            start)  cmd_milestone_start "${3:-}" ;;
            done|close) cmd_milestone_done "${3:-}" ;;
            observe)    cmd_milestone_observe "${3:-}" ;;
            show)   shift 2; cmd_milestone_show "$@" ;;
            update) shift 2; cmd_milestone_update "$@" ;;
            delete|cancel) shift 2; cmd_milestone_delete "$@" ;;
            *)      echo "Usage: beacon milestone [add|list|start|close|observe|done|show|update|delete]" ;;
        esac
        ;;
    log)
        shift
        cmd_log "$@"
        ;;
    sync)
        cmd_sync
        ;;
    summary)
        shift
        cmd_summary "$@"
        ;;
    task)
        case "${2:-}" in
            add)
                shift 2
                cmd_task_add "$@"
                ;;
            done)
                cmd_task_done "${3:-}"
                ;;
            list|ls)
                shift 2
                cmd_task_list "$@"
                ;;
            show)
                shift 2
                cmd_task_show "$@"
                ;;
            detail)
                shift 2
                cmd_task_detail "$@"
                ;;
            update)
                shift 2
                cmd_task_update "$@"
                ;;
            delete|cancel)
                shift 2
                cmd_task_delete "$@"
                ;;
            *)
                echo "Usage: beacon task [add|done|list|show|detail|update|delete] [-m <ms-id>] [-t <type>] [-d <detail>] [description]"
                ;;
        esac
        ;;
    entry)
        case "${2:-}" in
            move)
                shift 2
                cmd_entry_move "$@"
                ;;
            *)
                echo "Usage: beacon entry move <entry-id> -t <task-id> | -m <ms-id>"
                ;;
        esac
        ;;
    retro)
        shift
        case "${1:-}" in
            done)
                python3 "$COMMANDS_PY" retro_done
                ;;
            *)
                cmd_retro "$@"
                ;;
        esac
        ;;
    trigger)
        case "${2:-}" in
            fire)
                BEACON_TRIGGER_NAME="${3:-}" BEACON_TRIGGER_MESSAGE="${4:-}" \
                    python3 "$COMMANDS_PY" trigger_fire
                ;;
            check)
                python3 "$COMMANDS_PY" trigger_check
                ;;
            clear)
                BEACON_TRIGGER_NAME="${3:-}" python3 "$COMMANDS_PY" trigger_clear
                ;;
            *)
                echo "Usage: beacon trigger [fire|check|clear] <name> [message]"
                ;;
        esac
        ;;
    cloud)
        case "${2:-}" in
            push)   ensure_project; python3 "$COMMANDS_PY" cloud_push ;;
            pull)   ensure_project; python3 "$COMMANDS_PY" cloud_pull ;;
            status) ensure_project; python3 "$COMMANDS_PY" cloud_status ;;
            list)   python3 "$COMMANDS_PY" cloud_list ;;
            "")     cmd_cloud_launch ;;
            *)      cmd_cloud_launch "$2" ;;
        esac
        ;;
    auth)
        case "${2:-}" in
            login)  python3 "$COMMANDS_PY" auth_login ;;
            logout) python3 "$COMMANDS_PY" auth_logout ;;
            status) python3 "$COMMANDS_PY" auth_status ;;
            *)      echo "Usage: beacon auth [login|logout|status]" ;;
        esac
        ;;
    help|-h|--help)
        usage
        ;;
    --version|-V)
        python3 "$COMMANDS_PY" version
        ;;
    *)
        echo "Unknown command: $1"
        usage
        exit 1
        ;;
esac
