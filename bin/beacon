            --all)  all_flag="1"; shift ;;   # e-3586: 取消済も含めて全件出す
            *)      shift ;;
        esac
    done
    BEACON_JSON="$json_flag" BEACON_ALL="$all_flag" \
        python3 "$COMMANDS_PY" opportunity_list
