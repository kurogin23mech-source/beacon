            activity) shift 2; cmd_opportunity_activity "$@" ;;
            delete)   shift 2; cmd_opportunity_delete "$@" ;;
            *)        echo "Usage: beacon opportunity [add|list|phase|assign|amount|describe|phase-prob|transition-date|judge|due|activity|delete]" ;;
        esac
        ;;
    communication|comm)
        case "${2:-}" in
            add)      shift 2; cmd_communication_add "$@" ;;
            list|ls)  shift 2; cmd_communication_list "$@" ;;
