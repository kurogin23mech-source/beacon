            -?*)    _guard_positional "$1" "Usage: beacon opportunity phase <opp-id> <phase> [--note <text>]" ;;
            *)
                if [ -z "$opp_id" ]; then opp_id="$1"; else phase="$1"; fi
                shift ;;
        esac
    done
    if [ -z "$opp_id" ] || [ -z "$phase" ]; then
        echo "Usage: beacon opportunity phase <opp-id> <phase> [--note <text>]"
