                        --email) memail="${2:-}"; shift 2 ;;
                        --role)  mrole="${2:-}"; shift 2 ;;
                        --json)  mjson="1"; shift ;;
                        *)       [[ -z "$mid" ]] && mid="$1"; shift ;;
                    esac
                done
                if [ -z "$mid" ]; then
                    echo "Usage: beacon member add <id> [--name N] [--email E] [--role owner|maintainer|contributor|viewer] [--json]"
                    exit 1
