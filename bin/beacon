#!/usr/bin/env bash
# Beacon - Milestone-driven project dashboard
set -euo pipefail

BEACON_DIR="$(cd "$(dirname "$0")/.." && pwd)"
DASHBOARD_PY="$BEACON_DIR/lib/dashboard.py"
COMMANDS_PY="$BEACON_DIR/lib/commands.py"
export BEACON_PROJECT_FILE=".beacon/project.json"

usage() {
    cat <<'EOF'
Beacon - Milestone-driven project management

Usage:
  beacon                  Launch tmux dashboard + shell
  beacon setup            First-time setup wizard (auth + hooks + project)
  beacon init             Initialize .beacon/ in current directory
  beacon status           Show current status (no tmux)
  beacon milestone add    Add a new milestone (interactive)
  beacon milestone list   List milestones
  beacon milestone start <id>  Set milestone as active
  beacon milestone close <id>  Close milestone (keeps current progress)
  beacon milestone observe <id> Set milestone to observing (watching)
  beacon log [message]    Record current HEAD commit to active milestone
  beacon sync             Auto-sync recent git commits to active milestone
  beacon doc add "title"   Add/update a document (content via --content or stdin)
  beacon doc list           List all documents
  beacon doc show <id>     Show document content
  beacon cloud             Open cloud project (interactive select)
  beacon cloud <id>        Open cloud project by ID
  beacon cloud list        List cloud projects
  beacon cloud push        Push local project to Firestore
  beacon cloud pull        Pull project from Firestore
  beacon cloud join <id>   Join an existing cloud project (first-time)
  beacon cloud status      Show cloud config status
  beacon auth login       Sign in with Google
  beacon auth logout      Remove cached credentials
  beacon auth status      Show login status
  beacon skill install    Install Claude Code Skills
  beacon help             Show this help
  beacon --version        Show version
EOF
}

ensure_project() {
    if [ ! -f "$BEACON_PROJECT_FILE" ]; then
        echo "Error: No .beacon/project.json found."
        echo "Run 'beacon init' first."
        exit 1
    fi
}

cmd_init() {
    if [ -f "$BEACON_PROJECT_FILE" ]; then
        echo ".beacon/project.json already exists."
        exit 1
    fi

    # Guard: warn if initializing in home directory
    if [ "$(pwd)" = "$HOME" ]; then
        echo "Warning: You are about to initialize beacon in your home directory."
        echo "This will create ~/.beacon/ and modify ~/CLAUDE.md."
        echo "Beacon is designed for project directories, not the home directory."
        echo ""
        read -rp "Continue anyway? [y/N] " confirm
        if [[ ! "$confirm" =~ ^[Yy] ]]; then
            echo "Aborted."
            exit 1
        fi
    fi

    local name="${1:-}"
    local objective="${2:-}"

    local retro_day=""

    if [ -z "$name" ]; then
        echo "Beacon - Project Initialization"
        echo "================================"
        echo ""
        read -rp "Project name: " name
        read -rp "Project objective: " objective
        echo ""
        echo "Weekly retro day (1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat, 7=Sun)"
        read -rp "Retro day [1]: " retro_choice
        retro_choice="${retro_choice:-1}"
        case "$retro_choice" in
            1) retro_day="monday" ;;
            2) retro_day="tuesday" ;;
            3) retro_day="wednesday" ;;
            4) retro_day="thursday" ;;
            5) retro_day="friday" ;;
            6) retro_day="saturday" ;;
            7) retro_day="sunday" ;;
            *) retro_day="monday" ;;
        esac

        echo ""
        echo "Storage: 1=Local, 2=Cloud"
        read -rp "Storage [1]: " storage_choice
        storage_choice="${storage_choice:-1}"
    fi

    BEACON_NAME="$name" BEACON_OBJECTIVE="$objective" \
        BEACON_RETRO_DAY="${retro_day:-monday}" \
        python3 "$COMMANDS_PY" init

    # Cloud setup if selected
    if [ "${storage_choice:-1}" = "2" ]; then
        python3 "$COMMANDS_PY" cloud_push
        echo '{"mode": "cloud"}' > .beacon/config.json
        echo "Cloud mode enabled."
    fi
}

cmd_setup() {
    echo "Beacon Setup"
    echo "============"
    echo ""

    # Step 1: Auth
    if python3 "$COMMANDS_PY" auth_check &>/dev/null; then
        echo "Step 1/4: Already signed in."
    else
        echo "Step 1/4: Sign in with Google"
        python3 "$COMMANDS_PY" auth_login
    fi
    echo ""

    # Step 2: Claude Code integration
    echo "Step 2/4: Installing Claude Code hooks and Skills..."
    python3 "$COMMANDS_PY" common_setup
    echo ""

    # Step 3: Project
    echo "Step 3/4: Project setup"
    echo "  1) Create a new local project"
    echo "  2) Join a cloud project (by project ID)"
    echo "  3) Skip (hooks only)"
    read -rp "Choose [1]: " proj_choice
    proj_choice="${proj_choice:-1}"
    echo ""

    case "$proj_choice" in
        1)
            if [ -f "$BEACON_PROJECT_FILE" ]; then
                echo "  .beacon/project.json already exists — skipping init."
            else
                read -rp "  Project name: " proj_name
                read -rp "  Project objective: " proj_objective
                echo ""
                echo "  Weekly retro day (1=Mon, 2=Tue, 3=Wed, 4=Thu, 5=Fri, 6=Sat, 7=Sun)"
                read -rp "  Retro day [1]: " retro_choice
                retro_choice="${retro_choice:-1}"
                local retro_day
                case "$retro_choice" in
                    1) retro_day="monday" ;;
                    2) retro_day="tuesday" ;;
                    3) retro_day="wednesday" ;;
                    4) retro_day="thursday" ;;
                    5) retro_day="friday" ;;
                    6) retro_day="saturday" ;;
                    7) retro_day="sunday" ;;
                    *) retro_day="monday" ;;
                esac
                BEACON_NAME="$proj_name" BEACON_OBJECTIVE="$proj_objective" \
                    BEACON_RETRO_DAY="$retro_day" python3 "$COMMANDS_PY" init
            fi
            ;;
        2)
            echo ""
            echo "  Fetching accessible projects..."
            local projects_json
            projects_json=$(BEACON_JSON=1 python3 "$COMMANDS_PY" cloud_list 2>/dev/null || echo "[]")

            # Print numbered list and capture IDs via Python
            local list_output
            list_output=$(echo "$projects_json" | python3 -c "
import sys, json
projects = json.load(sys.stdin)
if not projects:
    print('EMPTY')
else:
    for i, p in enumerate(projects, 1):
        name = p.get('name', '')
        obj = p.get('objective', '')[:50]
        suffix = ('  ' + obj) if obj else ''
        print(f'{i}) {p[\"project_id\"]}  \"{name}\"{suffix}')
    print('IDS:' + ','.join(p['project_id'] for p in projects))
" 2>/dev/null)

            if [ "$list_output" = "EMPTY" ] || [ -z "$list_output" ]; then
                echo "  No accessible projects found."
                echo "  Ask your team owner to invite you first, then re-run beacon setup."
            else
                local ids_line
                ids_line=$(echo "$list_output" | grep "^IDS:")
                local display
                display=$(echo "$list_output" | grep -v "^IDS:")
                echo "$display" | sed 's/^/  /'
                echo ""
                read -rp "  Select project [1]: " proj_num
                proj_num="${proj_num:-1}"
                local selected_id
                selected_id=$(echo "${ids_line#IDS:}" | cut -d',' -f"$proj_num")
                if [ -n "$selected_id" ]; then
                    BEACON_CLOUD_PROJECT_ID="$selected_id" python3 "$COMMANDS_PY" cloud_join
                else
                    echo "  Invalid selection — skipped."
                fi
            fi
            ;;
        3)
            echo "  Skipped."
            ;;
    esac
    echo ""

    # Step 4: Launch
    echo "Step 4/4: Launch dashboard"
    read -rp "Launch now? [Y/n]: " launch_choice
    launch_choice="${launch_choice:-Y}"
    if [[ "$launch_choice" =~ ^[Yy] ]]; then
        if [ -f "$BEACON_PROJECT_FILE" ]; then
            cmd_launch
        else
            echo "  No project initialized — skipping launch."
        fi
    fi

    echo ""
    echo "Done! Run 'beacon' any time to open the dashboard."
}

cmd_milestone_add() {
    ensure_project
    local title=""
    local target_date=""
    local description=""

    # Parse arguments: beacon milestone add "title" [-d target_date] [--description "desc"]
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d)
                target_date="${2:-}"
                shift 2
                ;;
            --description|--desc)
                description="${2:-}"
                shift 2
                ;;
            *)
                title="$1"
                shift
                ;;
        esac
    done

    # Fall back to interactive if no title given
    if [ -z "$title" ]; then
        echo "Add Milestone"
        echo "============="
        read -rp "Title: " title
        read -rp "Target date (YYYY-MM-DD): " target_date
        read -rp "Description: " description
    fi

    BEACON_TITLE="$title" BEACON_TARGET_DATE="$target_date" \
        BEACON_DESCRIPTION="$description" \
        python3 "$COMMANDS_PY" milestone_add
}

cmd_milestone_list() {
    ensure_project
    python3 "$COMMANDS_PY" milestone_list
}

cmd_milestone_start() {
    ensure_project
    local ms_id="${1:-}"
    if [ -z "$ms_id" ]; then
        echo "Usage: beacon milestone start <ms-id>"
        exit 1
    fi
    BEACON_MS_ID="$ms_id" python3 "$COMMANDS_PY" milestone_start
}

cmd_milestone_done() {
    ensure_project
    local ms_id="${1:-}"
    if [ -z "$ms_id" ]; then
        echo "Usage: beacon milestone close <ms-id>"
        exit 1
    fi
    BEACON_MS_ID="$ms_id" python3 "$COMMANDS_PY" milestone_done
}

