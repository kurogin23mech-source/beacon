# ms-116 — edit a running project's saved phase funnel.
# <funnel> = account | opportunity. The stage-name arg may contain spaces, so
# positionals are consumed in order after the funnel selector.
cmd_phase_add() {
    ensure_project
    local funnel="" name="" index=""
