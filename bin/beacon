                mid="${1:-}"
                mrole="${2:-}"
                if [ -z "$mid" ] || [ -z "$mrole" ]; then
                    echo "Usage: beacon member role <id> <owner|maintainer|contributor|viewer>"
                    exit 1
                fi
                BEACON_MEMBER_ID="$mid" BEACON_MEMBER_ROLE="$mrole" \
                    python3 "$COMMANDS_PY" member_role
                ;;
            invite)
                # ms-78 e-1805 — issue an invite URL for a Beacon project member.
                shift 2
                memail="" mrole="viewer" mjson=""
                while [[ $# -gt 0 ]]; do
                    case "$1" in
                        --role) mrole="${2:-}"; shift 2 ;;
                        --json) mjson="1"; shift ;;
                        *)      [[ -z "$memail" ]] && memail="$1"; shift ;;
                    esac
